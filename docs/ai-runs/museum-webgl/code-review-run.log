  291:                 {hasPlaceholderCounters ? <p className="museum-tag museum-counters-tag">{MUSEUM_COPY.join.placeholderTag}</p> : null}
  292:               </div>
  293: 
  294:               <div className="museum-message">
  295:                 {MUSEUM_COPY.join.lines.map((line, i) => (
  296:                   <p key={line} className="museum-line" style={{ opacity: join.lineOpacity[i] }}>
  297:                     {line}
  298:                   </p>
  299:                 ))}
  300:               </div>
  301: 
  302:               <div className="museum-join" style={{ opacity: join.joinOpacity }}>
  303:                 <h2 className="museum-join-heading">{MUSEUM_COPY.join.heading}</h2>
  304:                 <p className="museum-join-explanation">{MUSEUM_COPY.join.explanation}</p>
  305:               </div>
  306:             </div>
  307:           </div>
  308: 
  309:           {/* Controls layer: the only focusable elements on the stage. Inert while not visible. */}
  310:           <div className="museum-controls">
  311:             <div className="museum-enter" style={{ opacity: enter.opacity }} inert={enter.inert}>
  312:               <button type="button" className="museum-enter-button" onClick={onEnter}>
  313:                 {MUSEUM_COPY.enter.cta}
  314:               </button>
  315:             </div>
  316: 
  317:             <div className="museum-cta-slot" id="museum-join" style={{ opacity: join.ctaOpacity }} inert={!join.active}>
  318:               <a ref={ctaRef} className="museum-cta" href={INTERVIEW_HREF} onClick={onJoin}>
  319:                 {MUSEUM_COPY.join.cta}
  320:               </a>
  321:             </div>
  322:           </div>
  323:         </div>
  324:       </div>
  325: 
  326:       {/* Text version: the same content, in order, as a visible panel. Shown by "Read as text". */}
  327:       <section className="museum-text-panel" aria-label="The sequence as text">
  328:         <h2>{MUSEUM_COPY.yeriel.name}</h2>
  329:         <p>
  330:           {MUSEUM_COPY.yeriel.meta} ({MUSEUM_COPY.yeriel.metaTag})
  331:         </p>
  332:         <ul>
  333:           {MUSEUM_COPY.yeriel.fragments.map((text) => (
  334:             <li key={text}>{text}</li>
  335:           ))}
  336:         </ul>
  337: 
  338:         <h2>{MUSEUM_COPY.mofundo.name}</h2>
  339:         <p>{MUSEUM_COPY.mofundo.itemMeta}</p>
  340: 
  341:         <h2>{MUSEUM_COPY.rememberHim.question}</h2>
  342:         <ul>
  343:           {(data?.evidence ?? []).map((item) => (
  344:             <li key={item.id}>{item.label} (PLACEHOLDER)</li>
  345:           ))}
  346:         </ul>
  347:         <ul>
  348:           {(data?.fragments ?? []).map((fragment) => (
  349:             <li key={fragment.id}>
  350:               â€œ{fragment.text}â€ {fragment.attribution} (PLACEHOLDER)
  351:             </li>
  352:           ))}
  353:         </ul>
  354: 
  355:         <h2>{MUSEUM_COPY.join.heading}</h2>
  356:         <ul>
  357:           {counters.map((c) => (
  358:             <li key={c.id}>
  359:               {c.label}: {c.value ?? 'pending'}
  360:               {c.status === 'placeholder' ? ` (${MUSEUM_COPY.join.placeholderTag})` : ''}
  361:             </li>
  362:           ))}
  363:         </ul>
  364:         {MUSEUM_COPY.join.lines.map((line) => (
  365:           <p key={line}>{line}</p>
  366:         ))}
  367:         <p>{MUSEUM_COPY.join.explanation}</p>
  368:         <p>
  369:           <a className="museum-cta" href={INTERVIEW_HREF} onClick={onJoin}>
  370:             {MUSEUM_COPY.join.cta}
  371:           </a>
  372:         </p>
  373:       </section>
  374:     </div>
  375:   );
  376: }
    1: /* MOFUNDO Museum: one cinematic sequence, four scenes (docs/MOFUNDO_MUSEUM_DESIGN_BIBLE.md). */
