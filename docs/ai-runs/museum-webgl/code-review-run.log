   40: function actionFields(html) {
   41:   const fields = {};
   42:   for (const match of html.matchAll(/<input type="hidden" name="([^"]+)"(?: value="([^"]*)")?/g)) {
   43:     fields[decode(match[1])] = decode(match[2] || "");
   44:   }
   45:   return fields;
   46: }
   47: 
   48: function decode(value) {
   49:   return value
   50:     .replaceAll("&quot;", '"')
   51:     .replaceAll("&amp;", "&")
   52:     .replaceAll("&#x27;", "'")
   53:     .replaceAll("&lt;", "<")
   54:     .replaceAll("&gt;", ">");
   55: }
   56: 
   57: function form(fields) {
   58:   const body = new FormData();
   59:   for (const [key, value] of Object.entries(fields)) body.set(key, value);
   60:   return body;
   61: }
   62: 
   63: async function postForm(path, fields, cookie) {
   64:   return fetch(`${base}${path}`, {
   65:     method: "POST",
