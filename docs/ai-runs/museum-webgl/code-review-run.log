   85:   font-size: 12px;
   86:   font-weight: 600;
   87:   letter-spacing: 0.12em;
   88:   text-transform: uppercase;
   89:   color: var(--muted);
   90: }
   91: 
   92: .museum-sound {
   93:   min-height: 44px;
   94:   padding: 0 16px;
   95:   background: transparent;
   96:   border: 1px solid var(--border);
   97:   color: var(--muted);
   98:   font: inherit;
   99:   font-size: 12px;
  100:   font-weight: 600;
  101:   letter-spacing: 0.12em;
