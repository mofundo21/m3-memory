   28: 
   29: /* Persistent chrome: leave link, text mode and sound control. Minimal and quiet. */
   30: .museum-chrome {
   31:   position: fixed;
   32:   top: 0;
   33:   left: 0;
   34:   right: 0;
   35:   z-index: 50;
   36:   display: flex;
