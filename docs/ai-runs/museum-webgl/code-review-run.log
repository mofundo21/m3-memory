===== src/app/remember/actions.ts =====
    1: "use server";
    2: 
    3: import { updateSubmissionPreferences, createSubmission, insertMediaRows, validateMediaUpload } from "@/lib/db";
    4: import { uploadSupabaseMedia, getPersistenceMode } from "@/lib/supabase";
    5: import type { SubmissionInput } from "@/lib/types";
    6: import { redirect } from "next/navigation";
    7: 
    8: export async function submitMemoryAction(formData: FormData) {
    9:   const input: SubmissionInput = {
   10:     submitterName: String(formData.get("submitterName") || "").trim() || "Anonymous",
   11:     contact: String(formData.get("contact") || ""),
   12:     encounterDate: String(formData.get("encounterDate") || ""),
   13:     isApproximateDate: formData.get("isApproximateDate") === "on",
   14:     locationName: String(formData.get("locationName") || ""),
   15:     city: String(formData.get("city") || ""),
   16:     region: String(formData.get("region") || ""),
   17:     country: String(formData.get("country") || ""),
   18:     eventName: String(formData.get("eventName") || ""),
   19:     howMet: String(formData.get("howMet") || ""),
   20:     memoryText: String(formData.get("memoryText") || ""),
   21:     beforeText: String(formData.get("beforeText") || ""),
   22:     afterText: String(formData.get("afterText") || ""),
   23:     metAgain: String(formData.get("metAgain") || ""),
   24:     peoplePresent: String(formData.get("peoplePresent") || ""),
   25:     yerielWearing: String(formData.get("yerielWearing") || ""),
   26:     submitterWearing: String(formData.get("submitterWearing") || ""),
   27:     talkedAbout: String(formData.get("talkedAbout") || ""),
   28:     exchanged: String(formData.get("exchanged") || ""),
   29:     artifactInfo: String(formData.get("artifactInfo") || ""),
   30:     forgottenPrompt: String(formData.get("forgottenPrompt") || ""),
   31:     bookPagePrompt: String(formData.get("bookPagePrompt") || ""),
   32:     additionalComments: String(formData.get("additionalComments") || ""),
   33:     mediaLink: String(formData.get("mediaLink") || ""),
   34:     mediaConsent: formData.get("mediaConsent") === "on"
   35:   };
   36: 
   37:   if (!input.memoryText.trim()) {
   38:     redirect("/remember/write?error=missing");
   39:   }
   40: 
   41:   const submissionId = await createSubmission(input);
   42: 
   43:   const mediaFiles = formData.getAll("media") as File[];
   44:   if (mediaFiles.length > 0 && getPersistenceMode() === "supabase") {
   45:     try {
   46:       const validationInputs = await Promise.all(
   47:         mediaFiles.map(async (file) => ({
   48:           fileName: file.name,
   49:           mimeType: file.type,
   50:           sizeBytes: file.size
   51:         }))
   52:       );
   53: 
   54:       validateMediaUpload(validationInputs);
   55: 
   56:       const uploadedMedia = await Promise.all(
   57:         mediaFiles.map(async (file) => {
   58:           const buffer = await file.arrayBuffer();
   59:           const storagePath = await uploadSupabaseMedia(
   60:             submissionId,
   61:             file.name,
   62:             new Uint8Array(buffer),
   63:             file.type
   64:           );
   65: 
   66:           return {
   67:             fileName: file.name,
   68:             mimeType: file.type,
   69:             sizeBytes: file.size,
   70:             storagePath
   71:           };
   72:         })
   73:       );
   74: 
   75:       await insertMediaRows(submissionId, uploadedMedia);
   76:     } catch (error: any) {
   77:       console.error("Media upload error:", error);
   78:       redirect(`/remember/details?error=media`);
   79:     }
   80:   }
   81: 
   82:   redirect(`/remember/final?submissionId=${submissionId}`);
   83: }
   84: 
   85: export async function updatePreferencesAction(submissionId: string, formData: any) {
   86:   try {
   87:     await updateSubmissionPreferences(submissionId, {
   88:       attributionPreference: formData.attributionPreference,
   89:       preferredAttribution: formData.preferredAttribution,
   90:       bookNote: formData.bookNote,
   91:       finalNotes: formData.finalNotes
   92:     });
   93:   } catch (error: any) {
   94:     throw new Error(`Failed to save preferences: ${error.message}`);
   95:   }
   96: 
   97:   // redirect() throws; it must sit outside the try block or the catch turns it into an error.
   98:   redirect("/thanks");
   99: }

===== scripts/museum-timeline-tests.mjs =====
    1: import assert from "node:assert/strict";
    2: import { registerHooks } from "node:module";
    3: import { fileURLToPath, pathToFileURL } from "node:url";
    4: import { join, dirname } from "node:path";
    5: 
    6: // Unit tests for the museum timeline evaluator. Pure logic only: no DOM, no browser.
    7: const srcRoot = join(dirname(fileURLToPath(import.meta.url)), "..", "src");
    8: 
    9: registerHooks({
   10:   resolve(specifier, context, nextResolve) {
   11:     if (specifier.startsWith("@/")) {
   12:       const target = join(srcRoot, specifier.slice(2));
   13:       const withExt = target.endsWith(".ts") ? target : `${target}.ts`;
   14:       return { url: pathToFileURL(withExt).href, shortCircuit: true };
   15:     }
   16:     return nextResolve(specifier, context);
   17:   },
   18: });
   19: 
   20: const { evaluateMuseumFrame, JOIN_ACTIVE_AT } = await import("../src/lib/museumTimeline.ts");
   21: const { cameraAt, sceneOpacity, within } = await import("../src/lib/museumCamera.ts");
   22: const { MUSEUM_BEATS, MUSEUM_COPY, MUSEUM_SCENES, SCENE_FADE, ENTER_PROGRESS, SCENE_THREE_PLATES, SCENE_TWO_PLATES } =
   23:   await import("../src/lib/museumConfig.ts");
   24: 
   25: const samples = Array.from({ length: 401 }, (_, i) => i / 400);
   26: const frame = (progress, reducedMotion = false, counterCount = 4) =>
   27:   evaluateMuseumFrame({ progress, reducedMotion, counterCount });
   28: 
   29: // 1. Parity: the evaluator must produce the same numbers the previous component computed inline.
   30: for (const p of samples) {
   31:   const f = frame(p);
   32:   const cam = cameraAt(p);
   33:   assert.equal(f.camera.zoom, cam.zoom, `camera zoom at ${p}`);
   34:   assert.equal(f.camera.x, cam.x, `camera x at ${p}`);
   35:   for (const scene of MUSEUM_SCENES) {
   36:     assert.equal(f.scenes.opacity[scene.id], sceneOpacity(scene.id, p), `${scene.id} opacity at ${p}`);
   37:   }
   38:   assert.equal(f.yeriel.nameOpacity, within(p, ...MUSEUM_BEATS.yeriel.nameIn), `name in at ${p}`);
   39:   assert.equal(f.yeriel.nameY, within(p, ...MUSEUM_BEATS.yeriel.nameShrink) * -28, `name y at ${p}`);
   40:   assert.equal(f.yeriel.nameScale, 1 - within(p, ...MUSEUM_BEATS.yeriel.nameShrink) * 0.5, `name scale at ${p}`);
   41:   assert.equal(f.enter.opacity, Math.max(0, Math.min(1, 1 - p / ENTER_PROGRESS)), `enter at ${p}`);
   42:   assert.equal(f.join.active, p >= JOIN_ACTIVE_AT, `join active at ${p}`);
   43: }
   44: 
   45: // 2. Reduced motion: no camera travel, no crossfade, no overlapping scenes.
   46: for (const p of samples) {
   47:   const f = frame(p, true);
   48:   assert.deepEqual(f.camera, { zoom: 1, x: 0 }, `rm camera at ${p}`);
   49:   assert.equal(f.scenes.transition, null, `rm transition at ${p}`);
