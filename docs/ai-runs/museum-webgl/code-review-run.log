    8: export async function submitMemoryAction(formData: FormData) {
    9:   const input: SubmissionInput = {
   10:     submitterName: String(formData.get("submitterName") || "").trim() || "Anonymous",
   11:     contact: String(formData.get("contact") || ""),
   12:     encounterDate: String(formData.get("encounterDate") || ""),
