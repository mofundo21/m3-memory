  146:     await page.emulateMediaFeatures([{ name: "prefers-reduced-motion", value: "reduce" }]);
  147:     await page.goto(`${base}/museum?cinematic=1`, { waitUntil: "networkidle0" });
  148:     await delay(500);
  149:     assert.equal(await page.$(".museum-root.is-cinematic"), null, "reduced motion is never cinematic");
  150:     assert.equal(await page.$(".museum-webgl canvas"), null, "reduced motion renders no canvas");
  151:     assert.ok(await page.$(".museum-name"), "DOM sequence still present");
  152:     assert.deepEqual(errors, [], "no page errors under reduced motion");
  153:     await page.close();
  154:   } finally {
  155:     await reducedBrowser.close();
  156:   }
  157: 
  158:   // ---- C. WebGL disabled: DOM tier with the full content ----
  159:   const noGl = await puppeteer.launch({ headless: true, args: ["--disable-webgl", "--disable-webgl2", "--disable-3d-apis"] });
  160:   try {
