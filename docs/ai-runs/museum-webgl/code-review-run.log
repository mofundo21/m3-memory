   22: async function waitForServer() {
   23:   for (let i = 0; i < 60; i++) {
   24:     try {
   25:       if ((await fetch(`${base}/api/health`)).ok) return;
   26:     } catch {}
   27:     await delay(500);
   28:   }
   29:   throw new Error("museum webgl test server did not start");
   30: }
   31: 
   32: /** Scroll so the sequence sits at normalized progress p (0..1). */
   33: async function scrollToProgress(page, p) {
   34:   await page.evaluate((target) => {
   35:     const track = document.querySelector(".museum-track");
   36:     const top = track.getBoundingClientRect().top + window.scrollY;
   37:     const scrollable = track.offsetHeight - window.innerHeight;
   38:     window.scrollTo({ top: top + target * scrollable, behavior: "instant" });
   39:   }, p);
   40:   await delay(300);
   41: }
   42: 
   43: /** Collect uncaught page errors and console errors for the whole page visit. */
   44: function watchErrors(page) {
   45:   const errors = [];
   46:   page.on("pageerror", (e) => errors.push(`pageerror: ${e.message}`));
   47:   page.on("response", (r) => {
   48:     // The favicon is a known, documented 404 (no project favicon exists). Any other 404 is a real failure.
   49:     if (r.status() >= 400 && !r.url().endsWith("/favicon.ico")) errors.push(`http ${r.status()}: ${r.url()}`);
   50:   });
   51:   page.on("console", (m) => {
   52:     if (m.type() === "error" && !/Failed to load resource: the server responded with a status of 404/.test(m.text())) {
   53:       errors.push(`console: ${m.text()}`);
   54:     }
   55:   });
   56:   return errors;
   57: }
   58: 
   59: const shotDir = process.env.MUSEUM_WEBGL_SHOTS || null;
   60: 
   61: try {
   62:   await waitForServer();
   63: 
   64:   // ---- A. Cinematic tier in a WebGL-capable browser ----
   65:   const browser = await puppeteer.launch({ headless: true, args: ["--use-gl=angle", "--use-angle=swiftshader", "--enable-unsafe-swiftshader"] });
   66:   try {
   67:     const page = await browser.newPage();
   68:     await page.setViewport({ width: 1440, height: 900 });
   69:     const errors = watchErrors(page);
   70:     // Default visit: the DOM tier, and no renderer requested.
   71:     const defaultPage = await browser.newPage();
   72:     await defaultPage.setViewport({ width: 1440, height: 900 });
   73:     await defaultPage.goto(`${base}/museum`, { waitUntil: "networkidle0" });
   74:     await delay(500);
   75:     assert.equal(await defaultPage.$(".museum-root.is-cinematic"), null, "default visit is the DOM tier");
   76:     assert.equal(await defaultPage.$(".museum-webgl canvas"), null, "default visit renders no canvas");
   77:     await defaultPage.close();
   78: 
   79:     // Opt-in visit: the cinematic experiment.
   80:     await page.goto(`${base}/museum?cinematic=1`, { waitUntil: "networkidle0" });
   81: 
   82:     await page.waitForSelector(".museum-root.is-cinematic", { timeout: 20000 });
   83:     await page.waitForSelector(".museum-webgl canvas", { timeout: 20000 });
   84:     const canvas = await page.$eval(".museum-webgl canvas", (c) => ({ w: c.width, h: c.height }));
   85:     assert.ok(canvas.w > 0 && canvas.h > 0, "canvas has a drawing surface");
   86:     assert.equal(await page.$eval(".museum-webgl", (el) => el.getAttribute("aria-hidden")), "true", "canvas layer is decorative");
   87: 
   88:     // The DOM copies that the canvas replaces are hidden, so nothing is drawn twice.
   89:     assert.equal(await page.$eval(".museum-scene-01 .museum-portrait", (el) => getComputedStyle(el).display), "none", "DOM portrait is replaced by the canvas");
   90: 
   91:     // The text layer and the accessibility layer are still there.
   92:     assert.ok(await page.$eval(".museum-name", (el) => el.textContent.includes("YERIEL")), "DOM name is still present");
   93:     assert.equal(await page.$eval(".museum-cta-slot", (el) => el.inert), true, "CTA inert before its beat, as before");
   94: 
   95:     if (shotDir) {
   96:       await scrollToProgress(page, 0.12);
   97:       await page.screenshot({ path: `${shotDir}/webgl-yeriel-0.12.png` });
   98:       await scrollToProgress(page, 0.19);
   99:       await page.screenshot({ path: `${shotDir}/webgl-travel-0.19.png` });
  100:       await scrollToProgress(page, 0.27);
  101:       await page.screenshot({ path: `${shotDir}/webgl-transition-0.27.png` });
  102:       await scrollToProgress(page, 0.4);
  103:       await page.screenshot({ path: `${shotDir}/webgl-mofundo-0.40.png` });
  104:     }
  105: 
  106:     // ---- E. Phone viewport: cinematic layer mounts, no horizontal overflow ----
  107:     const mobile = await browser.newPage();
  108:     await mobile.setViewport({ width: 390, height: 844, isMobile: true, hasTouch: true });
  109:     const mobileErrors = watchErrors(mobile);
  110:     await mobile.goto(`${base}/museum?cinematic=1`, { waitUntil: "networkidle0" });
  111:     await mobile.waitForSelector(".museum-webgl canvas", { timeout: 20000 });
  112:     const overflow = await mobile.evaluate(() => document.documentElement.scrollWidth - window.innerWidth);
  113:     assert.ok(overflow <= 0, `no horizontal overflow on a phone (overflow ${overflow}px)`);
  114:     if (shotDir) {
  115:       await scrollToProgress(mobile, 0.3);
  116:       await mobile.screenshot({ path: `${shotDir}/webgl-mobile-0.30.png` });
  117:     }
  118:     assert.deepEqual(mobileErrors.filter((e) => !/WebGL|GL_|context|GPU/i.test(e)), [], "no unexpected errors on a phone");
  119:     await mobile.close();
  120: 
  121:     // ---- D. Context loss drops to the DOM tier cleanly ----
  122:     await page.evaluate(() => {
  123:       const gl = document.querySelector(".museum-webgl canvas").getContext("webgl2");
  124:       gl.getExtension("WEBGL_lose_context").loseContext();
  125:     });
  126:     await page.waitForFunction(() => !document.querySelector(".museum-webgl canvas") && !document.querySelector(".museum-root.is-cinematic"), { timeout: 10000 });
  127:     assert.ok(await page.$eval(".museum-name", (el) => el.textContent.includes("YERIEL")), "DOM text survives context loss");
  128:     await scrollToProgress(page, 0.4);
  129:     assert.ok(await page.$(".museum-scene-02 .museum-plate"), "DOM Scene 02 plates return after context loss");
  130:     assert.deepEqual(errors.filter((e) => !/WebGL|GL_|context/i.test(e)), [], "no unexpected page errors in the cinematic visit");
  131:     await page.close();
  132:   } finally {
  133:     await browser.close();
  134:   }
  135: 
  136:   // ---- B. Reduced motion: DOM tier, no canvas, no renderer loaded ----
  137:   const reducedBrowser = await puppeteer.launch({ headless: true, args: ["--use-gl=angle", "--use-angle=swiftshader", "--enable-unsafe-swiftshader"] });
  138:   try {
  139:     const page = await reducedBrowser.newPage();
  140:     await page.setViewport({ width: 1440, height: 900 });
  141:     const errors = watchErrors(page);
  142:     const rendererRequests = [];
