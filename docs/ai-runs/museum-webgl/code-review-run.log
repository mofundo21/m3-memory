   20: const { evaluateMuseumFrame, JOIN_ACTIVE_AT } = await import("../src/lib/museumTimeline.ts");
   21: const { cameraAt, sceneOpacity, within } = await import("../src/lib/museumCamera.ts");
   22: const { MUSEUM_BEATS, MUSEUM_COPY, MUSEUM_SCENES, SCENE_FADE, ENTER_PROGRESS, SCENE_THREE_PLATES, SCENE_TWO_PLATES } =
   23:   await import("../src/lib/museumConfig.ts");
   24: 
   25: const samples = Array.from({ length: 401 }, (_, i) => i / 400);
   26: const frame = (progress, reducedMotion = false, counterCount = 4) =>
   27:   evaluateMuseumFrame({ progress, reducedMotion, counterCount });
   28: 
   29: // 1. Parity: the evaluator must produce the same numbers the previous component computed inline.
   30: for (const p of samples) {
   31:   const f = frame(p);
   32:   const cam = cameraAt(p);
   33:   assert.equal(f.camera.zoom, cam.zoom, `camera zoom at ${p}`);
   34:   assert.equal(f.camera.x, cam.x, `camera x at ${p}`);
   35:   for (const scene of MUSEUM_SCENES) {
   36:     assert.equal(f.scenes.opacity[scene.id], sceneOpacity(scene.id, p), `${scene.id} opacity at ${p}`);
   37:   }
   38:   assert.equal(f.yeriel.nameOpacity, within(p, ...MUSEUM_BEATS.yeriel.nameIn), `name in at ${p}`);
   39:   assert.equal(f.yeriel.nameY, within(p, ...MUSEUM_BEATS.yeriel.nameShrink) * -28, `name y at ${p}`);
   40:   assert.equal(f.yeriel.nameScale, 1 - within(p, ...MUSEUM_BEATS.yeriel.nameShrink) * 0.5, `name scale at ${p}`);
   41:   assert.equal(f.enter.opacity, Math.max(0, Math.min(1, 1 - p / ENTER_PROGRESS)), `enter at ${p}`);
   42:   assert.equal(f.join.active, p >= JOIN_ACTIVE_AT, `join active at ${p}`);
   43: }
   44: 
   45: // 2. Reduced motion: no camera travel, no crossfade, no overlapping scenes.
   46: for (const p of samples) {
   47:   const f = frame(p, true);
   48:   assert.deepEqual(f.camera, { zoom: 1, x: 0 }, `rm camera at ${p}`);
   49:   assert.equal(f.scenes.transition, null, `rm transition at ${p}`);
   50:   const visible = MUSEUM_SCENES.filter((s) => f.scenes.opacity[s.id] > 0).length;
   51:   assert.ok(visible <= 1, `rm shows ${visible} scenes at ${p}`);
   52:   for (const scene of MUSEUM_SCENES) {
   53:     const o = f.scenes.opacity[scene.id];
   54:     assert.ok(o === 0 || o === 1, `rm scene opacity must be a hard 0 or 1 at ${p}`);
   55:   }
   56:   assert.equal(f.yeriel.nameY, 0, `rm name must not travel at ${p}`);
   57:   assert.equal(f.yeriel.nameScale, 1, `rm name must not scale at ${p}`);
   58:   for (const plate of f.mofundo.plates) assert.equal(plate.dx, 0, `rm plate drift at ${p}`);
   59:   for (const plate of f.rememberHim.plates) assert.equal(plate.scale, 1, `rm plate depth at ${p}`);
   60: }
   61: 
   62: // 3. Reduced motion shows the final scene at progress 1 (the last scene holds to the end).
   63: assert.equal(frame(1, true).scenes.opacity.join, 1, "rm join visible at end of track");
   64: 
   65: // 4. Every opacity stays inside 0..1 across the whole track, in both modes.
   66: for (const rm of [false, true]) {
   67:   for (const p of samples) {
   68:     const f = frame(p, rm);
   69:     const all = [
   70:       ...Object.values(f.scenes.opacity),
   71:       f.enter.opacity,
   72:       f.yeriel.nameOpacity,
   73:       f.yeriel.metaOpacity,
   74:       ...f.yeriel.fragmentOpacity,
   75:       f.mofundo.nameOpacity,
   76:       f.mofundo.waveformOpacity,
   77:       ...f.mofundo.plates.map((x) => x.opacity),
   78:       f.rememberHim.questionOpacity,
   79:       ...f.rememberHim.plates.map((x) => x.opacity),
   80:       ...f.rememberHim.evidenceOpacity,
   81:       ...f.rememberHim.fragmentOpacity,
   82:       f.join.countersOpacity,
   83:       ...f.join.counterOpacity,
   84:       ...f.join.lineOpacity,
   85:       f.join.joinOpacity,
   86:       f.join.ctaOpacity,
   87:     ];
   88:     for (const v of all) assert.ok(v >= 0 && v <= 1, `opacity ${v} out of range at ${p} rm=${rm}`);
   89:   }
   90: }
   91: 
   92: // 5. Transitions: present only inside a scene boundary window, with a valid from/to pair.
   93: const boundaries = MUSEUM_SCENES.slice(1).map((s) => s.start);
   94: for (const b of boundaries) {
   95:   const mid = frame(b).scenes.transition;
   96:   assert.ok(mid, `transition expected at boundary ${b}`);
   97:   assert.ok(mid.amount >= 0 && mid.amount <= 1);
   98: }
   99: assert.equal(frame(0.12).scenes.transition, null, "no transition mid-scene");
  100: assert.equal(frame(0.38).scenes.transition, null, "no transition mid-scene");
  101: const t = frame(boundaries[0]).scenes.transition;
  102: assert.equal(t.from, "yeriel");
  103: assert.equal(t.to, "mofundo");
  104: assert.ok(Math.abs(t.amount - 0.5) < 1e-9, "amount is 0.5 exactly at the boundary");
  105: assert.equal(frame(boundaries[0] + SCENE_FADE + 0.001).scenes.transition, null, "transition ends after the fade window");
  106: 
  107: // 6. Join threshold: the CTA becomes active only once the join beat is reached.
  108: assert.equal(frame(MUSEUM_BEATS.join.joinIn[0] - 0.01).join.active, false);
  109: assert.equal(frame(JOIN_ACTIVE_AT).join.active, true);
  110: assert.equal(frame(1).join.active, true);
  111: 
  112: // 7. ENTER: visible at the start, inert once it is mostly faded out.
  113: assert.equal(frame(0).enter.opacity, 1);
  114: assert.equal(frame(0).enter.inert, false);
  115: assert.equal(frame(ENTER_PROGRESS).enter.opacity, 0);
  116: assert.equal(frame(ENTER_PROGRESS).enter.inert, true);
  117: 
  118: // 8. Scene 03 plates carry the 0.85 cap; Scene 02 plates do not.
  119: // Sample after the last plate has fully arrived (its plateIn window ends at 0.60 and 0.38).
  120: const late = frame(0.61);
  121: for (const plate of late.rememberHim.plates) assert.ok(Math.abs(plate.opacity - 0.85) < 1e-9, "scene 03 cap is 0.85");
  122: const twoLate = frame(0.39);
  123: for (const plate of twoLate.mofundo.plates) assert.ok(Math.abs(plate.opacity - 1) < 1e-9, "scene 02 is full opacity");
  124: 
  125: // 9. Plate depth scale and drift follow the config.
  126: const depthFrame = frame(0.55);
  127: SCENE_THREE_PLATES.forEach((plate, i) => {
  128:   assert.equal(depthFrame.rememberHim.plates[i].scale, plate.depth ?? 1, `depth scale ${plate.id}`);
  129: });
  130: const driftFrame = frame(MUSEUM_BEATS.mofundo.drift[1]);
  131: SCENE_TWO_PLATES.forEach((plate, i) => {
  132:   assert.equal(driftFrame.mofundo.plates[i].dx, plate.drift ?? 0, `drift ${plate.id}`);
  133: });
  134: 
  135: // 10. Lists follow their inputs: counters, and the fragment count from the copy.
  136: assert.equal(frame(0.8, false, 0).join.counterOpacity.length, 0, "no counters, no entries");
  137: assert.equal(frame(0.8, false, 6).join.counterOpacity.length, 6, "counter entries follow the count");
  138: assert.equal(frame(0.2).yeriel.fragmentOpacity.length, MUSEUM_COPY.yeriel.fragments.length);
  139: assert.equal(frame(0.2).join.lineOpacity.length, MUSEUM_COPY.join.lines.length);
  140: 
  141: // 11. Message lines hand off in order: the current line is visible on its beat, and lines two or more
  142: // ahead are hidden. Adjacent lines may overlap briefly, because they crossfade by design.
  143: const lineFrames = MUSEUM_BEATS.join.lineStarts.map((s) => frame(s + 0.01).join.lineOpacity);
  144: lineFrames.forEach((lines, i) => {
  145:   assert.ok(lines[i] > 0, `line ${i} visible on its beat`);
  146:   lines.forEach((v, j) => {
  147:     if (j >= i + 2) assert.equal(v, 0, `line ${j} hidden on line ${i}'s beat`);
  148:   });
  149: });
  150: 
  151: // 12. Purity: the same input always gives the same output.
  152: assert.deepEqual(frame(0.37), frame(0.37));
  153: 
  154: console.log("museum timeline tests ok");

