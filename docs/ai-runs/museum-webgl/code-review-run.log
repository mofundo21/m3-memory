   55: 
   56: export interface MuseumFrame {
   57:   progress: number;
   58:   reducedMotion: boolean;
   59: 
   60:   /** One camera for the whole sequence. Neutral when reduced motion is on. */
   61:   camera: CameraState;
   62: 
   63:   scenes: {
   64:     opacity: Record<MuseumSceneId, number>;
   65:     /** Whether a scene's assets may be mounted (current or adjacent). */
   66:     near: Record<MuseumSceneId, boolean>;
   67:     /** The crossfade in progress, or null. Always null with reduced motion (no overlap). */
   68:     transition: SceneTransition | null;
   69:   };
   70: 
   71:   enter: {
   72:     opacity: number;
   73:     /** The ENTER control is inert once it is mostly faded out. */
   74:     inert: boolean;
   75:   };
   76: 
   77:   yeriel: {
   78:     nameOpacity: number;
   79:     /** Vertical offset in vh while the name shrinks away. */
