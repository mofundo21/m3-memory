  168:     assert.ok(await page.$eval(".museum-name", (el) => el.textContent.includes("YERIEL")), "DOM content intact without WebGL");
  169:     assert.deepEqual(errors.filter((e) => !/WebGL|GL_|context|GPU/i.test(e)), [], "no unexpected errors without WebGL");
  170:     await page.close();
