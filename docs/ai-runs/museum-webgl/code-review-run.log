  124:       ...prev,
  125:       mediaFiles: prev.mediaFiles.filter((_, i) => i !== index)
  126:     }));
  127:   }, []);
  128: 
  129:   const clearMediaFiles = useCallback(() => {
  130:     setState(prev => ({
  131:       ...prev,
  132:       mediaFiles: []
  133:     }));
  134:   }, []);
  135: 
  136:   const reset = useCallback(() => {
  137:     setState(defaultState);
  138:     try {
  139:       sessionStorage.removeItem(STORAGE_KEY);
  140:     } catch (e) {
  141:       console.warn('Failed to clear wizard draft:', e);
  142:     }
  143:   }, []);
  144: 
  145:   return {
