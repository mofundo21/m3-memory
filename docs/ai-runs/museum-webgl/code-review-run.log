   53: 
   54: export function useMemoryWizard() {
   55:   const [state, setState] = useState<MemoryWizardState>(defaultState);
   56:   const [isLoaded, setIsLoaded] = useState(false);
   57: 
   58:   // Load from sessionStorage on mount
   59:   useEffect(() => {
   60:     try {
   61:       const stored = sessionStorage.getItem(STORAGE_KEY);
   62:       if (stored) {
   63:         const parsed = JSON.parse(stored);
   64:         setState(prev => ({ ...prev, ...parsed, mediaFiles: [] }));
   65:       }
   66:     } catch (e) {
   67:       console.warn('Failed to load wizard draft:', e);
   68:     }
   69:     setIsLoaded(true);
   70:   }, []);
   71: 
   72:   // Persist to sessionStorage whenever state changes
   73:   useEffect(() => {
   74:     if (!isLoaded) return;
   75:     try {
   76:       const toStore = {
   77:         memoryText: state.memoryText,
   78:         whereWe: state.whereWe,
   79:         aroundWhen: state.aroundWhen,
   80:         whoElse: state.whoElse,
   81:         whatMadeStick: state.whatMadeStick,
   82:         dontRemember: state.dontRemember,
   83:         encounterDate: state.encounterDate,
   84:         isApproximateDate: state.isApproximateDate,
   85:         locationName: state.locationName,
   86:         eventName: state.eventName,
   87:         mediaLink: state.mediaLink,
   88:         mediaConsent: state.mediaConsent,
   89:         submitterName: state.submitterName,
   90:         contact: state.contact,
   91:         bookNote: state.bookNote,
   92:         attributionPreference: state.attributionPreference,
   93:         finalNotes: state.finalNotes,
   94:       };
   95:       sessionStorage.setItem(STORAGE_KEY, JSON.stringify(toStore));
   96:     } catch (e) {
   97:       console.warn('Failed to save wizard draft:', e);
   98:     }
   99:   }, [state, isLoaded]);
  100: 
  101:   const updateField = useCallback((field: keyof MemoryWizardState, value: any) => {
  102:     setState(prev => ({
  103:       ...prev,
  104:       [field]: value
  105:     }));
  106:   }, []);
  107: 
  108:   const updateMultiple = useCallback((updates: Partial<MemoryWizardState>) => {
  109:     setState(prev => ({
  110:       ...prev,
  111:       ...updates
  112:     }));
  113:   }, []);
  114: 
  115:   const addMediaFile = useCallback((file: File) => {
  116:     setState(prev => ({
  117:       ...prev,
  118:       mediaFiles: [...prev.mediaFiles, file]
  119:     }));
  120:   }, []);
  121: 
  122:   const removeMediaFile = useCallback((index: number) => {
