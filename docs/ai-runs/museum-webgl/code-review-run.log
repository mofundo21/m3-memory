    1: 'use client';
    2: 
    3: /**
    4:  * Cinematic layer for the museum, Scenes 01 and 02 only: YERIEL â†’ MOFUNDO.
    5:  *
    6:  * One persistent canvas. Every value comes from the shared MuseumFrame (src/lib/museumTimeline.ts);
    7:  * this file does not derive any timing. The canvas is decorative: it is aria-hidden, holds no
    8:  * controls, and carries no information the DOM text does not also carry.
    9:  *
   10:  * Rendering is on demand: the scene redraws only when the frame changes, so an idle page costs nothing.
   11:  * Context loss, texture failure, or a thrown error calls onFail, and the page drops to the DOM tier.
   12:  */
   13: 
   14: import { Component, useEffect, useMemo, useRef, useState, type ReactNode } from 'react';
   15: import * as THREE from 'three';
   16: import { Canvas, useThree } from '@react-three/fiber';
   17: import { getMuseumAsset } from '@/lib/museumAssets';
   18: import { MUSEUM_SCENES, SCENE_TWO_PLATES } from '@/lib/museumConfig';
   19: import type { MuseumFrame } from '@/lib/museumTimeline';
   20: 
   21: /** Dust budget for the desktop tier (design: â‰¤ 300). */
   22: export const DUST_COUNT = 300;
   23: 
   24: const FOV = 35;
   25: /** Layout is authored at this distance, so the camera can travel toward and past the plates. */
   26: const REF_DIST = 6;
   27: /** Plate height over width, used until a real photograph reports its own ratio. */
   28: const PLATE_ASPECT = 1.25;
   29: 
   30: const TEXTURE_IDS = ['portrait', 'photo-01', 'photo-02', 'photo-03'] as const;
   31: 
   32: const DISSOLVE_VERT = /* glsl */ `
   33:   varying vec2 vUv;
   34:   void main() {
   35:     vUv = uv;
   36:     gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
   37:   }
   38: `;
   39: 
   40: const DISSOLVE_FRAG = /* glsl */ `
   41:   uniform sampler2D uA;
   42:   uniform sampler2D uB;
   43:   uniform float uMix;
   44:   uniform float uOpacity;
   45:   varying vec2 vUv;
   46: 
   47:   float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
   48:   float noise(vec2 p) {
   49:     vec2 i = floor(p);
   50:     vec2 f = fract(p);
   51:     f = f * f * (3.0 - 2.0 * f);
   52:     float a = hash(i);
   53:     float b = hash(i + vec2(1.0, 0.0));
   54:     float c = hash(i + vec2(0.0, 1.0));
   55:     float d = hash(i + vec2(1.0, 1.0));
   56:     return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
   57:   }
   58: 
   59:   void main() {
   60:     vec4 a = texture2D(uA, vUv);
   61:     vec4 b = texture2D(uB, vUv);
   62:     float n = noise(vUv * 12.0) * 0.6 + noise(vUv * 31.0) * 0.4;
   63:     // Threshold sweeps from below the noise range (shows A) to above it (shows B).
   64:     float th = uMix * 1.1 - 0.05;
   65:     float showB = 1.0 - smoothstep(th - 0.04, th + 0.04, n);
   66:     // A thin warm rim on the dissolve front, so the change reads as material, not a cut.
   67:     float rim = smoothstep(th - 0.04, th + 0.04, n) * (1.0 - smoothstep(th + 0.04, th + 0.10, n));
   68:     vec3 color = mix(a.rgb, b.rgb, showB) + vec3(0.55, 0.42, 0.22) * rim * 0.6;
   69:     gl_FragColor = vec4(color, uOpacity);
   70:   }
   71: `;
   72: 
   73: interface Textures {
   74:   portrait: THREE.Texture;
   75:   photo01: THREE.Texture;
   76:   photo02: THREE.Texture;
   77:   photo03: THREE.Texture;
   78: }
   79: 
   80: /** Plate texture size. Plates are 4:5 portrait, like the placeholders and the recommended photo crop. */
   81: const PLATE_TEX_W = 800;
   82: const PLATE_TEX_H = 1000;
   83: 
   84: /**
   85:  * Decode an image and draw it, cover-fit, into a fixed-size canvas. Images without intrinsic size
   86:  * (the placeholder SVGs) upload to WebGL as empty textures when passed straight to TextureLoader,
   87:  * so this step is required for them to render. Real photographs use the same path.
   88:  */
   89: async function loadPlateTexture(src: string): Promise<THREE.Texture> {
   90:   const img = new Image();
   91:   img.decoding = 'async';
   92:   img.src = src;
   93:   await img.decode();
   94: 
   95:   const canvas = document.createElement('canvas');
   96:   canvas.width = PLATE_TEX_W;
   97:   canvas.height = PLATE_TEX_H;
   98:   const ctx = canvas.getContext('2d');
   99:   if (!ctx) throw new Error('2D canvas unavailable');
  100: 
  101:   const srcW = img.naturalWidth || PLATE_TEX_W;
  102:   const srcH = img.naturalHeight || PLATE_TEX_H;
  103:   const scale = Math.max(PLATE_TEX_W / srcW, PLATE_TEX_H / srcH);
  104:   const dw = srcW * scale;
  105:   const dh = srcH * scale;
  106:   ctx.drawImage(img, (PLATE_TEX_W - dw) / 2, (PLATE_TEX_H - dh) / 2, dw, dh);
  107: 
  108:   const tex = new THREE.CanvasTexture(canvas);
  109:   tex.colorSpace = THREE.SRGBColorSpace;
  110:   tex.needsUpdate = true;
  111:   return tex;
  112: }
  113: 
  114: /** Load the placeholder plates once. Disposed on unmount. */
  115: function useTextures(onFail: () => void): Textures | null {
  116:   const [textures, setTextures] = useState<Textures | null>(null);
  117:   const onFailRef = useRef(onFail);
  118:   onFailRef.current = onFail;
  119: 
  120:   useEffect(() => {
  121:     let live = true;
  122:     const load = (id: (typeof TEXTURE_IDS)[number]) => loadPlateTexture(getMuseumAsset(id).src);
  123: 
  124:     Promise.all(TEXTURE_IDS.map(load))
  125:       .then(([portrait, photo01, photo02, photo03]) => {
  126:         if (!live) {
  127:           [portrait, photo01, photo02, photo03].forEach((t) => t.dispose());
  128:           return;
  129:         }
  130:         setTextures({ portrait, photo01, photo02, photo03 });
  131:       })
  132:       .catch(() => {
  133:         if (live) onFailRef.current();
  134:       });
  135: 
  136:     return () => {
  137:       live = false;
  138:     };
  139:   }, []);
  140: 
  141:   // Dispose the textures this hook created when the component unmounts.
  142:   useEffect(() => {
  143:     return () => {
  144:       if (!textures) return;
  145:       Object.values(textures).forEach((t) => t.dispose());
  146:     };
  147:   }, [textures]);
  148: 
  149:   return textures;
  150: }
  151: 
  152: /** Stage geometry at the reference distance, in world units. */
  153: function stageAt(aspect: number) {
  154:   const halfH = Math.tan(THREE.MathUtils.degToRad(FOV / 2)) * REF_DIST;
  155:   return { halfH, halfW: halfH * aspect };
  156: }
  157: 
  158: function CameraRig({ frame }: { frame: MuseumFrame }) {
  159:   const camera = useThree((s) => s.camera) as THREE.PerspectiveCamera;
  160:   const invalidate = useThree((s) => s.invalidate);
  161:   const aspect = useThree((s) => s.size.width / Math.max(1, s.size.height));
  162: 
  163:   useEffect(() => {
  164:     const { halfW } = stageAt(aspect);
  165:     // Zoom is dolly: a larger zoom moves the camera closer, so the planes travel toward the viewer.
  166:     // Cubed zoom: the shared keyframes move only ~20%, so the depth travel is amplified here. This changes
  167:     // how the renderer reads the same frame value, not the timing, which still comes only from the evaluator.
  168:     const dist = REF_DIST / Math.pow(frame.camera.zoom, 3);
  169:     // Lateral drift is a percentage of the stage width at the current distance.
  170:     const panX = (frame.camera.x / 100) * 2 * halfW * (dist / REF_DIST);
  171:     camera.position.set(panX, 0, dist);
  172:     camera.lookAt(panX, 0, 0);
  173:     camera.updateProjectionMatrix();
  174:     invalidate();
  175:   }, [frame.camera.zoom, frame.camera.x, aspect, camera, invalidate]);
  176: 
  177:   return null;
  178: }
  179: 
  180: function Scene({ frame, textures }: { frame: MuseumFrame; textures: Textures }) {
  181:   const aspect = useThree((s) => s.size.width / Math.max(1, s.size.height));
  182:   const invalidate = useThree((s) => s.invalidate);
  183:   const { halfH, halfW } = stageAt(aspect);
  184: 
  185:   const dissolveRef = useRef<THREE.ShaderMaterial>(null);
  186: 
  187:   // The dissolve follows the shared transition. Before the boundary it shows the portrait; after, the photograph.
  188:   const boundary = MUSEUM_SCENES[1].start;
  189:   const transition = frame.scenes.transition;
  190:   const mix =
  191:     transition?.from === 'yeriel' ? transition.amount : frame.progress >= boundary ? 1 : 0;
  192: 
  193:   const heroOpacity =
  194:     Math.max(frame.scenes.opacity.yeriel, frame.scenes.opacity.mofundo) * (1 - frame.scenes.opacity['remember-him']);
  195: 
  196:   const dust = useMemo(() => {
  197:     const positions = new Float32Array(DUST_COUNT * 3);
  198:     // Deterministic scatter so the frame is reproducible across renders and screenshots.
  199:     let seed = 1337;
  200:     const rand = () => {
  201:       seed = (seed * 16807) % 2147483647;
  202:       return seed / 2147483647;
  203:     };
  204:     for (let i = 0; i < DUST_COUNT; i += 1) {
  205:       positions[i * 3] = (rand() * 2 - 1) * halfW * 0.9;
  206:       positions[i * 3 + 1] = (rand() * 2 - 1) * halfH * 0.9;
  207:       positions[i * 3 + 2] = -1.5 + rand() * 3;
  208:     }
  209:     const geo = new THREE.BufferGeometry();
  210:     geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  211:     return geo;
  212:   }, [halfH, halfW]);
  213: 
  214:   useEffect(() => () => dust.dispose(), [dust]);
  215: 
  216:   useEffect(() => {
  217:     const material = dissolveRef.current;
  218:     if (material) {
  219:       material.uniforms.uMix.value = mix;
  220:       material.uniforms.uOpacity.value = heroOpacity;
  221:     }
  222:     invalidate();
  223:   }, [mix, heroOpacity, invalidate, frame]);
  224: 
  225:   const dissolveUniforms = useMemo(
  226:     () => ({
  227:       uA: { value: textures.portrait },
  228:       uB: { value: textures.photo01 },
  229:       uMix: { value: 0 },
  230:       uOpacity: { value: 1 },
  231:     }),
  232:     [textures]
  233:   );
  234: 
  235:   const heroHeight = halfH * 1.7;
  236:   const heroWidth = heroHeight / PLATE_ASPECT;
  237: 
  238:   const dustOpacity = Math.min(1, Math.max(frame.scenes.opacity.yeriel, frame.scenes.opacity.mofundo)) * 0.55;
  239: 
  240:   return (
  241:     <group>
  242:       {/* The portrait plate. It persists through the transition: its pixels become the photograph. */}
  243:       <mesh position={[0, -halfH * 0.04, 0]} renderOrder={2}>
  244:         <planeGeometry args={[heroWidth, heroHeight]} />
  245:         <shaderMaterial
  246:           ref={dissolveRef}
  247:           vertexShader={DISSOLVE_VERT}
  248:           fragmentShader={DISSOLVE_FRAG}
  249:           uniforms={dissolveUniforms}
  250:           transparent
  251:           depthWrite={false}
  252:         />
  253:       </mesh>
  254: 
  255:       {/* Scene 02 plates: depth layers the camera travels past. */}
  256:       {SCENE_TWO_PLATES.map((plate, i) => {
  257:         const tex = [textures.photo01, textures.photo02, textures.photo03][i];
  258:         const f = frame.mofundo.plates[i];
  259:         const widthPct = plate.width;
  260:         const leftPct = plate.left + f.dx;
  261:         const topPct = plate.top;
  262:         const w = (widthPct / 100) * 2 * halfW;
  263:         const h = w / PLATE_ASPECT;
  264:         const x = ((leftPct + widthPct / 2) / 100) * 2 * halfW - halfW;
  265:         const y = halfH - (topPct / 100) * 2 * halfH - h / 2;
  266:         // Depth layers spread apart, so the camera dollying in passes them at different speeds.
  267:         const z = -1.5 - i * 1.6;
  268:         return (
  269:           <mesh key={plate.id} position={[x, y, z]} renderOrder={1}>
  270:             <planeGeometry args={[w, h]} />
  271:             <meshBasicMaterial map={tex} transparent opacity={f.opacity * heroOpacity} depthWrite={false} />
  272:           </mesh>
  273:         );
  274:       })}
  275: 
  276:       {/* Dust in the beam: at most DUST_COUNT points. Carries through into Scene 02. */}
  277:       <points geometry={dust} renderOrder={3}>
  278:         <pointsMaterial color="#e9dcc4" size={0.025} sizeAttenuation transparent opacity={dustOpacity} depthWrite={false} />
  279:       </points>
  280:     </group>
  281:   );
  282: }
  283: 
  284: /** Redraws when the frame changes, and releases its GPU resources on unmount. */
  285: function FrameBridge({ frame }: { frame: MuseumFrame }) {
  286:   const invalidate = useThree((s) => s.invalidate);
  287:   useEffect(() => {
  288:     invalidate();
  289:   }, [frame, invalidate]);
  290:   return null;
  291: }
  292: 
  293: interface MuseumWebGLProps {
  294:   frame: MuseumFrame;
  295:   onFail: () => void;
  296: }
  297: 
  298: /** Catches a renderer that throws during creation, so the page can drop to the DOM tier. */
  299: class RendererBoundary extends Component<{ onFail: () => void; children: ReactNode }, { failed: boolean }> {
  300:   state = { failed: false };
  301:   static getDerivedStateFromError() {
  302:     return { failed: true };
  303:   }
  304:   componentDidCatch() {
  305:     this.props.onFail();
  306:   }
  307:   render() {
  308:     return this.state.failed ? null : this.props.children;
  309:   }
  310: }
  311: 
  312: function MuseumWebGLInner({ frame, onFail }: { frame: MuseumFrame; onFail: () => void }) {
  313:   const textures = useTextures(onFail);
  314:   if (!textures) return null;
  315:   return (
  316:     <>
  317:       <CameraRig frame={frame} />
  318:       <FrameBridge frame={frame} />
  319:       <Scene frame={frame} textures={textures} />
  320:     </>
  321:   );
  322: }
  323: 
  324: export default function MuseumWebGL({ frame, onFail }: MuseumWebGLProps) {
  325:   return (
  326:     <div className="museum-webgl" aria-hidden="true">
  327:       <RendererBoundary onFail={onFail}>
  328:         <Canvas
  329:           frameloop="demand"
  330:           dpr={[1, 1.5]}
  331:           gl={{ antialias: false, alpha: true, powerPreference: 'low-power' }}
  332:           camera={{ fov: FOV, near: 0.1, far: 50, position: [0, 0, REF_DIST] }}
  333:           onCreated={({ gl }) => {
  334:             gl.domElement.addEventListener(
  335:               'webglcontextlost',
  336:               (event) => {
  337:                 event.preventDefault();
  338:                 onFail();
  339:               },
  340:               { once: true }
  341:             );
  342:           }}
  343:         >
  344:           <MuseumWebGLInner frame={frame} onFail={onFail} />
  345:         </Canvas>
  346:       </RendererBoundary>
  347:     </div>
  348:   );
  349: }

===== src/lib/museumCapability.ts =====
    1: /**
    2:  * Museum rendering tier. Decided once, on the client, after mount.
    3:  *
    4:  * - `cinematic`: the WebGL canvas renders Scenes 01 and 02. Text, controls and the
    5:  *   accessibility layer are always the DOM.
    6:  * - `dom`: the existing DOM/CSS sequence, with no canvas and no renderer code loaded.
    7:  *
    8:  * Reduced motion always resolves to `dom`. A lost WebGL context drops to `dom` and does
    9:  * not retry automatically. This module is pure so the decision can be tested without a browser.
   10:  */
   11: 
   12: export type MuseumTier = 'cinematic' | 'dom';
   13: 
   14: export interface MuseumCapabilityInput {
   15:   /** The cinematic experiment is opt-in (`?cinematic=1`) until it passes its success criteria. */
   16:   optedIn: boolean;
   17:   reducedMotion: boolean;
   18:   /** Whether a WebGL2 context can be created in this browser. */
   19:   webgl2: boolean;
   20:   /** Set once a context loss or creation failure has been observed. Sticky for the page visit. */
   21:   contextFailed: boolean;
   22: }
   23: 
   24: export function decideMuseumTier(input: MuseumCapabilityInput): MuseumTier {
   25:   if (!input.optedIn) return 'dom';
   26:   if (input.reducedMotion) return 'dom';
   27:   if (!input.webgl2) return 'dom';
   28:   if (input.contextFailed) return 'dom';
   29:   return 'cinematic';
   30: }
   31: 
   32: /**
   33:  * Whether this browser can create a WebGL2 context. Browser-only; returns false on the
   34:  * server and on any exception, so the caller falls back to the DOM tier.
   35:  */
   36: export function detectWebGL2(): boolean {
   37:   if (typeof document === 'undefined') return false;
   38:   try {
   39:     const canvas = document.createElement('canvas');
   40:     const gl = canvas.getContext('webgl2');
   41:     if (!gl) return false;
   42:     // Release the probe context immediately; the renderer creates its own.
   43:     const loseContext = gl.getExtension('WEBGL_lose_context');
   44:     loseContext?.loseContext();
   45:     return true;
   46:   } catch {
   47:     return false;
   48:   }
   49: }

