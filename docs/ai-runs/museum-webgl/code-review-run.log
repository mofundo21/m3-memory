   31: const STORAGE_KEY = 'm3_memory_wizard_draft';
   32: 
   33: const defaultState: MemoryWizardState = {
   34:   memoryText: '',
   35:   whereWe: '',
   36:   aroundWhen: '',
   37:   whoElse: '',
   38:   whatMadeStick: '',
   39:   dontRemember: '',
