### scripts/museum-timeline-tests.mjs
    1: import assert from "node:assert/strict";
    2: import { registerHooks } from "node:module";
    3: import { fileURLToPath, pathToFileURL } from "node:url";
    4: import { join, dirname } from "node:path";
    5: 
    6: // Unit tests for the museum timeline evaluator. Pure logic only: no DOM, no browser.
    7: const srcRoot = join(dirname(fileURLToPath(import.meta.url)), "..", "src");
    8: 
    9: registerHooks({
   10:   resolve(specifier, context, nextResolve) {
   11:     if (specifier.startsWith("@/")) {
   12:       const target = join(srcRoot, specifier.slice(2));
   13:       const withExt = target.endsWith(".ts") ? target : `${target}.ts`;
   14:       return { url: pathToFileURL(withExt).href, shortCircuit: true };
   15:     }
   16:     return nextResolve(specifier, context);
   17:   },
   18: });
   19: 
   20: const { evaluateMuseumFrame, JOIN_ACTIVE_AT } = await import("../src/lib/museumTimeline.ts");
   21: const { cameraAt, sceneOpacity, within } = await import("../src/lib/museumCamera.ts");
   22: const { MUSEUM_BEATS, MUSEUM_COPY, MUSEUM_SCENES, SCENE_FADE, ENTER_PROGRESS, SCENE_THREE_PLATES, SCENE_TWO_PLATES } =
   23:   await import("../src/lib/museumConfig.ts");
   24: 
   25: const samples = Array.from({ length: 401 }, (_, i) => i / 400);
   26: const frame = (progress, reducedMotion = false, counterCount = 4) =>
   27:   evaluateMuseumFrame({ progress, reducedMotion, counterCount });
   28: 
   29: // 1. Parity: the evaluator must produce the same numbers the previous component computed inline.
   30: for (const p of samples) {
   31:   const f = frame(p);
   32:   const cam = cameraAt(p);
   33:   assert.equal(f.camera.zoom, cam.zoom, `camera zoom at ${p}`);
   34:   assert.equal(f.camera.x, cam.x, `camera x at ${p}`);
   35:   for (const scene of MUSEUM_SCENES) {
   36:     assert.equal(f.scenes.opacity[scene.id], sceneOpacity(scene.id, p), `${scene.id} opacity at ${p}`);
   37:   }
   38:   assert.equal(f.yeriel.nameOpacity, within(p, ...MUSEUM_BEATS.yeriel.nameIn), `name in at ${p}`);
   39:   assert.equal(f.yeriel.nameY, within(p, ...MUSEUM_BEATS.yeriel.nameShrink) * -28, `name y at ${p}`);
   40:   assert.equal(f.yeriel.nameScale, 1 - within(p, ...MUSEUM_BEATS.yeriel.nameShrink) * 0.5, `name scale at ${p}`);
   41:   assert.equal(f.enter.opacity, Math.max(0, Math.min(1, 1 - p / ENTER_PROGRESS)), `enter at ${p}`);
   42:   assert.equal(f.join.active, p >= JOIN_ACTIVE_AT, `join active at ${p}`);
   43: }
   44: 
   45: // 2. Reduced motion: no camera travel, no crossfade, no overlapping scenes.
   46: for (const p of samples) {
   47:   const f = frame(p, true);
   48:   assert.deepEqual(f.camera, { zoom: 1, x: 0 }, `rm camera at ${p}`);
   49:   assert.equal(f.scenes.transition, null, `rm transition at ${p}`);
   50:   const visible = MUSEUM_SCENES.filter((s) => f.scenes.opacity[s.id] > 0).length;
   51:   assert.ok(visible <= 1, `rm shows ${visible} scenes at ${p}`);
   52:   for (const scene of MUSEUM_SCENES) {
   53:     const o = f.scenes.opacity[scene.id];
   54:     assert.ok(o === 0 || o === 1, `rm scene opacity must be a hard 0 or 1 at ${p}`);
   55:   }
   56:   assert.equal(f.yeriel.nameY, 0, `rm name must not travel at ${p}`);
   57:   assert.equal(f.yeriel.nameScale, 1, `rm name must not scale at ${p}`);
   58:   for (const plate of f.mofundo.plates) assert.equal(plate.dx, 0, `rm plate drift at ${p}`);
   59:   for (const plate of f.rememberHim.plates) assert.equal(plate.scale, 1, `rm plate depth at ${p}`);
   60: }
   61: 
   62: // 3. Reduced motion shows the final scene at progress 1 (the last scene holds to the end).
   63: assert.equal(frame(1, true).scenes.opacity.join, 1, "rm join visible at end of track");
   64: 
   65: // 4. Every opacity stays inside 0..1 across the whole track, in both modes.
   66: for (const rm of [false, true]) {
   67:   for (const p of samples) {
   68:     const f = frame(p, rm);
   69:     const all = [
   70:       ...Object.values(f.scenes.opacity),
   71:       f.enter.opacity,
   72:       f.yeriel.nameOpacity,
   73:       f.yeriel.metaOpacity,
   74:       ...f.yeriel.fragmentOpacity,
   75:       f.mofundo.nameOpacity,
   76:       f.mofundo.waveformOpacity,
   77:       ...f.mofundo.plates.map((x) => x.opacity),
   78:       f.rememberHim.questionOpacity,
   79:       ...f.rememberHim.plates.map((x) => x.opacity),
   80:       ...f.rememberHim.evidenceOpacity,
   81:       ...f.rememberHim.fragmentOpacity,
   82:       f.join.countersOpacity,
   83:       ...f.join.counterOpacity,
   84:       ...f.join.lineOpacity,
   85:       f.join.joinOpacity,
   86:       f.join.ctaOpacity,
   87:     ];
   88:     for (const v of all) assert.ok(v >= 0 && v <= 1, `opacity ${v} out of range at ${p} rm=${rm}`);
   89:   }
   90: }
   91: 
   92: // 5. Transitions: present only inside a scene boundary window, with a valid from/to pair.
   93: const boundaries = MUSEUM_SCENES.slice(1).map((s) => s.start);
   94: for (const b of boundaries) {
   95:   const mid = frame(b).scenes.transition;
   96:   assert.ok(mid, `transition expected at boundary ${b}`);
   97:   assert.ok(mid.amount >= 0 && mid.amount <= 1);
   98: }
   99: assert.equal(frame(0.12).scenes.transition, null, "no transition mid-scene");
  100: assert.equal(frame(0.38).scenes.transition, null, "no transition mid-scene");
  101: const t = frame(boundaries[0]).scenes.transition;
  102: assert.equal(t.from, "yeriel");
  103: assert.equal(t.to, "mofundo");
  104: assert.ok(Math.abs(t.amount - 0.5) < 1e-9, "amount is 0.5 exactly at the boundary");
  105: assert.equal(frame(boundaries[0] + SCENE_FADE + 0.001).scenes.transition, null, "transition ends after the fade window");
  106: 
  107: // 6. Join threshold: the CTA becomes active only once the join beat is reached.
  108: assert.equal(frame(MUSEUM_BEATS.join.joinIn[0] - 0.01).join.active, false);
  109: assert.equal(frame(JOIN_ACTIVE_AT).join.active, true);
  110: assert.equal(frame(1).join.active, true);
  111: 
  112: // 7. ENTER: visible at the start, inert once it is mostly faded out.
  113: assert.equal(frame(0).enter.opacity, 1);
  114: assert.equal(frame(0).enter.inert, false);
  115: assert.equal(frame(ENTER_PROGRESS).enter.opacity, 0);
  116: assert.equal(frame(ENTER_PROGRESS).enter.inert, true);
  117: 
  118: // 8. Scene 03 plates carry the 0.85 cap; Scene 02 plates do not.
  119: // Sample after the last plate has fully arrived (its plateIn window ends at 0.60 and 0.38).
  120: const late = frame(0.61);
  121: for (const plate of late.rememberHim.plates) assert.ok(Math.abs(plate.opacity - 0.85) < 1e-9, "scene 03 cap is 0.85");
  122: const twoLate = frame(0.39);
  123: for (const plate of twoLate.mofundo.plates) assert.ok(Math.abs(plate.opacity - 1) < 1e-9, "scene 02 is full opacity");
  124: 
  125: // 9. Plate depth scale and drift follow the config.
  126: const depthFrame = frame(0.55);
  127: SCENE_THREE_PLATES.forEach((plate, i) => {
  128:   assert.equal(depthFrame.rememberHim.plates[i].scale, plate.depth ?? 1, `depth scale ${plate.id}`);
  129: });
  130: const driftFrame = frame(MUSEUM_BEATS.mofundo.drift[1]);
  131: SCENE_TWO_PLATES.forEach((plate, i) => {
  132:   assert.equal(driftFrame.mofundo.plates[i].dx, plate.drift ?? 0, `drift ${plate.id}`);
  133: });
  134: 
  135: // 10. Lists follow their inputs: counters, and the fragment count from the copy.
  136: assert.equal(frame(0.8, false, 0).join.counterOpacity.length, 0, "no counters, no entries");
  137: assert.equal(frame(0.8, false, 6).join.counterOpacity.length, 6, "counter entries follow the count");
  138: assert.equal(frame(0.2).yeriel.fragmentOpacity.length, MUSEUM_COPY.yeriel.fragments.length);
  139: assert.equal(frame(0.2).join.lineOpacity.length, MUSEUM_COPY.join.lines.length);
  140: 
  141: // 11. Message lines hand off in order: the current line is visible on its beat, and lines two or more
  142: // ahead are hidden. Adjacent lines may overlap briefly, because they crossfade by design.
  143: const lineFrames = MUSEUM_BEATS.join.lineStarts.map((s) => frame(s + 0.01).join.lineOpacity);
  144: lineFrames.forEach((lines, i) => {
  145:   assert.ok(lines[i] > 0, `line ${i} visible on its beat`);
  146:   lines.forEach((v, j) => {
  147:     if (j >= i + 2) assert.equal(v, 0, `line ${j} hidden on line ${i}'s beat`);
  148:   });
  149: });
  150: 
  151: // 12. Purity: the same input always gives the same output.
  152: assert.deepEqual(frame(0.37), frame(0.37));
  153: 
  154: console.log("museum timeline tests ok");

### scripts/museum-capability-tests.mjs
    1: import assert from "node:assert/strict";
    2: import { registerHooks } from "node:module";
    3: import { fileURLToPath, pathToFileURL } from "node:url";
    4: import { join, dirname } from "node:path";
    5: 
    6: // Unit tests for the museum tier decision. Pure logic: no browser, no WebGL.
    7: const srcRoot = join(dirname(fileURLToPath(import.meta.url)), "..", "src");
    8: registerHooks({
    9:   resolve(specifier, context, nextResolve) {
   10:     if (specifier.startsWith("@/")) {
   11:       return { url: pathToFileURL(join(srcRoot, `${specifier.slice(2)}.ts`)).href, shortCircuit: true };
   12:     }
   13:     return nextResolve(specifier, context);
   14:   },
   15: });
   16: 
   17: const { decideMuseumTier, detectWebGL2 } = await import("../src/lib/museumCapability.ts");
   18: 
   19: const base = { optedIn: true, reducedMotion: false, webgl2: true, contextFailed: false };
   20: 
   21: // Cinematic only when the visitor opted in, the browser can do it, motion is allowed, and no context failure was seen.
   22: assert.equal(decideMuseumTier(base), "cinematic");
   23: 
   24: // Without the opt-in (the default), the page stays on the DOM tier even on a capable browser.
   25: assert.equal(decideMuseumTier({ ...base, optedIn: false }), "dom");
   26: 
   27: // Reduced motion always wins, even with full WebGL support.
   28: assert.equal(decideMuseumTier({ ...base, reducedMotion: true }), "dom");
   29: 
   30: // No WebGL2: DOM tier.
   31: assert.equal(decideMuseumTier({ ...base, webgl2: false }), "dom");
   32: 
   33: // A failure is sticky for the visit: once recorded, the tier stays DOM.
   34: assert.equal(decideMuseumTier({ ...base, contextFailed: true }), "dom");
   35: 
   36: // Every combination of the three inputs resolves to one of the two tiers, and only one combination is cinematic.
   37: let cinematic = 0;
   38: for (const optedIn of [false, true]) {
   39:   for (const reducedMotion of [false, true]) {
   40:     for (const webgl2 of [false, true]) {
   41:       for (const contextFailed of [false, true]) {
   42:         const tier = decideMuseumTier({ optedIn, reducedMotion, webgl2, contextFailed });
   43:         assert.ok(tier === "cinematic" || tier === "dom");
   44:         if (tier === "cinematic") cinematic += 1;
   45:       }
   46:     }
   47:   }
   48: }
   49: assert.equal(cinematic, 1, "exactly one input combination is cinematic");
   50: 
   51: // Server-side (no document): the probe reports no WebGL and never throws.
   52: assert.equal(detectWebGL2(), false, "probe is false outside the browser");
   53: 
   54: console.log("museum capability tests ok");

### scripts/museum-webgl-test.mjs
    1: import assert from "node:assert/strict";
    2: import { spawn, spawnSync } from "node:child_process";
    3: import { setTimeout as delay } from "node:timers/promises";
    4: import puppeteer from "puppeteer";
    5: 
    6: // Browser checks for the cinematic WebGL layer (YERIEL â†’ MOFUNDO):
    7: // - the default visit stays on the DOM tier;
    8: // - the opt-in visit renders the canvas and loads the lazy renderer chunk;
    9: // - reduced motion and no-WebGL fall back to the DOM tier with the text intact and no renderer chunk loaded;
   10: // - a forced context loss drops to the DOM tier without errors;
   11: // - a phone viewport mounts the layer without horizontal overflow.
   12: const port = Number(process.env.MUSEUM_WEBGL_TEST_PORT || 3197);
   13: const base = `http://127.0.0.1:${port}`;
   14: const shotDir = process.env.MUSEUM_WEBGL_SHOTS || null;
   15: const GL_ARGS = ["--use-gl=angle", "--use-angle=swiftshader", "--enable-unsafe-swiftshader"];
   16: 
   17: const child = spawn(
   18:   process.platform === "win32" ? "cmd.exe" : "npm",
   19:   process.platform === "win32" ? ["/d", "/s", "/c", `npm run start -- -p ${port}`] : ["run", "start", "--", "-p", String(port)],
   20:   {
   21:     env: { ...process.env, M3_PERSISTENCE: "sqlite", M3_ADMIN_AUTH: "local", DATABASE_PATH: `.m3-memory/museum-webgl-${port}.sqlite`, ADMIN_PASSWORD: "fictional-webgl-password", SESSION_SECRET: "fictional-webgl-session-secret-length" },
   22:     stdio: "ignore",
   23:     windowsHide: true,
   24:   }
   25: );
   26: 
   27: /**
   28:  * Records every chunk a page requests, and whether its code is the three.js renderer. Identified by content,
   29:  * not by file name: Next also loads small router chunks after hydration, which are not the renderer.
   30:  */
   31: function recordChunks(page) {
   32:   const pending = [];
   33:   page.on("response", (response) => {
   34:     if (!/\/static\/chunks\/.*\.js/.test(response.url())) return;
   35:     const name = response.url().split("/").pop();
   36:     pending.push(
   37:       response
   38:         .text()
   39:         .then((body) => ({ name, renderer: /ShaderMaterial|PointsMaterial|WebGLRenderer/.test(body) }))
   40:         .catch(() => ({ name, renderer: false }))
   41:     );
   42:   });
   43:   return async () => Promise.all(pending);
   44: }
   45: 
   46: async function waitForServer() {
   47:   for (let i = 0; i < 60; i++) {
   48:     try {
   49:       if ((await fetch(`${base}/api/health`)).ok) return;
   50:     } catch {}
   51:     await delay(500);
   52:   }
   53:   throw new Error("museum webgl test server did not start");
   54: }
   55: 
   56: /** Scroll so the sequence sits at normalized progress p (0..1). */
   57: async function scrollToProgress(page, p) {
   58:   await page.evaluate((target) => {
   59:     const track = document.querySelector(".museum-track");
   60:     const top = track.getBoundingClientRect().top + window.scrollY;
   61:     const scrollable = track.offsetHeight - window.innerHeight;
   62:     window.scrollTo({ top: top + target * scrollable, behavior: "instant" });
   63:   }, p);
   64:   await delay(300);
   65: }
   66: 
   67: /** Collects uncaught page errors, failed HTTP responses, and console errors. */
   68: function watchErrors(page) {
   69:   const errors = [];
   70:   page.on("pageerror", (e) => errors.push(`pageerror: ${e.message}`));
   71:   page.on("response", (r) => {
   72:     // The favicon is a known, documented 404 (no project favicon exists). Any other 4xx/5xx is a real failure.
   73:     if (r.status() >= 400 && !r.url().endsWith("/favicon.ico")) errors.push(`http ${r.status()}: ${r.url()}`);
   74:   });
   75:   page.on("console", (m) => {
   76:     if (m.type() === "error" && !/Failed to load resource: the server responded with a status of 404/.test(m.text())) {
   77:       errors.push(`console: ${m.text()}`);
   78:     }
   79:   });
   80:   return errors;
   81: }
   82: 
   83: /** Renderer chunks among the recorded requests (see recordChunks). */
   84: async function rendererChunks(readChunks) {
   85:   return (await readChunks()).filter((c) => c.renderer).map((c) => c.name);
   86: }
   87: 
   88: /** Errors that are expected when WebGL is unavailable or lost. */
   89: const isGlError = (e) => /WebGL|GL_|context|GPU/i.test(e);
   90: 
   91: try {
   92:   await waitForServer();
   93: 
   94:   // ---- A. Cinematic tier in a WebGL-capable browser ----
   95:   const browser = await puppeteer.launch({ headless: true, args: GL_ARGS });
   96:   try {
   97:     // Default visit: DOM tier, no canvas, no renderer chunk.
   98:     const defaultPage = await browser.newPage();
   99:     await defaultPage.setViewport({ width: 1440, height: 900 });
  100:     const defaultChunks = recordChunks(defaultPage);
  101:     await defaultPage.goto(`${base}/museum`, { waitUntil: "networkidle0" });
  102:     await delay(500);
  103:     assert.equal(await defaultPage.$(".museum-root.is-cinematic"), null, "default visit is the DOM tier");
  104:     assert.equal(await defaultPage.$(".museum-webgl canvas"), null, "default visit renders no canvas");
  105:     assert.deepEqual(await rendererChunks(defaultChunks), [], "default visit downloads no renderer chunk");
  106:     await defaultPage.close();
  107: 
  108:     // Opt-in visit: the cinematic experiment.
  109:     const page = await browser.newPage();
  110:     await page.setViewport({ width: 1440, height: 900 });
  111:     const errors = watchErrors(page);
  112:     const cinematicChunks = recordChunks(page);
  113:     await page.goto(`${base}/museum?cinematic=1`, { waitUntil: "networkidle0" });
  114:     await page.waitForSelector(".museum-root.is-cinematic", { timeout: 20000 });
  115:     await page.waitForSelector(".museum-webgl canvas", { timeout: 20000 });
  116:     assert.ok((await rendererChunks(cinematicChunks)).length > 0, "cinematic visit loads the renderer chunk");
  117: 
  118:     const canvas = await page.$eval(".museum-webgl canvas", (c) => ({ w: c.width, h: c.height }));
  119:     assert.ok(canvas.w > 0 && canvas.h > 0, "canvas has a drawing surface");
  120:     assert.equal(await page.$eval(".museum-webgl", (el) => el.getAttribute("aria-hidden")), "true", "canvas layer is decorative");
  121:     assert.equal(await page.$eval(".museum-scene-01 .museum-portrait", (el) => getComputedStyle(el).display), "none", "DOM portrait is replaced by the canvas");
  122:     assert.ok(await page.$eval(".museum-name", (el) => el.textContent.includes("YERIEL")), "DOM name is still present");
  123:     assert.equal(await page.$eval(".museum-cta-slot", (el) => el.inert), true, "CTA inert before its beat, as before");
  124: 
  125:     if (shotDir) {
  126:       await scrollToProgress(page, 0.12);
  127:       await page.screenshot({ path: `${shotDir}/webgl-yeriel-0.12.png` });
  128:       await scrollToProgress(page, 0.19);
  129:       await page.screenshot({ path: `${shotDir}/webgl-travel-0.19.png` });
  130:       await scrollToProgress(page, 0.27);
  131:       await page.screenshot({ path: `${shotDir}/webgl-transition-0.27.png` });
  132:       await scrollToProgress(page, 0.4);
  133:       await page.screenshot({ path: `${shotDir}/webgl-mofundo-0.40.png` });
  134:     }
  135: 
  136:     // Phone viewport: the layer mounts and nothing overflows horizontally.
  137:     const mobile = await browser.newPage();
  138:     await mobile.setViewport({ width: 390, height: 844, isMobile: true, hasTouch: true });
  139:     const mobileErrors = watchErrors(mobile);
  140:     await mobile.goto(`${base}/museum?cinematic=1`, { waitUntil: "networkidle0" });
  141:     await mobile.waitForSelector(".museum-webgl canvas", { timeout: 20000 });
  142:     const overflow = await mobile.evaluate(() => document.documentElement.scrollWidth - window.innerWidth);
  143:     assert.ok(overflow <= 0, `no horizontal overflow on a phone (overflow ${overflow}px)`);
  144:     if (shotDir) {
  145:       await scrollToProgress(mobile, 0.3);
  146:       await mobile.screenshot({ path: `${shotDir}/webgl-mobile-0.30.png` });
  147:     }
  148:     assert.deepEqual(mobileErrors.filter((e) => !isGlError(e)), [], "no unexpected errors on a phone");
  149:     await mobile.close();
  150: 
  151:     // Context loss drops to the DOM tier cleanly.
  152:     await page.evaluate(() => {
  153:       const gl = document.querySelector(".museum-webgl canvas").getContext("webgl2");
  154:       gl.getExtension("WEBGL_lose_context").loseContext();
  155:     });
  156:     await page.waitForFunction(() => !document.querySelector(".museum-webgl canvas") && !document.querySelector(".museum-root.is-cinematic"), { timeout: 10000 });
  157:     assert.ok(await page.$eval(".museum-name", (el) => el.textContent.includes("YERIEL")), "DOM text survives context loss");
  158:     await scrollToProgress(page, 0.4);
  159:     assert.ok(await page.$(".museum-scene-02 .museum-plate"), "DOM Scene 02 plates return after context loss");
  160:     assert.deepEqual(errors.filter((e) => !isGlError(e)), [], "no unexpected page errors in the cinematic visit");
  161:     await page.close();
  162:   } finally {
  163:     await browser.close();
  164:   }
  165: 
  166:   // ---- B. Reduced motion: DOM tier, no canvas, no renderer chunk downloaded ----
  167:   const reducedBrowser = await puppeteer.launch({ headless: true, args: GL_ARGS });
  168:   try {
  169:     const page = await reducedBrowser.newPage();
  170:     await page.setViewport({ width: 1440, height: 900 });
  171:     const errors = watchErrors(page);
  172:     const chunks = recordChunks(page);
  173:     await page.emulateMediaFeatures([{ name: "prefers-reduced-motion", value: "reduce" }]);
  174:     await page.goto(`${base}/museum?cinematic=1`, { waitUntil: "networkidle0" });
  175:     await delay(500);
  176:     assert.equal(await page.$(".museum-root.is-cinematic"), null, "reduced motion is never cinematic");
  177:     assert.equal(await page.$(".museum-webgl canvas"), null, "reduced motion renders no canvas");
  178:     assert.deepEqual(await rendererChunks(chunks), [], "reduced motion downloads no renderer chunk");
  179:     assert.ok(await page.$(".museum-name"), "DOM sequence still present");
  180:     assert.deepEqual(errors, [], "no page errors under reduced motion");
  181:     await page.close();
  182:   } finally {
  183:     await reducedBrowser.close();
  184:   }
  185: 
  186:   // ---- C. WebGL disabled: DOM tier with the full content ----
  187:   const noGl = await puppeteer.launch({ headless: true, args: ["--disable-webgl", "--disable-webgl2", "--disable-3d-apis"] });
  188:   try {
  189:     const page = await noGl.newPage();
  190:     await page.setViewport({ width: 1440, height: 900 });
  191:     const errors = watchErrors(page);
  192:     await page.goto(`${base}/museum?cinematic=1`, { waitUntil: "networkidle0" });
  193:     await delay(500);
  194:     assert.equal(await page.$(".museum-root.is-cinematic"), null, "no WebGL means the DOM tier");
  195:     assert.equal(await page.$(".museum-webgl canvas"), null, "no WebGL renders no canvas");
  196:     assert.ok(await page.$eval(".museum-name", (el) => el.textContent.includes("YERIEL")), "DOM content intact without WebGL");
  197:     assert.deepEqual(errors.filter((e) => !isGlError(e)), [], "no unexpected errors without WebGL");
  198:     await page.close();
  199:   } finally {
  200:     await noGl.close();
  201:   }
  202: 
  203:   console.log("museum webgl tests ok");
  204: } finally {
  205:   // Kill the whole server tree. On Windows, cmd.exe does not forward kill() to the npm and next children.
  206:   if (process.platform === "win32") spawnSync("taskkill", ["/pid", String(child.pid), "/T", "/F"], { stdio: "ignore" });
  207:   else child.kill();
  208: }

