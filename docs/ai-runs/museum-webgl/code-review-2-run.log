   46:       formData.append('locationName', state.locationName);
   47:       formData.append('eventName', state.eventName);
   48:       formData.append('mediaLink', state.mediaLink);
   49:       formData.append('mediaConsent', state.mediaConsent ? 'on' : '');
   50: 
   51:       state.mediaFiles.forEach((file) => {
   52:         formData.append('media', file);
   53:       });
   54: 
   55:       await submitMemoryAction(formData);
   56:     } catch (err: any) {
   57:       setError(err.message || 'An error occurred. Please try again.');
   58:       setIsSubmitting(false);
   59:     }
   60:   };
   61: 
   62:   return (
   63:     <div className="memory-shell">
