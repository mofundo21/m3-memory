  184:                       >
  185:                         Remove
  186:                       </button>
  187:                     </div>
  188:                   ))}
  189:                 </div>
  190:               </div>
  191:             )}
  192:           </div>
  193: 
  194:           <div className="field" style={{ marginTop: '24px' }}>
  195:             <label htmlFor="mediaLink">Link to a photo or video?</label>
  196:             <input
  197:               type="url"
  198:               id="mediaLink"
  199:               name="mediaLink"
  200:               value={state.mediaLink}
  201:               onChange={(e) => updateField('mediaLink', e.target.value)}
  202:               placeholder="https://..."
  203:               className="field-input"
  204:             />
  205:           </div>
  206: 
  207:           {state.mediaFiles.length > 0 || state.mediaLink && (
  208:             <label className="checkline">
  209:               <input
  210:                 type="checkbox"
  211:                 checked={state.mediaConsent}
  212:                 onChange={(e) => updateField('mediaConsent', e.target.checked)}
  213:               />
  214:               <span>You agree that I can use this in the book</span>
  215:             </label>
  216:           )}
  217: 
  218:           <div style={{ marginTop: '32px' }}>
  219:             <button
  220:               type="submit"
  221:               disabled={isSubmitting}
  222:               className="primary-action"
  223:             >
  224:               One Last Thing â†’
  225:             </button>
  226:           </div>
  227:         </form>
  228:       </div>
  229:     </div>
  230:   );
  231: }

