  100:     /** True once the join beat has begun: the CTA is reachable. */
  101:     active: boolean;
  102:     countersOpacity: number;
  103:     counterOpacity: number[];
  104:     lineOpacity: number[];
  105:     joinOpacity: number;
  106:     ctaOpacity: number;
  107:   };
  108: }
  109: 
  110: /** Progress at which the join beat is considered reached (midpoint of its fade-in). */
  111: export const JOIN_ACTIVE_AT = (MUSEUM_BEATS.join.joinIn[0] + MUSEUM_BEATS.join.joinIn[1]) / 2;
  112: 
  113: /**
  114:  * Evaluate the whole museum at one scroll position.
  115:  * With reduced motion, every reveal is a hard switch at its start point:
  116:  * no camera travel, no crossfades, and no overlapping groups.
  117:  */
  118: export function evaluateMuseumFrame(input: MuseumFrameInput): MuseumFrame {
  119:   const { progress: p, reducedMotion: rm, counterCount } = input;
  120:   const { yeriel, mofundo, rememberHim, join } = MUSEUM_BEATS;
  121: 
  122:   /** Amount an element has appeared, 0..1. */
  123:   const fadeIn = (from: number, to: number) => (rm ? (p >= from ? 1 : 0) : within(p, from, to));
  124:   /** Amount an element has faded out, 0..1. Reduced motion switches out at the start point. */
  125:   const fadeOut = (from: number, to: number) => (rm ? (p >= from ? 1 : 0) : within(p, from, to));
  126: 
  127:   const sceneIds = MUSEUM_SCENES.map((s) => s.id);
  128:   const sceneOpacityMap = {} as Record<MuseumSceneId, number>;
  129:   const sceneNearMap = {} as Record<MuseumSceneId, boolean>;
  130:   for (const id of sceneIds) {
  131:     sceneOpacityMap[id] = rm ? (sceneActive(id, p) as number) : sceneOpacity(id, p);
  132:     sceneNearMap[id] = sceneNear(id, p);
  133:   }
  134: 
  135:   const plates = (
  136:     defs: typeof SCENE_TWO_PLATES,
  137:     plateIn: (i: number) => readonly [number, number],
  138:     opts: { depthScale: boolean; maxOpacity: number }
  139:   ): PlateFrame[] =>
  140:     defs.map((plate, i) => ({
  141:       dx: rm ? 0 : (plate.drift ?? 0) * within(p, ...mofundo.drift),
  142:       opacity: fadeIn(...plateIn(i)) * opts.maxOpacity,
  143:       scale: opts.depthScale && !rm ? plate.depth ?? 1 : 1,
  144:     }));
  145: 
  146:   const enterOpacity = clamp01(1 - p / ENTER_PROGRESS);
  147:   const joinActive = p >= JOIN_ACTIVE_AT;
  148: 
  149:   const counterOpacity = Array.from({ length: counterCount }, (_, i) =>
  150:     fadeIn(join.countersIn[0] + i * join.counterStagger, join.countersIn[1] + i * join.counterStagger)
  151:   );
  152: 
  153:   const lineOpacity = MUSEUM_BEATS.join.lineStarts.map((start, i, all) => {
  154:     const next = all[i + 1] ?? join.joinIn[0];
  155:     return fadeIn(start, start + 0.02) * (1 - fadeOut(next, next + 0.02));
  156:   });
  157: 
  158:   return {
  159:     progress: p,
  160:     reducedMotion: rm,
  161:     camera: rm ? { zoom: 1, x: 0 } : cameraAt(p),
