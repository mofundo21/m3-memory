    1: 'use client';
    2: 
    3: /**
    4:  * Cinematic layer for the museum, Scenes 01 and 02 only: YERIEL â†’ MOFUNDO.
    5:  *
    6:  * One persistent canvas. Every value comes from the shared MuseumFrame (src/lib/museumTimeline.ts);
    7:  * this file does not derive any timing. The canvas is decorative: it is aria-hidden, holds no
    8:  * controls, and carries no information the DOM text does not also carry.
    9:  *
   10:  * Rendering is on demand: the scene redraws only when the frame changes, so an idle page costs nothing.
   11:  * Context loss, texture failure, or a thrown error calls onFail, and the page drops to the DOM tier.
   12:  */
   13: 
   14: import { Component, useEffect, useMemo, useRef, useState, type ReactNode } from 'react';
   15: import * as THREE from 'three';
   16: import { Canvas, useThree } from '@react-three/fiber';
   17: import { getMuseumAsset } from '@/lib/museumAssets';
   18: import { MUSEUM_SCENES, SCENE_TWO_PLATES } from '@/lib/museumConfig';
   19: import type { MuseumFrame } from '@/lib/museumTimeline';
   20: 
   21: /** Dust budget for the desktop tier (design: â‰¤ 300). */
   22: export const DUST_COUNT = 300;
   23: 
   24: const FOV = 35;
   25: /** Layout is authored at this distance, so the camera can travel toward and past the plates. */
   26: const REF_DIST = 6;
   27: /** Plate height over width, used until a real photograph reports its own ratio. */
   28: const PLATE_ASPECT = 1.25;
   29: 
   30: const TEXTURE_IDS = ['portrait', 'photo-01', 'photo-02', 'photo-03'] as const;
   31: 
   32: const DISSOLVE_VERT = /* glsl */ `
   33:   varying vec2 vUv;
   34:   void main() {
   35:     vUv = uv;
   36:     gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
   37:   }
   38: `;
   39: 
   40: const DISSOLVE_FRAG = /* glsl */ `
   41:   uniform sampler2D uA;
   42:   uniform sampler2D uB;
   43:   uniform float uMix;
   44:   uniform float uOpacity;
   45:   varying vec2 vUv;
   46: 
   47:   float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
   48:   float noise(vec2 p) {
   49:     vec2 i = floor(p);
   50:     vec2 f = fract(p);
   51:     f = f * f * (3.0 - 2.0 * f);
   52:     float a = hash(i);
   53:     float b = hash(i + vec2(1.0, 0.0));
   54:     float c = hash(i + vec2(0.0, 1.0));
   55:     float d = hash(i + vec2(1.0, 1.0));
   56:     return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
   57:   }
   58: 
   59:   void main() {
   60:     vec4 a = texture2D(uA, vUv);
   61:     vec4 b = texture2D(uB, vUv);
   62:     float n = noise(vUv * 12.0) * 0.6 + noise(vUv * 31.0) * 0.4;
   63:     // Threshold sweeps from below the noise range (shows A) to above it (shows B).
   64:     float th = uMix * 1.1 - 0.05;
   65:     float showB = 1.0 - smoothstep(th - 0.04, th + 0.04, n);
   66:     // A thin warm rim on the dissolve front, so the change reads as material, not a cut.
   67:     float rim = smoothstep(th - 0.04, th + 0.04, n) * (1.0 - smoothstep(th + 0.04, th + 0.10, n));
   68:     vec3 color = mix(a.rgb, b.rgb, showB) + vec3(0.55, 0.42, 0.22) * rim * 0.6;
   69:     gl_FragColor = vec4(color, uOpacity);
   70:   }
   71: `;
   72: 
   73: interface Textures {
   74:   portrait: THREE.Texture;
   75:   photo01: THREE.Texture;
   76:   photo02: THREE.Texture;
   77:   photo03: THREE.Texture;
   78: }
   79: 
   80: /** Plate texture size. Plates are 4:5 portrait, like the placeholders and the recommended photo crop. */
   81: const PLATE_TEX_W = 800;
   82: const PLATE_TEX_H = 1000;
   83: 
   84: /**
   85:  * Decode an image and draw it, cover-fit, into a fixed-size canvas. Images without intrinsic size
   86:  * (the placeholder SVGs) upload to WebGL as empty textures when passed straight to TextureLoader,
   87:  * so this step is required for them to render. Real photographs use the same path.
   88:  */
   89: async function loadPlateTexture(src: string): Promise<THREE.Texture> {
   90:   const img = new Image();
   91:   img.decoding = 'async';
   92:   img.src = src;
   93:   await img.decode();
   94: 
   95:   const canvas = document.createElement('canvas');
   96:   canvas.width = PLATE_TEX_W;
   97:   canvas.height = PLATE_TEX_H;
   98:   const ctx = canvas.getContext('2d');
   99:   if (!ctx) throw new Error('2D canvas unavailable');
  100: 
  101:   const srcW = img.naturalWidth || PLATE_TEX_W;
  102:   const srcH = img.naturalHeight || PLATE_TEX_H;
  103:   const scale = Math.max(PLATE_TEX_W / srcW, PLATE_TEX_H / srcH);
  104:   const dw = srcW * scale;
  105:   const dh = srcH * scale;
  106:   ctx.drawImage(img, (PLATE_TEX_W - dw) / 2, (PLATE_TEX_H - dh) / 2, dw, dh);
  107: 
  108:   const tex = new THREE.CanvasTexture(canvas);
  109:   tex.colorSpace = THREE.SRGBColorSpace;
  110:   tex.needsUpdate = true;
  111:   return tex;
  112: }
  113: 
  114: /** Load the placeholder plates once. Disposed on unmount. */
  115: function useTextures(onFail: () => void): Textures | null {
  116:   const [textures, setTextures] = useState<Textures | null>(null);
  117:   const onFailRef = useRef(onFail);
  118:   onFailRef.current = onFail;
  119: 
  120:   useEffect(() => {
  121:     let live = true;
  122:     const load = (id: (typeof TEXTURE_IDS)[number]) => loadPlateTexture(getMuseumAsset(id).src);
  123: 
  124:     // allSettled keeps the order and lets us dispose every texture that did load, even if another one failed.
  125:     Promise.allSettled(TEXTURE_IDS.map(load)).then((results) => {
  126:       const loaded = results.flatMap((r) => (r.status === 'fulfilled' ? [r.value] : []));
  127:       const allLoaded = loaded.length === TEXTURE_IDS.length;
  128:       if (!live || !allLoaded) {
  129:         loaded.forEach((t) => t.dispose());
  130:         if (live) onFailRef.current();
  131:         return;
  132:       }
  133:       const [portrait, photo01, photo02, photo03] = loaded;
  134:       setTextures({ portrait, photo01, photo02, photo03 });
  135:     });
  136: 
  137:     return () => {
  138:       live = false;
  139:     };
  140:   }, []);
  141: 
  142:   // Dispose the textures this hook created when the component unmounts.
  143:   useEffect(() => {
  144:     return () => {
  145:       if (!textures) return;
  146:       Object.values(textures).forEach((t) => t.dispose());
  147:     };
  148:   }, [textures]);
  149: 
  150:   return textures;
  151: }
  152: 
  153: /** Stage geometry at the reference distance, in world units. */
  154: function stageAt(aspect: number) {
  155:   const halfH = Math.tan(THREE.MathUtils.degToRad(FOV / 2)) * REF_DIST;
  156:   return { halfH, halfW: halfH * aspect };
  157: }
  158: 
  159: function CameraRig({ frame }: { frame: MuseumFrame }) {
  160:   const camera = useThree((s) => s.camera) as THREE.PerspectiveCamera;
  161:   const invalidate = useThree((s) => s.invalidate);
  162:   const aspect = useThree((s) => s.size.width / Math.max(1, s.size.height));
  163: 
  164:   useEffect(() => {
  165:     const { halfW } = stageAt(aspect);
  166:     // Zoom is dolly: a larger zoom moves the camera closer, so the planes travel toward the viewer.
  167:     // Cubed zoom: the shared keyframes move only ~20%, so the depth travel is amplified here. This changes
  168:     // how the renderer reads the same frame value, not the timing, which still comes only from the evaluator.
  169:     const dist = REF_DIST / Math.pow(frame.camera.zoom, 3);
  170:     // Lateral drift is a percentage of the stage width at the current distance.
  171:     const panX = (frame.camera.x / 100) * 2 * halfW * (dist / REF_DIST);
  172:     camera.position.set(panX, 0, dist);
  173:     camera.lookAt(panX, 0, 0);
  174:     camera.updateProjectionMatrix();
  175:     invalidate();
  176:   }, [frame.camera.zoom, frame.camera.x, aspect, camera, invalidate]);
  177: 
  178:   return null;
  179: }
  180: 
  181: function Scene({ frame, textures }: { frame: MuseumFrame; textures: Textures }) {
  182:   const aspect = useThree((s) => s.size.width / Math.max(1, s.size.height));
  183:   const invalidate = useThree((s) => s.invalidate);
  184:   const { halfH, halfW } = stageAt(aspect);
  185: 
  186:   const dissolveRef = useRef<THREE.ShaderMaterial>(null);
  187: 
  188:   // The dissolve follows the shared transition. Before the boundary it shows the portrait; after, the photograph.
  189:   const boundary = MUSEUM_SCENES[1].start;
  190:   const transition = frame.scenes.transition;
  191:   const mix =
  192:     transition?.from === 'yeriel' ? transition.amount : frame.progress >= boundary ? 1 : 0;
  193: 
  194:   const heroOpacity =
  195:     Math.max(frame.scenes.opacity.yeriel, frame.scenes.opacity.mofundo) * (1 - frame.scenes.opacity['remember-him']);
  196: 
  197:   const dust = useMemo(() => {
  198:     const positions = new Float32Array(DUST_COUNT * 3);
  199:     // Deterministic scatter so the frame is reproducible across renders and screenshots.
  200:     let seed = 1337;
  201:     const rand = () => {
  202:       seed = (seed * 16807) % 2147483647;
  203:       return seed / 2147483647;
  204:     };
  205:     for (let i = 0; i < DUST_COUNT; i += 1) {
  206:       positions[i * 3] = (rand() * 2 - 1) * halfW * 0.9;
  207:       positions[i * 3 + 1] = (rand() * 2 - 1) * halfH * 0.9;
  208:       positions[i * 3 + 2] = -1.5 + rand() * 3;
  209:     }
  210:     const geo = new THREE.BufferGeometry();
  211:     geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  212:     return geo;
  213:   }, [halfH, halfW]);
  214: 
  215:   useEffect(() => () => dust.dispose(), [dust]);
  216: 
  217:   useEffect(() => {
  218:     const material = dissolveRef.current;
  219:     if (material) {
  220:       material.uniforms.uMix.value = mix;
  221:       material.uniforms.uOpacity.value = heroOpacity;
  222:     }
  223:     invalidate();
  224:   }, [mix, heroOpacity, invalidate, frame]);
  225: 
  226:   const dissolveUniforms = useMemo(
  227:     () => ({
  228:       uA: { value: textures.portrait },
  229:       uB: { value: textures.photo01 },
  230:       uMix: { value: 0 },
  231:       uOpacity: { value: 1 },
  232:     }),
  233:     [textures]
  234:   );
  235: 
  236:   const heroHeight = halfH * 1.7;
  237:   const heroWidth = heroHeight / PLATE_ASPECT;
  238: 
  239:   const dustOpacity = Math.min(1, Math.max(frame.scenes.opacity.yeriel, frame.scenes.opacity.mofundo)) * 0.55;
  240: 
  241:   return (
  242:     <group>
  243:       {/* The portrait plate. It persists through the transition: its pixels become the photograph. */}
  244:       <mesh position={[0, -halfH * 0.04, 0]} renderOrder={2}>
  245:         <planeGeometry args={[heroWidth, heroHeight]} />
  246:         <shaderMaterial
  247:           ref={dissolveRef}
  248:           vertexShader={DISSOLVE_VERT}
  249:           fragmentShader={DISSOLVE_FRAG}
  250:           uniforms={dissolveUniforms}
  251:           transparent
  252:           depthWrite={false}
  253:         />
  254:       </mesh>
  255: 
  256:       {/* Scene 02 plates: depth layers the camera travels past. */}
  257:       {SCENE_TWO_PLATES.map((plate, i) => {
  258:         const tex = [textures.photo01, textures.photo02, textures.photo03][i];
  259:         const f = frame.mofundo.plates[i];
  260:         const widthPct = plate.width;
  261:         const leftPct = plate.left + f.dx;
  262:         const topPct = plate.top;
  263:         const w = (widthPct / 100) * 2 * halfW;
  264:         const h = w / PLATE_ASPECT;
  265:         const x = ((leftPct + widthPct / 2) / 100) * 2 * halfW - halfW;
  266:         const y = halfH - (topPct / 100) * 2 * halfH - h / 2;
  267:         // Depth layers spread apart, so the camera dollying in passes them at different speeds.
  268:         const z = -1.5 - i * 1.6;
  269:         return (
  270:           <mesh key={plate.id} position={[x, y, z]} renderOrder={1}>
  271:             <planeGeometry args={[w, h]} />
  272:             <meshBasicMaterial map={tex} transparent opacity={f.opacity * heroOpacity} depthWrite={false} />
  273:           </mesh>
  274:         );
  275:       })}
  276: 
  277:       {/* Dust in the beam: at most DUST_COUNT points. Carries through into Scene 02. */}
  278:       <points geometry={dust} renderOrder={3}>
  279:         <pointsMaterial color="#e9dcc4" size={0.025} sizeAttenuation transparent opacity={dustOpacity} depthWrite={false} />
  280:       </points>
  281:     </group>
  282:   );
  283: }
  284: 
  285: /** Redraws when the frame changes, and releases its GPU resources on unmount. */
  286: function FrameBridge({ frame }: { frame: MuseumFrame }) {
  287:   const invalidate = useThree((s) => s.invalidate);
  288:   useEffect(() => {
  289:     invalidate();
  290:   }, [frame, invalidate]);
  291:   return null;
  292: }
  293: 
  294: interface MuseumWebGLProps {
  295:   frame: MuseumFrame;
  296:   onFail: () => void;
  297: }
  298: 
  299: /** Catches a renderer that throws during creation, so the page can drop to the DOM tier. */
  300: class RendererBoundary extends Component<{ onFail: () => void; children: ReactNode }, { failed: boolean }> {
  301:   state = { failed: false };
  302:   static getDerivedStateFromError() {
  303:     return { failed: true };
  304:   }
  305:   componentDidCatch() {
  306:     this.props.onFail();
  307:   }
  308:   render() {
  309:     return this.state.failed ? null : this.props.children;
  310:   }
  311: }
  312: 
  313: function MuseumWebGLInner({ frame, onFail }: { frame: MuseumFrame; onFail: () => void }) {
  314:   const textures = useTextures(onFail);
  315:   if (!textures) return null;
  316:   return (
  317:     <>
  318:       <CameraRig frame={frame} />
  319:       <FrameBridge frame={frame} />
  320:       <Scene frame={frame} textures={textures} />
  321:     </>
  322:   );
  323: }
  324: 
  325: export default function MuseumWebGL({ frame, onFail }: MuseumWebGLProps) {
  326:   return (
  327:     <div className="museum-webgl" aria-hidden="true">
  328:       <RendererBoundary onFail={onFail}>
  329:         <Canvas
  330:           frameloop="demand"
  331:           dpr={[1, 1.5]}
  332:           gl={{ antialias: false, alpha: true, powerPreference: 'low-power' }}
  333:           camera={{ fov: FOV, near: 0.1, far: 50, position: [0, 0, REF_DIST] }}
  334:           onCreated={({ gl }) => {
  335:             gl.domElement.addEventListener(
  336:               'webglcontextlost',
  337:               (event) => {
  338:                 event.preventDefault();
  339:                 onFail();
  340:               },
  341:               { once: true }
  342:             );
  343:           }}
  344:         >
  345:           <MuseumWebGLInner frame={frame} onFail={onFail} />
  346:         </Canvas>
  347:       </RendererBoundary>
  348:     </div>
  349:   );
  350: }

### src/lib/museumCapability.ts
    1: /**
    2:  * Museum rendering tier. Decided once, on the client, after mount.
    3:  *
    4:  * - `cinematic`: the WebGL canvas renders Scenes 01 and 02. Text, controls and the
    5:  *   accessibility layer are always the DOM.
    6:  * - `dom`: the existing DOM/CSS sequence, with no canvas and no renderer code loaded.
    7:  *
    8:  * Reduced motion always resolves to `dom`. A lost WebGL context drops to `dom` and does
    9:  * not retry automatically. This module is pure so the decision can be tested without a browser.
   10:  */
   11: 
   12: export type MuseumTier = 'cinematic' | 'dom';
   13: 
   14: export interface MuseumCapabilityInput {
   15:   /** The cinematic experiment is opt-in (`?cinematic=1`) until it passes its success criteria. */
   16:   optedIn: boolean;
   17:   reducedMotion: boolean;
   18:   /** Whether a WebGL2 context can be created in this browser. */
   19:   webgl2: boolean;
   20:   /** Set once a context loss or creation failure has been observed. Sticky for the page visit. */
   21:   contextFailed: boolean;
   22: }
   23: 
   24: export function decideMuseumTier(input: MuseumCapabilityInput): MuseumTier {
   25:   if (!input.optedIn) return 'dom';
   26:   if (input.reducedMotion) return 'dom';
   27:   if (!input.webgl2) return 'dom';
   28:   if (input.contextFailed) return 'dom';
   29:   return 'cinematic';
   30: }
   31: 
   32: /**
   33:  * Whether this browser can create a WebGL2 context. Browser-only; returns false on the
   34:  * server and on any exception, so the caller falls back to the DOM tier.
   35:  */
   36: export function detectWebGL2(): boolean {
   37:   if (typeof document === 'undefined') return false;
   38:   try {
   39:     const canvas = document.createElement('canvas');
   40:     const gl = canvas.getContext('webgl2');
   41:     if (!gl) return false;
   42:     // Release the probe context immediately; the renderer creates its own.
   43:     const loseContext = gl.getExtension('WEBGL_lose_context');
   44:     loseContext?.loseContext();
   45:     return true;
   46:   } catch {
   47:     return false;
   48:   }
   49: }

