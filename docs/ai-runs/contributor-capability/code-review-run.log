   17: 
   18: export const CONTRIBUTOR_CAPABILITY_TTL_SECONDS = 2 * 60 * 60;
   19: 
   20: /** The one public error for every failure. Internal detail is never interpolated into it. */
   21: export const CONTRIBUTOR_ERROR_MESSAGE = "Preferences could not be saved. Please start again from the beginning.";
   22: 
   23: const CANONICAL_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
   24: const TOKEN_SHAPE = /^[A-Za-z0-9_-]{43}$/;
   25: const ATTRIBUTION_CHOICES = new Set(["anonymous", "first_name", "full_name", "custom"]);
   26: 
   27: export interface ContributorPreferences {
   28:   attributionPreference: string;
   29:   preferredAttribution: string | null;
   30:   bookNote: string | null;
   31:   finalNotes: string | null;
   32: }
   33: 
   34: /** Category-only server log. Never logs a token, a hash, a cookie value, a body, or a backend message. */
   35: export function logContributorEvent(category: "issue-failed" | "compensation-failed" | "redeem-rejected" | "backend-error") {
   36:   console.warn(`[contributor-capability] ${category}`);
   37: }
   38: 
   39: export function isCanonicalSubmissionId(value: unknown): value is string {
   40:   return typeof value === "string" && CANONICAL_ID.test(value);
   41: }
   42: 
   43: export function cookieNameFor(submissionId: string) {
   44:   if (!isCanonicalSubmissionId(submissionId)) throw new Error("INVALID_SUBMISSION_ID");
   45:   return `m3_contrib_${submissionId}`;
   46: }
   47: 
   48: export function cookieOptions(maxAge = CONTRIBUTOR_CAPABILITY_TTL_SECONDS) {
   49:   return {
   50:     httpOnly: true,
   51:     sameSite: "strict" as const,
   52:     secure: process.env.NODE_ENV === "production",
   53:     path: "/remember",
   54:     maxAge
   55:   };
   56: }
   57: 
   58: /** 256 bits from the OS CSPRNG, unpadded base64url: exactly 43 characters. */
   59: export function generateToken() {
   60:   return randomBytes(32).toString("base64url");
   61: }
   62: 
   63: export function hashToken(token: string) {
   64:   return createHash("sha256").update(token).digest("hex");
   65: }
   66: 
   67: export function formatCookieValue(submissionId: string, token: string) {
   68:   return `${submissionId}.${token}`;
   69: }
   70: 
   71: /** Strict shape check before anything else. Returns null for every malformed value. */
   72: export function parseCookieValue(value: string | undefined): { submissionId: string; token: string } | null {
   73:   if (typeof value !== "string" || value.length !== 36 + 1 + 43) return null;
   74:   const submissionId = value.slice(0, 36);
   75:   const token = value.slice(37);
   76:   if (value[36] !== ".") return null;
   77:   if (!isCanonicalSubmissionId(submissionId) || !TOKEN_SHAPE.test(token)) return null;
   78:   return { submissionId, token };
   79: }
   80: 
   81: /** Issue a capability for a just-created submission. Returns the raw token (for the cookie only). */
   82: export async function issueCapability(submissionId: string, now: Date) {
   83:   const token = generateToken();
   84:   const expiresAt = new Date(now.getTime() + CONTRIBUTOR_CAPABILITY_TTL_SECONDS * 1000).toISOString();
   85:   await storeContributorCapability(submissionId, hashToken(token), expiresAt);
   86:   return token;
   87: }
   88: 
   89: /**
