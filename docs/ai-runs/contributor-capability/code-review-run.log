    1: -- M3 Memory V0.1 production Supabase schema.
    2: -- Apply only to a new empty Supabase project. Do not import old memories or lore.
    3: 
    4: create extension if not exists pgcrypto;
    5: 
    6: create table if not exists public.m3_admins (
    7:   id uuid primary key default gen_random_uuid(),
    8:   user_id uuid unique,
    9:   email text unique,
   10:   created_at timestamptz not null default now(),
   11:   check (user_id is not null or email is not null)
   12: );
   13: 
   14: create table if not exists public.persons (
   15:   id uuid primary key default gen_random_uuid(),
   16:   display_name text not null,
   17:   contact text,
   18:   created_at timestamptz not null default now()
   19: );
   20: 
   21: create table if not exists public.submissions (
   22:   id uuid primary key default gen_random_uuid(),
   23:   submitter_person_id uuid references public.persons(id),
   24:   original_json jsonb not null,
   25:   memory_preview text not null,
   26:   encounter_date text,
   27:   is_approximate_date boolean not null default false,
   28:   location_name text,
   29:   city text,
   30:   region text,
   31:   country text,
   32:   event_name text,
   33:   media_link text,
   34:   media_consent boolean not null default false,
   35:   attribution_preference text default 'anonymous',
   36:   preferred_attribution text,
   37:   book_note text,
   38:   final_notes text,
   39:   status text not null default 'UNREVIEWED' check (status in ('UNREVIEWED', 'IN_REVIEW', 'REVIEWED', 'APPROVED_FOR_STORY', 'REJECTED', 'ARCHIVED')),
   40:   created_at timestamptz not null default now(),
   41:   updated_at timestamptz not null default now()
   42: );
   43: 
   44: create table if not exists public.reviews (
   45:   id uuid primary key default gen_random_uuid(),
   46:   submission_id uuid not null unique references public.submissions(id) on delete cascade,
   47:   notes text,
   48:   remembered text,
   49:   corrections text,
   50:   context text,
   51:   people text,
   52:   tags text,
   53:   importance integer check (importance between 1 and 5),
   54:   emotional_significance integer check (emotional_significance between 1 and 5),
   55:   historical_significance integer check (historical_significance between 1 and 5),
   56:   accuracy_confidence integer check (accuracy_confidence between 1 and 5),
   57:   book_potential integer check (book_potential between 1 and 5),
   58:   chapter_category text,
   59:   private_notes text,
   60:   created_at timestamptz not null default now(),
   61:   updated_at timestamptz not null default now()
   62: );
   63: 
   64: create table if not exists public.media (
   65:   id uuid primary key default gen_random_uuid(),
   66:   submission_id uuid not null references public.submissions(id) on delete cascade,
   67:   file_name text not null,
   68:   mime_type text not null,
   69:   storage_path text not null,
   70:   size_bytes bigint not null,
   71:   created_at timestamptz not null default now()
   72: );
   73: 
   74: create table if not exists public.artifacts (
   75:   id uuid primary key default gen_random_uuid(),
   76:   submission_id uuid not null references public.submissions(id) on delete cascade,
   77:   label text not null,
   78:   notes text,
   79:   created_at timestamptz not null default now()
   80: );
   81: 
   82: create table if not exists public.story_drafts (
   83:   id uuid primary key default gen_random_uuid(),
   84:   submission_id uuid not null references public.submissions(id) on delete cascade,
   85:   label text not null default 'AI-GENERATED DRAFT',
   86:   draft_text text not null,
   87:   approved_at timestamptz,
   88:   created_at timestamptz not null default now()
   89: );
   90: 
   91: create index if not exists idx_m3_admins_user_id on public.m3_admins(user_id);
   92: create index if not exists idx_m3_admins_email on public.m3_admins(email);
   93: create index if not exists idx_submissions_status on public.submissions(status);
   94: create index if not exists idx_submissions_created_at on public.submissions(created_at desc);
   95: create index if not exists idx_reviews_submission_id on public.reviews(submission_id);
   96: 
   97: create or replace function public.is_m3_admin()
   98: returns boolean
   99: language sql
  100: security definer
  101: set search_path = public
  102: as $$
  103:   select exists (
  104:     select 1
  105:     from public.m3_admins
  106:     where user_id = auth.uid()
  107:        or lower(email) = lower(auth.jwt()->>'email')
  108:   );
  109: $$;
  110: 
  111: create or replace function public.trigger_update_updated_at()
  112: returns trigger
  113: language plpgsql
  114: set search_path = public
  115: as $$
  116: begin
  117:   new.updated_at = now();
  118:   return new;
  119: end;
  120: $$;
  121: 
  122: drop trigger if exists update_submissions_updated_at on public.submissions;
  123: create trigger update_submissions_updated_at
  124: before update on public.submissions
  125: for each row execute function public.trigger_update_updated_at();
  126: 
  127: drop trigger if exists update_reviews_updated_at on public.reviews;
  128: create trigger update_reviews_updated_at
  129: before update on public.reviews
  130: for each row execute function public.trigger_update_updated_at();
  131: 
  132: alter table public.m3_admins enable row level security;
  133: alter table public.persons enable row level security;
  134: alter table public.submissions enable row level security;
  135: alter table public.reviews enable row level security;
  136: alter table public.media enable row level security;
  137: alter table public.artifacts enable row level security;
  138: alter table public.story_drafts enable row level security;
  139: 
  140: revoke all on public.m3_admins from anon, authenticated;
  141: revoke all on public.persons from anon, authenticated;
  142: revoke all on public.submissions from anon, authenticated;
  143: revoke all on public.reviews from anon, authenticated;
  144: revoke all on public.media from anon, authenticated;
  145: revoke all on public.artifacts from anon, authenticated;
  146: revoke all on public.story_drafts from anon, authenticated;
  147: 
  148: grant select on public.m3_admins to authenticated;
  149: grant select on public.persons to authenticated;
  150: grant select on public.submissions to authenticated;
  151: grant update(status, updated_at) on public.submissions to authenticated;
  152: grant insert, select on public.reviews to authenticated;
  153: grant update(
  154:   notes,
  155:   remembered,
  156:   corrections,
  157:   context,
  158:   people,
  159:   tags,
  160:   importance,
  161:   emotional_significance,
  162:   historical_significance,
  163:   accuracy_confidence,
  164:   book_potential,
  165:   chapter_category,
  166:   private_notes,
  167:   updated_at
  168: ) on public.reviews to authenticated;
  169: grant insert, select, update on public.story_drafts to authenticated;
  170: 
  171: create policy admin_read_allowlist on public.m3_admins
  172: for select to authenticated
  173: using (public.is_m3_admin());
  174: 
  175: create policy admin_read_persons on public.persons
  176: for select to authenticated
  177: using (public.is_m3_admin());
  178: 
  179: create policy admin_read_submissions on public.submissions
  180: for select to authenticated
  181: using (public.is_m3_admin());
  182: 
  183: create policy admin_update_submission_status on public.submissions
  184: for update to authenticated
  185: using (public.is_m3_admin())
  186: with check (public.is_m3_admin());
  187: 
  188: create policy admin_read_reviews on public.reviews
  189: for select to authenticated
  190: using (public.is_m3_admin());
  191: 
  192: create policy admin_insert_reviews on public.reviews
  193: for insert to authenticated
  194: with check (public.is_m3_admin());
  195: 
  196: create policy admin_update_reviews on public.reviews
  197: for update to authenticated
  198: using (public.is_m3_admin())
  199: with check (public.is_m3_admin());
  200: 
  201: create policy admin_read_story_drafts on public.story_drafts
  202: for select to authenticated
  203: using (public.is_m3_admin());
  204: 
  205: create policy admin_insert_story_drafts on public.story_drafts
  206: for insert to authenticated
  207: with check (public.is_m3_admin());
  208: 
  209: create policy admin_update_story_drafts on public.story_drafts
  210: for update to authenticated
  211: using (public.is_m3_admin())
  212: with check (public.is_m3_admin());
  213: 
  214: create policy admin_read_media on public.media
  215: for select to authenticated
  216: using (public.is_m3_admin());
  217: 
  218: -- No anon policies are created. Public submissions and media are inserted only through the
  219: -- Next.js server path with SUPABASE_SERVICE_ROLE_KEY (which bypasses RLS). Media and story drafts are admin-only
  220: -- and never accessible to anonymous or non-admin authenticated users. Media table defaults to default-deny
  221: -- (RLS enabled, no insert/update/delete grants to any role, insert through service role only).
  222: 
  223: -- ---------------------------------------------------------------------------------------------------------------
  224: -- Contributor write capability (docs/MUSEUM_CONTRIBUTOR_CAPABILITY_DESIGN.md). One row per submission with an open
  225: -- contributor window. Stores SHA-256(token) only, never the raw token. Readable and writable only by the service
  226: -- role, which the server uses from two narrow helpers. No policy and no grant exists for anon or authenticated.
  227: -- ---------------------------------------------------------------------------------------------------------------
  228: create table if not exists public.contributor_capabilities (
  229:   submission_id uuid primary key,
  230:   token_hash text not null,
  231:   expires_at timestamptz not null,
  232:   created_at timestamptz not null default now()
  233: );
  234: 
  235: create index if not exists contributor_capabilities_expires_idx on public.contributor_capabilities (expires_at);
  236: 
  237: alter table public.contributor_capabilities enable row level security;
  238: revoke all on public.contributor_capabilities from anon, authenticated;
  239: -- Deliberately no policies: no application role other than the server's service key may read or write this table.
  240: 
  241: -- Scheduled cleanup (open decision: scheduler). Removes expired capabilities and contributor person rows that no
  242: -- submission references. The 2-hour guard protects a person row that another request is creating right now.
  243: -- Executable only by the database owner or the service role, never by anon or authenticated.
  244: create or replace function public.contributor_purge_expired()
  245: returns integer
  246: language plpgsql
  247: security definer
  248: set search_path = public
  249: as $$
  250: declare
  251:   removed_capabilities integer := 0;
  252:   removed_people integer := 0;
  253: begin
  254:   delete from public.contributor_capabilities where expires_at < now();
  255:   get diagnostics removed_capabilities = row_count;
  256: 
  257:   delete from public.persons p
  258:    where p.created_at < now() - interval '2 hours'
  259:      and not exists (select 1 from public.submissions s where s.submitter_person_id = p.id);
  260:   get diagnostics removed_people = row_count;
  261: 
  262:   return removed_capabilities + removed_people;
  263: end;
  264: $$;
  265: 
  266: revoke all on function public.contributor_purge_expired() from public, anon, authenticated;

### scripts/contributor-capability-tests.mjs
    1: import assert from "node:assert/strict";
    2: import { registerHooks } from "node:module";
    3: import { mkdtempSync, rmSync } from "node:fs";
    4: import { tmpdir } from "node:os";
    5: import { join } from "node:path";
    6: 
    7: // Pure and local-store tests for the contributor write capability (Design v3, final review PASS WITH REQUIRED CHANGES).
    8: const workDir = mkdtempSync(join(tmpdir(), "m3-capability-"));
    9: process.env.M3_PERSISTENCE = "sqlite";
   10: process.env.M3_ADMIN_AUTH = "local";
   11: process.env.DATABASE_PATH = join(workDir, "capability.sqlite");
   12: process.env.SESSION_SECRET = "fictional-capability-session-secret";
   13: process.env.NODE_ENV = "test";
   14: 
   15: registerHooks({
   16:   resolve(specifier, context, nextResolve) {
   17:     if (specifier === "server-only") return { url: "data:text/javascript,", shortCircuit: true };
   18:     // The app's lib files import siblings without an extension; strip-types needs the .ts file name.
   19:     if ((specifier.startsWith("./") || specifier.startsWith("../")) && !/\.[cm]?[jt]s$/.test(specifier)) {
   20:       return nextResolve(`${specifier}.ts`, context);
   21:     }
   22:     return nextResolve(specifier, context);
   23:   },
   24: });
   25: 
   26: const cap = await import("../src/lib/contributorCapability.ts");
   27: const db = await import("../src/lib/db.ts");
   28: 
   29: const SID = "3f2c1b8e-7a4d-4c9e-9b1a-5d6e7f8a9b0c";
   30: const OTHER = "8a7b6c5d-4e3f-4a2b-8c1d-9e0f1a2b3c4d";
   31: const prefs = { attributionPreference: "anonymous", preferredAttribution: null, bookNote: null, finalNotes: null };
   32: const now = new Date("2026-10-31T12:00:00Z");
   33: 
   34: /** A minimal, valid submission. Each call creates a new submission and a new person row. */
   35: function makeSubmission(label) {
   36:   return db.createSubmission({
   37:     submitterName: "Fictional Tester", contact: "", encounterDate: "", isApproximateDate: false, locationName: "",
   38:     city: "", region: "", country: "", eventName: "", howMet: "", memoryText: `Fictional memory for ${label}.`,
   39:     beforeText: "", afterText: "", metAgain: "", peoplePresent: "", yerielWearing: "", submitterWearing: "",
   40:     talkedAbout: "", exchanged: "", artifactInfo: "", forgottenPrompt: "", bookPagePrompt: "", additionalComments: "",
   41:     mediaLink: "", mediaConsent: false,
   42:   });
   43: }
   44: 
   45: try {
   46:   // 1. Token: 256 bits from the CSPRNG, unpadded base64url, exactly 43 characters, unique.
   47:   const tokens = new Set();
   48:   for (let i = 0; i < 2000; i += 1) {
   49:     const t = cap.generateToken();
   50:     assert.equal(t.length, 43, "token is 43 characters");
   51:     assert.match(t, /^[A-Za-z0-9_-]{43}$/, "token is unpadded base64url");
   52:     tokens.add(t);
   53:   }
   54:   assert.equal(tokens.size, 2000, "tokens do not repeat");
   55: 
   56:   // 2. Hash: SHA-256 hex; never the raw token.
   57:   const sample = cap.generateToken();
   58:   assert.match(cap.hashToken(sample), /^[0-9a-f]{64}$/, "stored value is SHA-256 hex");
   59:   assert.notEqual(cap.hashToken(sample), sample, "stored value is not the token");
   60: 
   61:   // 3. Cookie value: exactly <uuid>.<43 chars>. Every malformed shape is rejected without throwing.
   62:   const good = cap.formatCookieValue(SID, sample);
   63:   assert.deepEqual(cap.parseCookieValue(good), { submissionId: SID, token: sample }, "well-formed value parses");
   64:   const malformed = [
   65:     undefined, null, "", "x", good + "x", good.slice(0, -1), good.replace(".", "_"), `${SID}..${sample}`,
   66:     good.replace(SID, SID.toUpperCase()), good.replace(SID, "not-a-uuid-value-here-xxxxxxxxxxxxxx"),
   67:     `${SID}.${"+".repeat(43)}`, `${SID}.${"a".repeat(42)}`, `${SID}.${"a".repeat(44)}`, `${SID}.${sample}.extra`,
   68:   ];
   69:   for (const value of malformed) {
   70:     assert.equal(cap.parseCookieValue(value), null, `rejects ${JSON.stringify(value)}`);
   71:   }
   72: 
   73:   // 4. Cookie name is derived only from a canonical id.
   74:   assert.equal(cap.cookieNameFor(SID), `m3_contrib_${SID}`);
   75:   assert.throws(() => cap.cookieNameFor("../../etc"), /INVALID_SUBMISSION_ID/, "cookie name rejects path-like input");
   76: 
   77:   // 5. Cookie attributes: httpOnly, strict, scoped to /remember, two-hour lifetime; deletion keeps the same path.
   78:   const opts = cap.cookieOptions();
   79:   assert.equal(opts.httpOnly, true);
   80:   assert.equal(opts.sameSite, "strict");
   81:   assert.equal(opts.path, "/remember");
   82:   assert.equal(opts.maxAge, 7200);
   83:   assert.equal(cap.cookieOptions(0).path, "/remember", "deletion uses the same path");
   84:   assert.equal(cap.cookieOptions(0).maxAge, 0);
   85: 
   86:   // 6. Allowlist: only the four fields survive; unknown choices become anonymous; text is capped.
   87:   const dirty = cap.sanitizePreferences({
   88:     attributionPreference: "admin_override",
   89:     preferredAttribution: "x".repeat(300),
   90:     bookNote: "  note  ",
   91:     finalNotes: "",
   92:     status: "APPROVED_FOR_STORY",
   93:     original_json: "{}",
   94:     submitter_person_id: OTHER,
   95:     reviewer: "someone",
   96:   });
   97:   assert.deepEqual(Object.keys(dirty).sort(), ["attributionPreference", "bookNote", "finalNotes", "preferredAttribution"]);
   98:   assert.equal(dirty.attributionPreference, "anonymous", "unknown attribution becomes anonymous");
   99:   assert.equal(dirty.preferredAttribution.length, 240, "preferred attribution is capped");
  100:   assert.equal(dirty.bookNote, "note", "book note is trimmed");
  101:   assert.equal(dirty.finalNotes, null, "empty notes are null");
  102:   assert.equal(cap.sanitizePreferences({ attributionPreference: "full_name" }).attributionPreference, "full_name");
  103: 
  104:   // 7. Binding: a valid capability for S cannot be redeemed for a different submission id. Rejected before any DB work.
  105:   const tokenForSid = cap.generateToken();
  106:   const redeemedForOther = await cap.redeemCapability(OTHER, cap.formatCookieValue(SID, tokenForSid), prefs, now);
  107:   assert.equal(redeemedForOther, false, "cookie for S rejected for id O");
  108:   assert.equal(await cap.redeemCapability(SID, undefined, prefs, now), false, "missing cookie rejected");
  109: 
  110:   // 8. Local store: issue, consume once, replay refused, save guarded by status, expiry enforced in the statement.
  111:   const created = await db.createSubmission({
  112:     submitterName: "Fictional Tester", contact: "", encounterDate: "", isApproximateDate: false, locationName: "",
  113:     city: "", region: "", country: "", eventName: "", howMet: "", memoryText: "Fictional memory for capability tests.",
  114:     beforeText: "", afterText: "", metAgain: "", peoplePresent: "", yerielWearing: "", submitterWearing: "",
  115:     talkedAbout: "", exchanged: "", artifactInfo: "", forgottenPrompt: "", bookPagePrompt: "", additionalComments: "",
  116:     mediaLink: "", mediaConsent: false,
  117:   });
  118:   assert.equal(typeof created.id, "string");
  119:   assert.equal(typeof created.personId, "string");
  120: 
  121:   const token = await cap.issueCapability(created.id, now);
  122:   const cookie = cap.formatCookieValue(created.id, token);
  123:   assert.equal(await cap.redeemCapability(created.id, cookie, { ...prefs, finalNotes: "First save." }, now), true, "first redeem saves");
  124:   assert.equal(await cap.redeemCapability(created.id, cookie, { ...prefs, finalNotes: "Replay." }, now), false, "replay refused");
  125: 
  126:   // Expiry: a capability past its expiry cannot be consumed, even with the right token.
  127:   // One capability per submission (the table's primary key), so each case gets its own submission.
  128:   const expiredSub = await makeSubmission("expired");
  129:   const expiredToken = await cap.issueCapability(expiredSub.id, new Date("2020-01-01T00:00:00Z"));
  130:   const later = new Date("2026-10-31T12:00:00Z");
  131:   assert.equal(await cap.redeemCapability(expiredSub.id, cap.formatCookieValue(expiredSub.id, expiredToken), prefs, later), false, "expired capability refused");
  132: 
  133:   // Status gate: once reviewed, a live capability can no longer change preferences.
  134:   const reviewedSub = await makeSubmission("reviewed");
  135:   const reviewedToken = await cap.issueCapability(reviewedSub.id, now);
  136:   const { DatabaseSync } = await import("node:sqlite");
  137:   const raw = new DatabaseSync(process.env.DATABASE_PATH);
  138:   raw.prepare("UPDATE submissions SET status = 'REVIEWED' WHERE id = ?").run(reviewedSub.id);
  139:   assert.equal(await cap.redeemCapability(reviewedSub.id, cap.formatCookieValue(reviewedSub.id, reviewedToken), prefs, now), false, "reviewed submission refuses the save");
  140: 
  141:   // Stored value is the hash only: the raw token never appears in the table.
  142:   // Consume-first: the reviewed case spent its capability before the status gate refused the save, so no row remains for it.
  143:   assert.equal(raw.prepare("SELECT count(*) AS n FROM contributor_capabilities WHERE submission_id = ?").get(reviewedSub.id).n, 0, "reviewed case is consumed");
  144:   // The expired case was refused before consumption, so its row remains until the cleanup removes it.
  145:   const stored = raw.prepare("SELECT token_hash FROM contributor_capabilities WHERE submission_id = ?").all(expiredSub.id);
  146:   assert.equal(stored.length, 1, "expired row remains for cleanup");
  147:   for (const row of stored) {
  148:     assert.match(row.token_hash, /^[0-9a-f]{64}$/);
  149:     assert.notEqual(row.token_hash, reviewedToken);
  150:     assert.notEqual(row.token_hash, expiredToken);
  151:   }
  152:   raw.close();
  153: 
  154:   // Compensation removes the submission and its capability and person rows.
  155:   await db.deleteSubmissionRecords(created.id, created.personId);
  156:   const after = new DatabaseSync(process.env.DATABASE_PATH);
  157:   assert.equal(after.prepare("SELECT count(*) AS n FROM submissions WHERE id = ?").get(created.id).n, 0);
  158:   assert.equal(after.prepare("SELECT count(*) AS n FROM contributor_capabilities WHERE submission_id = ?").get(created.id).n, 0);
  159:   assert.equal(after.prepare("SELECT count(*) AS n FROM persons WHERE id = ?").get(created.personId).n, 0);
  160:   after.close();
  161: 
  162:   console.log("contributor capability tests ok");
  163: } finally {
  164:   // The store keeps its SQLite connection open for the process. Windows will not delete the file until exit,
  165:   // so cleanup is best effort and must never hide a test failure.
  166:   try {
  167:     rmSync(workDir, { recursive: true, force: true });
  168:   } catch {
  169:     console.warn(`[contributor-capability] temp directory left in place: ${workDir}`);
  170:   }
  171: }

