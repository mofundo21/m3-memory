   28: const PID = "8a7b6c5d-4e3f-4a2b-8c1d-9e0f1a2b3c4d";
   29: const HASH = "a".repeat(64);
   30: const NOW = "2026-10-31T12:00:00.000Z";
   31: const SERVICE = "fictional-service-role-key";
   32: const ANON = "fictional-anon-key";
   33: 
   34: function fakeFetch(responder) {
   35:   const calls = [];
   36:   const fn = async (url, init = {}) => {
   37:     calls.push({ url: String(url), method: init.method, headers: init.headers || {}, body: init.body ? JSON.parse(init.body) : undefined });
   38:     const reply = responder(calls.length - 1, String(url), init);
   39:     return new Response(reply.body === undefined ? "" : JSON.stringify(reply.body), { status: reply.status ?? 200 });
   40:   };
   41:   return { fn, calls };
   42: }
   43: 
   44: const ok = (body) => ({ status: 200, body });
   45: 
   46: // 1. Issue: one POST, service role only, exactly three columns.
   47: {
   48:   const { fn, calls } = fakeFetch(() => ok([]));
   49:   await supa.insertSupabaseCapability(SID, HASH, NOW, fn);
   50:   assert.equal(calls.length, 1);
   51:   assert.equal(calls[0].method, "POST");
   52:   assert.match(calls[0].url, /\/rest\/v1\/contributor_capabilities$/);
   53:   assert.deepEqual(Object.keys(calls[0].body).sort(), ["expires_at", "submission_id", "token_hash"]);
   54:   assert.equal(calls[0].headers.apikey, SERVICE);
   55:   assert.equal(calls[0].headers.authorization, `Bearer ${SERVICE}`);
   56: }
   57: 
   58: // 2. Consume: DELETE with every predicate; exactly one returned row with the same id is success.
   59: {
   60:   const { fn, calls } = fakeFetch(() => ok([{ submission_id: SID }]));
   61:   assert.equal(await supa.consumeSupabaseCapability(SID, HASH, NOW, fn), true);
   62:   const u = new URL(calls[0].url);
   63:   assert.equal(calls[0].method, "DELETE");
   64:   assert.equal(u.searchParams.get("submission_id"), `eq.${SID}`);
   65:   assert.equal(u.searchParams.get("token_hash"), `eq.${HASH}`);
   66:   assert.equal(u.searchParams.get("expires_at"), `gt.${NOW}`);
   67:   assert.equal(calls[0].headers.prefer, "return=representation");
   68:   assert.equal(calls[0].headers.authorization, `Bearer ${SERVICE}`);
   69: }
   70: // Consume failure shapes: zero rows, two rows, a different id. None is success.
   71: for (const body of [[], [{ submission_id: SID }, { submission_id: SID }], [{ submission_id: PID }], {}]) {
   72:   const { fn } = fakeFetch(() => ok(body));
   73:   assert.equal(await supa.consumeSupabaseCapability(SID, HASH, NOW, fn), false, `consume rejects ${JSON.stringify(body)}`);
   74: }
   75: 
   76: // 3. Save: PATCH guarded by id and status; body is exactly the four columns; one returned row with the same id.
   77: {
   78:   const { fn, calls } = fakeFetch(() => ok([{ id: SID }]));
   79:   const fields = { attributionPreference: "first_name", preferredAttribution: null, bookNote: "n", finalNotes: "f" };
   80:   assert.equal(await supa.saveSupabaseContributorPreferences(SID, fields, fn), true);
   81:   const u = new URL(calls[0].url);
   82:   assert.equal(calls[0].method, "PATCH");
   83:   assert.equal(u.searchParams.get("id"), `eq.${SID}`);
   84:   assert.equal(u.searchParams.get("status"), "eq.UNREVIEWED");
   85:   assert.deepEqual(Object.keys(calls[0].body).sort(), ["attribution_preference", "book_note", "final_notes", "preferred_attribution"]);
   86:   assert.equal(calls[0].headers.authorization, `Bearer ${SERVICE}`);
   87: }
   88: // A reviewed submission matches zero rows: refused. A wrong id is refused too.
   89: for (const body of [[], [{ id: SID }, { id: SID }], [{ id: PID }]]) {
   90:   const { fn } = fakeFetch(() => ok(body));
   91:   const fields = { attributionPreference: "anonymous", preferredAttribution: null, bookNote: null, finalNotes: null };
   92:   assert.equal(await supa.saveSupabaseContributorPreferences(SID, fields, fn), false, `save rejects ${JSON.stringify(body)}`);
   93: }
   94: 
   95: // 4. Compensation: three keyed deletes, in order, all with the service role.
   96: {
   97:   const { fn, calls } = fakeFetch(() => ok([]));
   98:   await supa.deleteSupabaseSubmissionRecords(SID, PID, fn);
   99:   assert.equal(calls.length, 3);
  100:   assert.match(calls[0].url, /contributor_capabilities\?submission_id=eq\./);
  101:   assert.match(calls[1].url, /submissions\?id=eq\./);
  102:   assert.match(calls[2].url, /persons\?id=eq\./);
  103:   for (const c of calls) {
  104:     assert.equal(c.method, "DELETE");
  105:     assert.equal(c.headers.authorization, `Bearer ${SERVICE}`);
  106:   }
  107: }
  108: 
  109: // 5. Injection: ids are percent-encoded into the filter, so a hostile value cannot add a filter.
  110: {
  111:   const { fn, calls } = fakeFetch(() => ok([]));
  112:   await supa.consumeSupabaseCapability("x&status=eq.REVIEWED", HASH, NOW, fn).catch(() => {});
  113:   assert.ok(!calls[0].url.includes("&status="), "an id cannot inject a filter");
  114:   assert.ok(calls[0].url.includes(encodeURIComponent("x&status=eq.REVIEWED")));
  115: }
  116: 
  117: // 6. Fail closed: a missing service-role key throws before any request.
  118: {
  119:   const saved = process.env.SUPABASE_SERVICE_ROLE_KEY;
  120:   process.env.SUPABASE_SERVICE_ROLE_KEY = "";
  121:   const { fn, calls } = fakeFetch(() => ok([]));
  122:   await assert.rejects(() => supa.consumeSupabaseCapability(SID, HASH, NOW, fn));
  123:   assert.equal(calls.length, 0, "no request is sent without the service-role key");
  124:   process.env.SUPABASE_SERVICE_ROLE_KEY = saved;
  125: }
  126: 
  127: // 7. Only the service key is ever sent by these helpers (the anon key never appears in any call).
  128: {
  129:   const { fn, calls } = fakeFetch(() => ok([{ submission_id: SID }]));
  130:   await supa.consumeSupabaseCapability(SID, HASH, NOW, fn);
  131:   for (const c of calls) assert.notEqual(c.headers.authorization, `Bearer ${ANON}`);
  132: }
  133: 
  134: // 8. Schema: the new table is RLS-enabled, revoked from anon and authenticated, has no policy, and the cleanup
  135: // function is not executable by application roles.
  136: {
  137:   const sql = readFileSync(join(root, "supabase/schema.sql"), "utf8");
  138:   const block = sql.slice(sql.indexOf("create table if not exists public.contributor_capabilities"));
  139:   assert.match(sql, /alter table public\.contributor_capabilities enable row level security;/);
  140:   assert.match(sql, /revoke all on public\.contributor_capabilities from anon, authenticated;/);
  141:   assert.doesNotMatch(sql, /create policy [a-z_]+ on public\.contributor_capabilities/, "no policy on the capability table");
  142:   assert.doesNotMatch(sql, /^\s*grant\b.*contributor_capabilities/im, "no grant statement on the capability table");
  143:   assert.match(sql, /revoke all on function public\.contributor_purge_expired\(\) from public, anon, authenticated;/);
  144:   assert.match(block, /security definer/, "cleanup runs as definer");
  145:   assert.doesNotMatch(sql, /grant[^;]*submissions[^;]*to anon/i, "submissions is not granted to anon");
  146: }
  147: 
  148: console.log("contributor capability supabase tests ok");

