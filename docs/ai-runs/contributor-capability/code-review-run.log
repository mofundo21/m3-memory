    8: const port = Number(process.env.V01_TEST_PORT || 3199);
    9: const base = `http://127.0.0.1:${port}`;
   10: const dbPath = `.m3-memory/v01-smoke-${port}-${Date.now()}.sqlite`;
   11: const adminPassword = "fictional-v01-admin-password";
   12: const sessionSecret = "fictional-v01-session-secret-with-length";
   13: 
   14: mkdirSync(".m3-memory", { recursive: true });
   15: const command = process.platform === "win32" ? "cmd.exe" : "npm";
   16: const args = process.platform === "win32"
   17:   ? ["/d", "/s", "/c", `npm run start -- -p ${port}`]
   18:   : ["run", "start", "--", "-p", String(port)];
   19: const child = spawn(command, args, {
   20:   env: { ...process.env, M3_PERSISTENCE: "sqlite", M3_ADMIN_AUTH: "local", DATABASE_PATH: dbPath, ADMIN_PASSWORD: adminPassword, SESSION_SECRET: sessionSecret },
   21:   stdio: ["ignore", "pipe", "pipe"],
   22:   windowsHide: true
   23: });
   24: 
   25: let logs = "";
   26: child.stdout.on("data", (chunk) => { logs += chunk.toString(); });
   27: child.stderr.on("data", (chunk) => { logs += chunk.toString(); });
