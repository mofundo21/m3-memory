   20: export async function submitMemoryAction(formData: FormData) {
   21:   const input: SubmissionInput = {
   22:     submitterName: String(formData.get("submitterName") || "").trim() || "Anonymous",
   23:     contact: String(formData.get("contact") || ""),
   24:     encounterDate: String(formData.get("encounterDate") || ""),
   25:     isApproximateDate: formData.get("isApproximateDate") === "on",
   26:     locationName: String(formData.get("locationName") || ""),
   27:     city: String(formData.get("city") || ""),
   28:     region: String(formData.get("region") || ""),
   29:     country: String(formData.get("country") || ""),
   30:     eventName: String(formData.get("eventName") || ""),
   31:     howMet: String(formData.get("howMet") || ""),
   32:     memoryText: String(formData.get("memoryText") || ""),
   33:     beforeText: String(formData.get("beforeText") || ""),
   34:     afterText: String(formData.get("afterText") || ""),
   35:     metAgain: String(formData.get("metAgain") || ""),
   36:     peoplePresent: String(formData.get("peoplePresent") || ""),
   37:     yerielWearing: String(formData.get("yerielWearing") || ""),
   38:     submitterWearing: String(formData.get("submitterWearing") || ""),
   39:     talkedAbout: String(formData.get("talkedAbout") || ""),
   40:     exchanged: String(formData.get("exchanged") || ""),
   41:     artifactInfo: String(formData.get("artifactInfo") || ""),
   42:     forgottenPrompt: String(formData.get("forgottenPrompt") || ""),
   43:     bookPagePrompt: String(formData.get("bookPagePrompt") || ""),
   44:     additionalComments: String(formData.get("additionalComments") || ""),
   45:     mediaLink: String(formData.get("mediaLink") || ""),
   46:     mediaConsent: formData.get("mediaConsent") === "on"
   47:   };
   48: 
   49:   if (!input.memoryText.trim()) {
   50:     redirect("/remember/write?error=missing");
   51:   }
   52: 
   53:   const { id: submissionId, personId } = await createSubmission(input);
   54: 
   55:   // Issue the contributor capability only after the submission has persisted. If issuance fails, remove what was
   56:   // just created so no unusable submission is left behind. The cookie is set before any media work.
   57:   let capabilityToken: string;
   58:   try {
   59:     capabilityToken = await issueCapability(submissionId, new Date());
   60:   } catch {
   61:     logContributorEvent("issue-failed");
   62:     try {
   63:       await deleteSubmissionRecords(submissionId, personId);
   64:     } catch {
   65:       logContributorEvent("compensation-failed");
   66:     }
   67:     redirect("/remember/details?error=save");
   68:   }
   69:   const jar = await cookies();
   70:   jar.set(cookieNameFor(submissionId), formatCookieValue(submissionId, capabilityToken), cookieOptions());
   71: 
   72:   const mediaFiles = formData.getAll("media") as File[];
   73:   if (mediaFiles.length > 0 && getPersistenceMode() === "supabase") {
   74:     try {
   75:       const validationInputs = await Promise.all(
   76:         mediaFiles.map(async (file) => ({
   77:           fileName: file.name,
   78:           mimeType: file.type,
   79:           sizeBytes: file.size
   80:         }))
   81:       );
   82: 
   83:       validateMediaUpload(validationInputs);
   84: 
   85:       const uploadedMedia = await Promise.all(
   86:         mediaFiles.map(async (file) => {
   87:           const buffer = await file.arrayBuffer();
   88:           const storagePath = await uploadSupabaseMedia(
   89:             submissionId,
   90:             file.name,
   91:             new Uint8Array(buffer),
   92:             file.type
   93:           );
   94: 
   95:           return {
   96:             fileName: file.name,
   97:             mimeType: file.type,
   98:             sizeBytes: file.size,
   99:             storagePath
  100:           };
  101:         })
  102:       );
  103: 
  104:       await insertMediaRows(submissionId, uploadedMedia);
  105:     } catch (error: any) {
  106:       console.error("Media upload error:", error);
  107:       redirect(`/remember/details?error=media`);
  108:     }
  109:   }
  110: 
  111:   redirect(`/remember/final?submissionId=${submissionId}`);
  112: }
