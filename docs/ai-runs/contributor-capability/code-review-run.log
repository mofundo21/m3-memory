  358: function mapSupabaseDetail(row: any) {
  359:   const person = Array.isArray(row.persons) ? row.persons[0] : row.persons;
  360:   const reviews = Array.isArray(row.reviews) ? row.reviews : row.reviews ? [row.reviews] : [];
  361:   const { persons, reviews: _reviews, original_json, ...submission } = row;
  362:   void persons;
  363:   void _reviews;
  364:   return {
  365:     ...submission,
  366:     original_json: typeof original_json === "string" ? original_json : JSON.stringify(original_json),
  367:     submitterName: person?.display_name || null,
  368:     contact: person?.contact || null,
  369:     original: typeof original_json === "string" ? JSON.parse(original_json) : original_json,
  370:     review: reviews[0] || null
  371:   };
  372: }
