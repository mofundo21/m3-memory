  367: // ---- Contributor capability store. Narrow, service-role only. See docs/MUSEUM_CONTRIBUTOR_CAPABILITY_DESIGN.md. ----
  368: // These four functions are the only service-role writes for contributor capabilities. They never accept a bearer
  369: // or admin token, and every filter is built from values the caller verified. Row counts are checked, so a
  370: // zero-row or wrong-row response is a failure, not a success.
  371: 
  372: export async function insertSupabaseCapability(submissionId: string, tokenHash: string, expiresAt: string, fetchImpl: FetchLike = fetch) {
  373:   const config = getSupabaseConfig(true);
  374:   await request(`${config.url}/rest/v1/contributor_capabilities`, {
  375:     method: "POST",
  376:     headers: { ...headers(config.serviceRoleKey), prefer: "return=minimal" },
  377:     body: JSON.stringify({ submission_id: submissionId, token_hash: tokenHash, expires_at: expiresAt })
  378:   }, fetchImpl);
  379: }
  380: 
  381: /** Consume-first: the DELETE is the single-use gate. Returns true only when exactly the expected row was removed. */
  382: export async function consumeSupabaseCapability(submissionId: string, tokenHash: string, nowIso: string, fetchImpl: FetchLike = fetch) {
  383:   const config = getSupabaseConfig(true);
  384:   const url = `${config.url}/rest/v1/contributor_capabilities?submission_id=eq.${encodeURIComponent(submissionId)}`
  385:     + `&token_hash=eq.${encodeURIComponent(tokenHash)}&expires_at=gt.${encodeURIComponent(nowIso)}&select=submission_id`;
  386:   const rows = await request(url, {
  387:     method: "DELETE",
  388:     headers: { ...headers(config.serviceRoleKey), prefer: "return=representation" }
  389:   }, fetchImpl);
  390:   return Array.isArray(rows) && rows.length === 1 && rows[0]?.submission_id === submissionId;
  391: }
  392: 
  393: /** Save the four contributor-owned fields. Guarded by status: only an UNREVIEWED row can change. */
  394: export async function saveSupabaseContributorPreferences(submissionId: string, fields: { attributionPreference: string; preferredAttribution: string | null; bookNote: string | null; finalNotes: string | null }, fetchImpl: FetchLike = fetch) {
  395:   const config = getSupabaseConfig(true);
  396:   const url = `${config.url}/rest/v1/submissions?id=eq.${encodeURIComponent(submissionId)}&status=eq.UNREVIEWED&select=id`;
  397:   const rows = await request(url, {
  398:     method: "PATCH",
  399:     headers: { ...headers(config.serviceRoleKey), prefer: "return=representation" },
  400:     body: JSON.stringify({
  401:       attribution_preference: fields.attributionPreference,
  402:       preferred_attribution: fields.preferredAttribution,
  403:       book_note: fields.bookNote,
  404:       final_notes: fields.finalNotes
  405:     })
  406:   }, fetchImpl);
  407:   return Array.isArray(rows) && rows.length === 1 && rows[0]?.id === submissionId;
  408: }
  409: 
  410: /** Compensation for a failed creation: capability, submission, then person. Each delete is keyed by a verified id. */
  411: export async function deleteSupabaseSubmissionRecords(submissionId: string, personId: string, fetchImpl: FetchLike = fetch) {
  412:   const config = getSupabaseConfig(true);
  413:   const auth = { ...headers(config.serviceRoleKey), prefer: "return=minimal" };
  414:   await request(`${config.url}/rest/v1/contributor_capabilities?submission_id=eq.${encodeURIComponent(submissionId)}`, { method: "DELETE", headers: auth }, fetchImpl);
  415:   await request(`${config.url}/rest/v1/submissions?id=eq.${encodeURIComponent(submissionId)}`, { method: "DELETE", headers: auth }, fetchImpl);
  416:   await request(`${config.url}/rest/v1/persons?id=eq.${encodeURIComponent(personId)}`, { method: "DELETE", headers: auth }, fetchImpl);
  417: }

