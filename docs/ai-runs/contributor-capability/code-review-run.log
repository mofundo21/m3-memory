   91:  * names, and is the only id used for database predicates. Consume happens before the save.
   92:  */
   93: export async function redeemCapability(submissionId: string, cookieValue: string | undefined, prefs: ContributorPreferences, now: Date) {
   94:   const parsed = parseCookieValue(cookieValue);
