   72: // ---- Browser helpers: drive the current interview UI as a visitor would. ----
   73: 
   74: /** Set a React-controlled textarea/input and fire the input event React listens for. */
   75: async function fillField(page, selector, value) {
   76:   await page.waitForSelector(selector);
   77:   await page.$eval(selector, (el, v) => {
   78:     const proto = el instanceof HTMLTextAreaElement ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
   79:     Object.getOwnPropertyDescriptor(proto, "value").set.call(el, v);
   80:     el.dispatchEvent(new Event("input", { bubbles: true }));
   81:   }, value);
   82: }
   83: 
   84: async function clickButton(page, label) {
   85:   const button = await page.waitForSelector(`button::-p-text(${label})`, { visible: true });
   86:   await button.click();
   87: }
   88: 
   89: async function waitForPath(page, path) {
   90:   await page.waitForFunction((p) => window.location.pathname.startsWith(p), { timeout: 15000 }, path);
   91: }
   92: 
   93: /**
   94:  * Public journey through the current interview:
   95:  * /remember (narrative) -> /remember/write -> /remember/details -> /remember/final -> /thanks.
   96:  * Each submission uses a fresh tab so the session-stored draft starts empty.
   97:  */
   98: async function submitPublicMemory(browser, { memoryText, aboutYou, eventName, mediaLink, attribution, finalNotes }) {
   99:   const page = await browser.newPage();
  100:   try {
  101:     await page.setViewport({ width: 1280, height: 900 });
  102:     await page.goto(`${base}/remember`, { waitUntil: "networkidle0", timeout: 30000 });
  103: 
  104:     // Narrative CTA leads into the interview.
  105:     const cta = await page.waitForSelector('a[href="/remember/write"]', { timeout: 15000 });
  106:     assert.match(await cta.evaluate((a) => a.textContent.trim()), /LET'S REMEMBER/i, "intro CTA should be the interview entry");
  107:     await page.evaluate(() => document.querySelector('a[href="/remember/write"]').click());
  108:     await waitForPath(page, "/remember/write");
  109: 
  110:     // Step 2: an empty memory is refused with a visible message and no navigation.
  111:     await clickButton(page, "Keep Going");
  112:     await page.waitForFunction(() => document.querySelector(".error-note")?.textContent.includes("Please share your memory"), { timeout: 5000 });
  113:     assert.ok(page.url().endsWith("/remember/write"), "empty memory must stay on the write step");
  114: 
  115:     // About you: the name and email are captured on the write step, before the memory is sent.
  116:     if (aboutYou?.name) await fillField(page, "#submitterName", aboutYou.name);
  117:     if (aboutYou?.contact) await fillField(page, "#contact", aboutYou.contact);
  118:     await fillField(page, 'textarea[name="memoryText"]', memoryText);
  119:     await clickButton(page, "Keep Going");
  120:     await waitForPath(page, "/remember/details");
  121: 
  122:     // Step 3: optional details. A media link reveals the consent checkbox.
  123:     if (eventName) await fillField(page, 'input[name="eventName"]', eventName);
  124:     if (mediaLink) {
  125:       await fillField(page, 'input[name="mediaLink"]', mediaLink);
  126:       // Select the consent box by its label, not by position (the first checkline is "approximate date").
  127:       await page.waitForFunction(() => [...document.querySelectorAll("label.checkline")].some((l) => l.textContent.includes("use this in the book")));
  128:       await page.evaluate(() => [...document.querySelectorAll("label.checkline")].find((l) => l.textContent.includes("use this in the book")).querySelector("input").click());
  129:     }
  130:     await clickButton(page, "One Last Thing");
  131:     await waitForPath(page, "/remember/final");
  132: 
  133:     // Step 4: attribution preference and final notes, then send.
  134:     const submissionId = new URL(page.url()).searchParams.get("submissionId");
  135:     assert.ok(submissionId, "final step should carry the submission ID");
  136:     // The contributor capability cookie is issued for this submission: HttpOnly, strict, and scoped to /remember.
  137:     const issued = (await page.cookies()).find((c) => c.name === `m3_contrib_${submissionId}`);
  138:     assert.ok(issued, "capability cookie is issued for this submission");
  139:     assert.equal(issued.httpOnly, true, "capability cookie is HttpOnly");
  140:     assert.equal(issued.path, "/remember", "capability cookie is scoped to /remember");
  141:     assert.equal(issued.sameSite, "Strict", "capability cookie is SameSite=Strict");
  142:     // The name is no longer asked for on the final step; it was captured earlier.
  143:     assert.equal(await page.$("#submitterName"), null, "final step must not ask for the name again");
  144:     if (attribution) {
  145:       const option = await page.waitForSelector(`input[name="attributionPreference"][value="${attribution}"]`, { visible: true });
  146:       await option.click();
  147:     }
  148:     if (finalNotes) await fillField(page, "#finalNotes", finalNotes);
  149:     await clickButton(page, "Send My Memory");
  150:     await waitForPath(page, "/thanks");
  151:     // The capability is spent on save, and the cookie is cleared in the same response.
  152:     assert.equal((await page.cookies()).find((c) => c.name === `m3_contrib_${submissionId}`), undefined, "capability cookie is cleared after the save");
  153: 
  154:     // The confirmation page must not echo the memory or the submission ID.
  155:     const thanksHtml = await page.content();
  156:     assert.doesNotMatch(thanksHtml, new RegExp(submissionId));
  157:     assert.doesNotMatch(thanksHtml, /Fictional/);
  158:     return submissionId;
  159:   } finally {
  160:     await page.close();
  161:   }
  162: }
