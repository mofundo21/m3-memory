+
+// ---- Contributor capability store (dispatches by persistence mode). Used only by src/lib/contributorCapability.ts. ----
+
+export async function storeContributorCapability(submissionId: string, tokenHash: string, expiresAt: string) {
+  if (getPersistenceMode() === "supabase") {
+    await insertSupabaseCapability(submissionId, tokenHash, expiresAt);
+    return;
+  }
+  getDb().prepare("INSERT INTO contributor_capabilities (submission_id, token_hash, expires_at) VALUES (?, ?, ?)").run(submissionId, tokenHash, expiresAt);
+}
+
+/** Atomic consume. True only if exactly one unexpired row matched and was deleted. */
+export async function consumeContributorCapability(submissionId: string, tokenHash: string, nowIso: string) {
+  if (getPersistenceMode() === "supabase") {
+    return consumeSupabaseCapability(submissionId, tokenHash, nowIso);
+  }
+  const rows = getDb()
+    .prepare("DELETE FROM contributor_capabilities WHERE submission_id = ? AND token_hash = ? AND expires_at > ? RETURNING submission_id")
+    .all(submissionId, tokenHash, nowIso);
+  return rows.length === 1 && (rows[0] as { submission_id: string }).submission_id === submissionId;
+}
+
+/** Guarded save of the four contributor-owned fields. True only if exactly the one UNREVIEWED row changed. */
+export async function saveContributorPreferences(
+  submissionId: string,
+  fields: { attributionPreference: string; preferredAttribution: string | null; bookNote: string | null; finalNotes: string | null }
+) {
+  if (getPersistenceMode() === "supabase") {
+    return saveSupabaseContributorPreferences(submissionId, fields);
+  }
+  const result = getDb()
+    .prepare(`UPDATE submissions SET attribution_preference = ?, preferred_attribution = ?, book_note = ?, final_notes = ?, updated_at = ?
+              WHERE id = ? AND status = 'UNREVIEWED'`)
+    .run(fields.attributionPreference, fields.preferredAttribution, fields.bookNote, fields.finalNotes, now(), submissionId);
+  return Number(result.changes) === 1;
+}
+
+/** Compensation for a failed creation. Best effort; the caller logs a category, never the ids. */
+export async function deleteSubmissionRecords(submissionId: string, personId: string) {
+  if (getPersistenceMode() === "supabase") {
+    await deleteSupabaseSubmissionRecords(submissionId, personId);
+    return;
+  }
+  const db = getDb();
+  db.prepare("DELETE FROM contributor_capabilities WHERE submission_id = ?").run(submissionId);
+  db.prepare("DELETE FROM submissions WHERE id = ?").run(submissionId);
+  db.prepare("DELETE FROM persons WHERE id = ?").run(personId);
+}
diff --git a/src/lib/supabase.ts b/src/lib/supabase.ts
index d8a9164..945b877 100644
--- a/src/lib/supabase.ts
+++ b/src/lib/supabase.ts
@@ -363,3 +363,55 @@ export async function updateSupabaseSubmissionPreferences(submissionId: string,
     body: JSON.stringify(payload)
   }, fetchImpl);
 }
+
+// ---- Contributor capability store. Narrow, service-role only. See docs/MUSEUM_CONTRIBUTOR_CAPABILITY_DESIGN.md. ----
+// These four functions are the only service-role writes for contributor capabilities. They never accept a bearer
+// or admin token, and every filter is built from values the caller verified. Row counts are checked, so a
+// zero-row or wrong-row response is a failure, not a success.
+
+export async function insertSupabaseCapability(submissionId: string, tokenHash: string, expiresAt: string, fetchImpl: FetchLike = fetch) {
+  const config = getSupabaseConfig(true);
+  await request(`${config.url}/rest/v1/contributor_capabilities`, {
+    method: "POST",
+    headers: { ...headers(config.serviceRoleKey), prefer: "return=minimal" },
+    body: JSON.stringify({ submission_id: submissionId, token_hash: tokenHash, expires_at: expiresAt })
+  }, fetchImpl);
+}
+
+/** Consume-first: the DELETE is the single-use gate. Returns true only when exactly the expected row was removed. */
+export async function consumeSupabaseCapability(submissionId: string, tokenHash: string, nowIso: string, fetchImpl: FetchLike = fetch) {
+  const config = getSupabaseConfig(true);
+  const url = `${config.url}/rest/v1/contributor_capabilities?submission_id=eq.${encodeURIComponent(submissionId)}`
+    + `&token_hash=eq.${encodeURIComponent(tokenHash)}&expires_at=gt.${encodeURIComponent(nowIso)}&select=submission_id`;
+  const rows = await request(url, {
+    method: "DELETE",
+    headers: { ...headers(config.serviceRoleKey), prefer: "return=representation" }
+  }, fetchImpl);
+  return Array.isArray(rows) && rows.length === 1 && rows[0]?.submission_id === submissionId;
+}
+
+/** Save the four contributor-owned fields. Guarded by status: only an UNREVIEWED row can change. */
+export async function saveSupabaseContributorPreferences(submissionId: string, fields: { attributionPreference: string; preferredAttribution: string | null; bookNote: string | null; finalNotes: string | null }, fetchImpl: FetchLike = fetch) {
+  const config = getSupabaseConfig(true);
+  const url = `${config.url}/rest/v1/submissions?id=eq.${encodeURIComponent(submissionId)}&status=eq.UNREVIEWED&select=id`;
+  const rows = await request(url, {
+    method: "PATCH",
+    headers: { ...headers(config.serviceRoleKey), prefer: "return=representation" },
+    body: JSON.stringify({
+      attribution_preference: fields.attributionPreference,
+      preferred_attribution: fields.preferredAttribution,
+      book_note: fields.bookNote,
+      final_notes: fields.finalNotes
+    })
+  }, fetchImpl);
+  return Array.isArray(rows) && rows.length === 1 && rows[0]?.id === submissionId;
+}
+
+/** Compensation for a failed creation: capability, submission, then person. Each delete is keyed by a verified id. */
+export async function deleteSupabaseSubmissionRecords(submissionId: string, personId: string, fetchImpl: FetchLike = fetch) {
+  const config = getSupabaseConfig(true);
+  const auth = { ...headers(config.serviceRoleKey), prefer: "return=minimal" };
+  await request(`${config.url}/rest/v1/contributor_capabilities?submission_id=eq.${encodeURIComponent(submissionId)}`, { method: "DELETE", headers: auth }, fetchImpl);
+  await request(`${config.url}/rest/v1/submissions?id=eq.${encodeURIComponent(submissionId)}`, { method: "DELETE", headers: auth }, fetchImpl);
+  await request(`${config.url}/rest/v1/persons?id=eq.${encodeURIComponent(personId)}`, { method: "DELETE", headers: auth }, fetchImpl);
+}
diff --git a/supabase/schema.sql b/supabase/schema.sql
index a503464..aaa87ce 100644
--- a/supabase/schema.sql
+++ b/supabase/schema.sql
@@ -219,3 +219,48 @@ using (public.is_m3_admin());
 -- Next.js server path with SUPABASE_SERVICE_ROLE_KEY (which bypasses RLS). Media and story drafts are admin-only
 -- and never accessible to anonymous or non-admin authenticated users. Media table defaults to default-deny
 -- (RLS enabled, no insert/update/delete grants to any role, insert through service role only).
+
+-- ---------------------------------------------------------------------------------------------------------------
+-- Contributor write capability (docs/MUSEUM_CONTRIBUTOR_CAPABILITY_DESIGN.md). One row per submission with an open
+-- contributor window. Stores SHA-256(token) only, never the raw token. Readable and writable only by the service
+-- role, which the server uses from two narrow helpers. No policy and no grant exists for anon or authenticated.
+-- ---------------------------------------------------------------------------------------------------------------
+create table if not exists public.contributor_capabilities (
+  submission_id uuid primary key,
+  token_hash text not null,
+  expires_at timestamptz not null,
+  created_at timestamptz not null default now()
+);
+
+create index if not exists contributor_capabilities_expires_idx on public.contributor_capabilities (expires_at);
+
+alter table public.contributor_capabilities enable row level security;
+revoke all on public.contributor_capabilities from anon, authenticated;
+-- Deliberately no policies: no application role other than the server's service key may read or write this table.
+
+-- Scheduled cleanup (open decision: scheduler). Removes expired capabilities and contributor person rows that no
+-- submission references. The 2-hour guard protects a person row that another request is creating right now.
+-- Executable only by the database owner or the service role, never by anon or authenticated.
+create or replace function public.contributor_purge_expired()
+returns integer
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  removed_capabilities integer := 0;
+  removed_people integer := 0;
+begin
+  delete from public.contributor_capabilities where expires_at < now();
+  get diagnostics removed_capabilities = row_count;
+
+  delete from public.persons p
+   where p.created_at < now() - interval '2 hours'
+     and not exists (select 1 from public.submissions s where s.submitter_person_id = p.id);
+  get diagnostics removed_people = row_count;
+
+  return removed_capabilities + removed_people;
+end;
+$$;
+
+revoke all on function public.contributor_purge_expired() from public, anon, authenticated;

