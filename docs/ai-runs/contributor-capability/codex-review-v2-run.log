 386: export async function upsertReview(submissionId: string, input: ReviewInput, adminToken?: string | null) {
 387:   const review = normalizeReview(input);
 388: 
 389:   if (getPersistenceMode() === "supabase") {
 390:     await upsertSupabaseReview(submissionId, review, requireSupabaseAdminToken(adminToken));
 391:     return;
 392:   }
 393: 
 394:   const db = getDb();
 395:   const existing = db.prepare("SELECT id FROM reviews WHERE submission_id = ?").get(submissionId) as any;
 396:   const reviewId = existing?.id || randomUUID();
 397: 
 398:   if (existing) {
 399:     db.prepare(`
 400:       UPDATE reviews SET
 401:         notes = ?, remembered = ?, corrections = ?, context = ?, people = ?, tags = ?,
 402:         importance = ?, emotional_significance = ?, historical_significance = ?,
 403:         accuracy_confidence = ?, book_potential = ?, chapter_category = ?, private_notes = ?,
 404:         updated_at = ?
 405:       WHERE submission_id = ?
 406:     `).run(
 407:       review.notes,
 408:       review.remembered,
 409:       review.corrections,
 410:       review.context,
 411:       review.people,
 412:       review.tags,
 413:       review.importance,
 414:       review.emotional_significance,
 415:       review.historical_significance,
 416:       review.accuracy_confidence,
 417:       review.book_potential,
 418:       review.chapter_category,
 419:       review.private_notes,
 420:       review.updated_at,
 421:       submissionId
 422:     );
 423:   } else {
