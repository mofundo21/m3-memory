  386: export async function upsertReview(submissionId: string, input: ReviewInput, adminToken?: string | null) {
  387:   const review = normalizeReview(input);
  388: 
  389:   if (getPersistenceMode() === "supabase") {
  390:     await upsertSupabaseReview(submissionId, review, requireSupabaseAdminToken(adminToken));
  391:     return;
  392:   }
  393: 
  394:   const db = getDb();
  395:   const existing = db.prepare("SELECT id FROM reviews WHERE submission_id = ?").get(submissionId) as any;
  396:   const reviewId = existing?.id || randomUUID();
  397: 
  398:   if (existing) {
  399:     db.prepare(`
  400:       UPDATE reviews SET
  401:         notes = ?, remembered = ?, corrections = ?, context = ?, people = ?, tags = ?,
  402:         importance = ?, emotional_significance = ?, historical_significance = ?,
  403:         accuracy_confidence = ?, book_potential = ?, chapter_category = ?, private_notes = ?,
  404:         updated_at = ?
  405:       WHERE submission_id = ?
  406:     `).run(
  407:       review.notes,
  408:       review.remembered,
  409:       review.corrections,
  410:       review.context,
  411:       review.people,
  412:       review.tags,
  413:       review.importance,
  414:       review.emotional_significance,
  415:       review.historical_significance,
  416:       review.accuracy_confidence,
  417:       review.book_potential,
  418:       review.chapter_category,
  419:       review.private_notes,
  420:       review.updated_at,
  421:       submissionId
  422:     );
  423:   } else {
  424:     db.prepare(`
  425:       INSERT INTO reviews (
  426:         id, submission_id, notes, remembered, corrections, context, people, tags,
  427:         importance, emotional_significance, historical_significance, accuracy_confidence,
  428:         book_potential, chapter_category, private_notes, created_at, updated_at
  429:       ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  430:     `).run(
  431:       reviewId,
  432:       submissionId,
  433:       review.notes,
  434:       review.remembered,
  435:       review.corrections,
  436:       review.context,
  437:       review.people,
  438:       review.tags,
  439:       review.importance,
  440:       review.emotional_significance,
  441:       review.historical_significance,
  442:       review.accuracy_confidence,
  443:       review.book_potential,
  444:       review.chapter_category,
  445:       review.private_notes,
  446:       review.updated_at,
  447:       review.updated_at
  448:     );
  449:   }
  450: 
  451:   db.prepare("UPDATE submissions SET status = ?, updated_at = ? WHERE id = ?").run(
  452:     review.status,
  453:     review.updated_at,
  454:     submissionId
  455:   );
  456: }
