  138: export async function getSupabaseUser(accessToken: string, fetchImpl: FetchLike = fetch) {
  139:   const config = getSupabaseConfig(false);
  140:   const data = await request(`${config.url}/auth/v1/user`, {
  141:     method: "GET",
  142:     headers: headers(config.anonKey, accessToken)
  143:   }, fetchImpl).catch(() => null) as any;
  144: 
  145:   if (!data?.id) return null;
  146:   return { userId: String(data.id), email: String(data.email || "") };
  147: }
