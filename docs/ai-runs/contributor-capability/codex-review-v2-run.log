 268:     optionalText(record.original.contact, 240) ?? null,
 269:     record.createdAt
 270:   );
 271: 
 272:   db.prepare(`
 273:     INSERT INTO submissions (
 274:       id, submitter_person_id, original_json, memory_preview, encounter_date,
 275:       is_approximate_date, location_name, city, region, country, event_name,
 276:       media_link, media_consent,
 277:       status, created_at, updated_at
 278:     ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'UNREVIEWED', ?, ?)
 279:   `).run(
 280:     record.id,
 281:     record.personId,
 282:     JSON.stringify(record.original),
 283:     record.memoryPreview,
 284:     record.encounterDate,
 285:     record.isApproximateDate ? 1 : 0,
 286:     record.locationName,
 287:     record.city,
 288:     record.region,
 289:     record.country,
 290:     record.eventName,
 291:     record.original.mediaLink || null,
 292:     record.original.mediaConsent ? 1 : 0,
 293:     record.createdAt,
 294:     record.createdAt
 295:   );
 296: 
 297:   return record.id;
 298: }
