 343: function mapSupabaseDetail(row: any) {
 344:   const person = Array.isArray(row.persons) ? row.persons[0] : row.persons;
 345:   const reviews = Array.isArray(row.reviews) ? row.reviews : row.reviews ? [row.reviews] : [];
 346:   const { persons, reviews: _reviews, original_json, ...submission } = row;
 347:   void persons;
 348:   void _reviews;
 349:   return {
 350:     ...submission,
 351:     original_json: typeof original_json === "string" ? original_json : JSON.stringify(original_json),
 352:     submitterName: person?.display_name || null,
 353:     contact: person?.contact || null,
 354:     original: typeof original_json === "string" ? JSON.parse(original_json) : original_json,
 355:     review: reviews[0] || null
 356:   };
