  300: export async function uploadSupabaseMedia(submissionId: string, fileName: string, fileBuffer: Uint8Array | Buffer, contentType: string, fetchImpl: FetchLike = fetch) {
  301:   const config = getSupabaseConfig(true);
  302:   const storagePath = `submissions/${submissionId}/${randomUUID()}-${sanitizeFileName(fileName)}`;
  303: 
  304:   const body = Buffer.isBuffer(fileBuffer) ? new Uint8Array(fileBuffer) : fileBuffer;
  305: 
  306:   await request(`${config.url}/storage/v1/object/submission-media/${encodeURIComponent(storagePath)}`, {
  307:     method: "POST",
  308:     headers: { authorization: `Bearer ${config.serviceRoleKey}` },
  309:     body: body as BodyInit
  310:   }, fetchImpl);
  311: 
  312:   return storagePath;
  313: }
