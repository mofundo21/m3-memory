  167:   await request(`${config.url}/rest/v1/persons`, {
  168:     method: "POST",
  169:     headers: { ...headers(config.serviceRoleKey), prefer: "return=minimal" },
  170:     body: JSON.stringify({
  171:       id: record.personId,
  172:       display_name: record.original.submitterName,
  173:       contact: record.original.contact || null,
  174:       created_at: record.createdAt
  175:     })
  176:   }, fetchImpl);
  177: 
  178:   await request(`${config.url}/rest/v1/submissions`, {
  179:     method: "POST",
  180:     headers: { ...headers(config.serviceRoleKey), prefer: "return=minimal" },
  181:     body: JSON.stringify({
  182:       id: record.id,
  183:       submitter_person_id: record.personId,
  184:       original_json: record.original,
  185:       memory_preview: record.memoryPreview,
  186:       encounter_date: record.encounterDate,
  187:       is_approximate_date: record.isApproximateDate,
  188:       location_name: record.locationName,
  189:       city: record.city,
  190:       region: record.region,
  191:       country: record.country,
  192:       event_name: record.eventName,
  193:       media_link: record.original.mediaLink || null,
  194:       media_consent: record.original.mediaConsent || false,
  195:       status: "UNREVIEWED",
  196:       created_at: record.createdAt,
  197:       updated_at: record.createdAt
  198:     })
  199:   }, fetchImpl);
  200: 
  201:   return record.id;
  202: }
