   84: export function getSupabaseConfig(requireServiceRole = true): SupabaseConfig {
   85:   const url = process.env.NEXT_PUBLIC_SUPABASE_URL?.replace(/\/+$/, "") || "";
   86:   const anonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || "";
   87:   const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY || "";
   88: 
   89:   if (!url || !anonKey || (requireServiceRole && !serviceRoleKey)) {
   90:     throw new Error("SUPABASE_MISCONFIGURED");
   91:   }
   92: 
   93:   return { url, anonKey, serviceRoleKey };
   94: }
