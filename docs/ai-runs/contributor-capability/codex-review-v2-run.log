  300: function mapSupabaseListItem(item: any) {
  301:   const person = Array.isArray(item.persons) ? item.persons[0] : item.persons;
  302:   return {
  303:     id: item.id,
  304:     status: item.status,
  305:     memoryPreview: item.memory_preview,
  306:     encounterDate: item.encounter_date,
  307:     locationName: item.location_name,
  308:     city: item.city,
  309:     region: item.region,
  310:     country: item.country,
  311:     eventName: item.event_name,
  312:     createdAt: item.created_at,
  313:     submitterName: person?.display_name || null
  314:   };
  315: }
