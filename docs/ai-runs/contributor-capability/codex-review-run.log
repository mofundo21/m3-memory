  141:     method: "GET",
  142:     headers: headers(config.anonKey, accessToken)
  143:   }, fetchImpl).catch(() => null) as any;
  144: 
  145:   if (!data?.id) return null;
  146:   return { userId: String(data.id), email: String(data.email || "") };
  147: }
