  182:       id: record.id,
  183:       submitter_person_id: record.personId,
  184:       original_json: record.original,
  185:       memory_preview: record.memoryPreview,
  186:       encounter_date: record.encounterDate,
  187:       is_approximate_date: record.isApproximateDate,
  188:       location_name: record.locationName,
  189:       city: record.city,
  190:       region: record.region,
