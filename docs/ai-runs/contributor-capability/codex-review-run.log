  221: export async function upsertSupabaseReview(submissionId: string, review: NormalizedReview, adminToken?: string | null, fetchImpl: FetchLike = fetch) {
  222:   if (!adminToken) throw new Error("UNAUTHENTICATED");
  223:   const config = getSupabaseConfig(false);
  224:   const existing = await request(`${config.url}/rest/v1/reviews?select=id&submission_id=eq.${encodeURIComponent(submissionId)}&limit=1`, {
  225:     method: "GET",
  226:     headers: headers(config.anonKey, adminToken)
  227:   }, fetchImpl) as any[];
  228: 
  229:   const reviewPayload = {
  230:     notes: review.notes,
  231:     remembered: review.remembered,
  232:     corrections: review.corrections,
  233:     context: review.context,
  234:     people: review.people,
  235:     tags: review.tags,
  236:     importance: review.importance,
  237:     emotional_significance: review.emotional_significance,
  238:     historical_significance: review.historical_significance,
  239:     accuracy_confidence: review.accuracy_confidence,
  240:     book_potential: review.book_potential,
  241:     chapter_category: review.chapter_category,
  242:     private_notes: review.private_notes,
  243:     updated_at: review.updated_at
  244:   };
  245: 
  246:   if (existing[0]?.id) {
  247:     await request(`${config.url}/rest/v1/reviews?submission_id=eq.${encodeURIComponent(submissionId)}`, {
  248:       method: "PATCH",
  249:       headers: { ...headers(config.anonKey, adminToken), prefer: "return=minimal" },
  250:       body: JSON.stringify(reviewPayload)
  251:     }, fetchImpl);
  252:   } else {
  253:     await request(`${config.url}/rest/v1/reviews`, {
  254:       method: "POST",
  255:       headers: { ...headers(config.anonKey, adminToken), prefer: "return=minimal" },
  256:       body: JSON.stringify({ submission_id: submissionId, ...reviewPayload })
  257:     }, fetchImpl);
  258:   }
  259: 
  260:   await request(`${config.url}/rest/v1/submissions?id=eq.${encodeURIComponent(submissionId)}`, {
  261:     method: "PATCH",
  262:     headers: { ...headers(config.anonKey, adminToken), prefer: "return=minimal" },
  263:     body: JSON.stringify({ status: review.status, updated_at: review.updated_at })
  264:   }, fetchImpl);
  265: }
