 295:       is_approximate_date, location_name, city, region, country, event_name,
 296:       media_link, media_consent,
 297:       status, created_at, updated_at
 298:     ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'UNREVIEWED', ?, ?)
 299:   `).run(
 300:     record.id,
 301:     record.personId,
 302:     JSON.stringify(record.original),
 303:     record.memoryPreview,
 304:     record.encounterDate,
