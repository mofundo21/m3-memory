  62: 
  63: /** 256 bits from the OS CSPRNG, unpadded base64url: exactly 43 characters. */
  64: export function generateToken() {
  65:   return randomBytes(32).toString("base64url");
  66: }
  67: 
  68: export function hashToken(token: string) {
  69:   return createHash("sha256").update(token).digest("hex");
  70: }
  71: 
  72: export function formatCookieValue(submissionId: string, token: string) {
  73:   return `${submissionId}.${token}`;
  74: }
  75: 
  76: /** Strict shape check before anything else. Returns null for every malformed value. */
  77: export function parseCookieValue(value: string | undefined): { submissionId: string; token: string } | null {
  78:   if (typeof value !== "string" || value.length !== 36 + 1 + 43) return null;
  79:   const submissionId = value.slice(0, 36);
  80:   const token = value.slice(37);
  81:   if (value[36] !== ".") return null;
  82:   if (!isCanonicalSubmissionId(submissionId) || !TOKEN_SHAPE.test(token)) return null;
  83:   return { submissionId, token };
  84: }
  85: 
  86: /** Issue a capability for a just-created submission. Returns the raw token (for the cookie only). */
  87: export async function issueCapability(submissionId: string, now: Date) {
  88:   const token = generateToken();
  89:   const expiresAt = new Date(now.getTime() + CONTRIBUTOR_CAPABILITY_TTL_SECONDS * 1000).toISOString();
  90:   await storeContributorCapability(submissionId, hashToken(token), expiresAt);
  91:   return token;
  92: }
  93: 
  94: /**
  95:  * Redeem a capability for one save. The SID comes from the parsed cookie, must equal the submission id the caller
  96:  * names, and is the only id used for database predicates. Consume happens before the save.
  97:  */
  98: export async function redeemCapability(submissionId: string, cookieValue: string | undefined, prefs: ContributorPreferences, now: Date) {
  99:   const parsed = parseCookieValue(cookieValue);
 100:   if (!parsed || parsed.submissionId !== submissionId) {
 101:     logContributorEvent("redeem-rejected");
 102:     return false;
 103:   }
 104:   const consumed = await consumeContributorCapability(parsed.submissionId, hashToken(parsed.token), now.toISOString());
 105:   if (!consumed) {
 106:     logContributorEvent("redeem-rejected");
 107:     return false;
 108:   }
 109:   const saved = await saveContributorPreferences(parsed.submissionId, prefs);
 110:   if (!saved) logContributorEvent("redeem-rejected");
 111:   return saved;
 112: }
 113: 
 114: /** Build the four-field allowlist from untrusted form data. Every other key is ignored. */
 115: export function sanitizePreferences(form: Record<string, unknown>): ContributorPreferences {
 116:   const text = (value: unknown, max: number) => {
 117:     const s = typeof value === "string" ? value.trim() : "";
 118:     return s ? s.slice(0, max) : null;
 119:   };
 120:   const choice = typeof form.attributionPreference === "string" ? form.attributionPreference : "";
 121:   return {
 122:     attributionPreference: ATTRIBUTION_CHOICES.has(choice) ? choice : "anonymous",
 123:     preferredAttribution: text(form.preferredAttribution, 240),
 124:     bookNote: text(form.bookNote, 4000),
 125:     finalNotes: text(form.finalNotes, 4000)
 126:   };
 127: }

