 113: 
 114:   // 8. Local store: issue, consume once, replay refused, save guarded by status, expiry enforced in the statement.
 115:   const created = await db.createSubmission({
 116:     submitterName: "Fictional Tester", contact: "", encounterDate: "", isApproximateDate: false, locationName: "",
 117:     city: "", region: "", country: "", eventName: "", howMet: "", memoryText: "Fictional memory for capability tests.",
 118:     beforeText: "", afterText: "", metAgain: "", peoplePresent: "", yerielWearing: "", submitterWearing: "",
 119:     talkedAbout: "", exchanged: "", artifactInfo: "", forgottenPrompt: "", bookPagePrompt: "", additionalComments: "",
 120:     mediaLink: "", mediaConsent: false,
