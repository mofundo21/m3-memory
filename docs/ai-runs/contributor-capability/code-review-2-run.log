  66:     good.replace(SID, SID.toUpperCase()), good.replace(SID, "not-a-uuid-value-here-xxxxxxxxxxxxxx"),
  67:     `${SID}.${"+".repeat(43)}`, `${SID}.${"a".repeat(42)}`, `${SID}.${"a".repeat(44)}`, `${SID}.${sample}.extra`,
