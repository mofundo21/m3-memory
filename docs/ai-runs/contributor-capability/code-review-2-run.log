 634: // ---- Contributor capability store (dispatches by persistence mode). Used only by src/lib/contributorCapability.ts. ----
 635: 
 636: export async function storeContributorCapability(submissionId: string, tokenHash: string, expiresAt: string) {
 637:   if (getPersistenceMode() === "supabase") {
 638:     await insertSupabaseCapability(submissionId, tokenHash, expiresAt);
 639:     return;
 640:   }
 641:   getDb().prepare("INSERT INTO contributor_capabilities (submission_id, token_hash, expires_at) VALUES (?, ?, ?)").run(submissionId, tokenHash, expiresAt);
 642: }
 643: 
 644: /** Atomic consume. True only if exactly one unexpired row matched and was deleted. */
 645: export async function consumeContributorCapability(submissionId: string, tokenHash: string, nowIso: string) {
 646:   if (getPersistenceMode() === "supabase") {
 647:     return consumeSupabaseCapability(submissionId, tokenHash, nowIso);
 648:   }
 649:   const rows = getDb()
 650:     .prepare("DELETE FROM contributor_capabilities WHERE submission_id = ? AND token_hash = ? AND expires_at > ? RETURNING submission_id")
 651:     .all(submissionId, tokenHash, nowIso);
 652:   return rows.length === 1 && (rows[0] as { submission_id: string }).submission_id === submissionId;
 653: }
 654: 
 655: /** Guarded save of the four contributor-owned fields. True only if exactly the one UNREVIEWED row changed. */
 656: export async function saveContributorPreferences(
 657:   submissionId: string,
 658:   fields: { attributionPreference: string; preferredAttribution: string | null; bookNote: string | null; finalNotes: string | null }
 659: ) {
 660:   if (getPersistenceMode() === "supabase") {
 661:     return saveSupabaseContributorPreferences(submissionId, fields);
 662:   }
 663:   const result = getDb()
 664:     .prepare(`UPDATE submissions SET attribution_preference = ?, preferred_attribution = ?, book_note = ?, final_notes = ?, updated_at = ?
 665:               WHERE id = ? AND status = 'UNREVIEWED'`)
 666:     .run(fields.attributionPreference, fields.preferredAttribution, fields.bookNote, fields.finalNotes, now(), submissionId);
 667:   return Number(result.changes) === 1;
 668: }
 669: 
 670: /** Compensation for a failed creation. Best effort; the caller logs a category, never the ids. */
 671: export async function deleteSubmissionRecords(submissionId: string, personId: string) {
 672:   if (getPersistenceMode() === "supabase") {
 673:     await deleteSupabaseSubmissionRecords(submissionId, personId);
 674:     return;
 675:   }
 676:   const db = getDb();
 677:   db.prepare("DELETE FROM contributor_capabilities WHERE submission_id = ?").run(submissionId);
 678:   db.prepare("DELETE FROM submissions WHERE id = ?").run(submissionId);
 679:   db.prepare("DELETE FROM persons WHERE id = ? AND NOT EXISTS (SELECT 1 FROM submissions WHERE submitter_person_id = persons.id)").run(personId);
 680: }

