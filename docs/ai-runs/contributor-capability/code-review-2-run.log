  18: export const CONTRIBUTOR_CAPABILITY_TTL_SECONDS = 2 * 60 * 60;
  19: 
  20: /** The one public error for every failure. Internal detail is never interpolated into it. */
  21: export const CONTRIBUTOR_ERROR_MESSAGE = "Preferences could not be saved. Please start again from the beginning.";
  22: 
  23: const CANONICAL_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
