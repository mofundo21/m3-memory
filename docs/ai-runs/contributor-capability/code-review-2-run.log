 102:   assert.equal(dirty.attributionPreference, "anonymous", "unknown attribution becomes anonymous");
 103:   assert.equal(dirty.preferredAttribution.length, 240, "preferred attribution is capped");
 104:   assert.equal(dirty.bookNote, "note", "book note is trimmed");
