 128:   assert.equal(await cap.redeemCapability(created.id, cookie, { ...prefs, finalNotes: "Replay." }, now), false, "replay refused");
 129: 
 130:   // Expiry: a capability past its expiry cannot be consumed, even with the right token.
 131:   // One capability per submission (the table's primary key), so each case gets its own submission.
 132:   const expiredSub = await makeSubmission("expired");
