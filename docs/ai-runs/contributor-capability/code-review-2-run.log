  48: /**
  49:  * Cookie attributes. Clearing uses the same name, path and security attributes, plus an epoch expiry, so the
  50:  * browser removes the cookie it set (a deletion with a different path does not remove it).
  51:  */
  52: export function cookieOptions(maxAge = CONTRIBUTOR_CAPABILITY_TTL_SECONDS) {
  53:   return {
  54:     httpOnly: true,
  55:     sameSite: "strict" as const,
  56:     secure: process.env.NODE_ENV === "production",
