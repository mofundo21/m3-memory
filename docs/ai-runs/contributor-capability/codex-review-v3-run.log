 231: function normalizeReview(input: ReviewInput): NormalizedReview {
 232:   requireStatus(input.status);
 233:   return {
 234:     status: input.status,
 235:     notes: optionalText(input.notes) ?? null,
 236:     remembered: optionalText(input.remembered) ?? null,
 237:     corrections: optionalText(input.corrections) ?? null,
 238:     context: optionalText(input.context) ?? null,
 239:     people: optionalText(input.people, 1000) ?? null,
 240:     tags: optionalText(input.tags, 1000) ?? null,
 241:     importance: rating(input.importance),
 242:     emotional_significance: rating(input.emotionalSignificance),
 243:     historical_significance: rating(input.historicalSignificance),
 244:     accuracy_confidence: rating(input.accuracyConfidence),
 245:     book_potential: rating(input.bookPotential),
 246:     chapter_category: optionalText(input.chapterCategory, 240) ?? null,
 247:     private_notes: optionalText(input.privateNotes) ?? null,
 248:     updated_at: now()
 249:   };
 250: }
