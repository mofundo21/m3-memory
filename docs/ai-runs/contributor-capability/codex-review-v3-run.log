 575: export interface Act3UpdateInput {
 576:   attributionPreference?: string;
 577:   preferredAttribution?: string;
 578:   bookNote?: string;
 579:   finalNotes?: string;
 580: }
 581: 
 582: export async function updateSubmissionPreferences(submissionId: string, input: Act3UpdateInput, adminToken?: string | null) {
 583:   if (getPersistenceMode() === "supabase") {
 584:     const token = requireSupabaseAdminToken(adminToken);
 585:     await updateSupabaseSubmissionPreferences(submissionId, input, token);
 586:     return;
 587:   }
 588: 
 589:   const db = getDb();
 590:   const updatedAt = now();
 591: 
 592:   db.prepare(`
 593:     UPDATE submissions SET
 594:       attribution_preference = ?,
 595:       preferred_attribution = ?,
 596:       book_note = ?,
 597:       final_notes = ?,
 598:       updated_at = ?
 599:     WHERE id = ?
 600:   `).run(
 601:     input.attributionPreference || "anonymous",
 602:     optionalText(input.preferredAttribution, 240) ?? null,
 603:     optionalText(input.bookNote, 4000) ?? null,
 604:     optionalText(input.finalNotes, 4000) ?? null,
 605:     updatedAt,
 606:     submissionId
 607:   );
 608: }

