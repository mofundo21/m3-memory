 348: export async function updateSupabaseSubmissionPreferences(submissionId: string, preferences: { attributionPreference?: string; preferredAttribution?: string; bookNote?: string; finalNotes?: string }, adminToken: string, fetchImpl: FetchLike = fetch) {
 349:   const config = getSupabaseConfig(false);
 350:   const updatedAt = new Date().toISOString();
 351: 
 352:   const payload = {
 353:     attribution_preference: preferences.attributionPreference || "anonymous",
 354:     preferred_attribution: preferences.preferredAttribution || null,
 355:     book_note: preferences.bookNote || null,
 356:     final_notes: preferences.finalNotes || null,
 357:     updated_at: updatedAt
 358:   };
 359: 
 360:   await request(`${config.url}/rest/v1/submissions?id=eq.${encodeURIComponent(submissionId)}`, {
 361:     method: "PATCH",
 362:     headers: { ...headers(config.anonKey, adminToken), prefer: "return=minimal" },
 363:     body: JSON.stringify(payload)
 364:   }, fetchImpl);
 365: }

===== src/lib/auth.ts =====
   1: import "server-only";
   2: import { cookies } from "next/headers";
   3: import { createHash, timingSafeEqual } from "node:crypto";
   4: import {
   5:   getAdminAuthMode,
   6:   getPersistenceMode,
   7:   isSupabaseAdmin,
   8:   requireCompatibleAuthMode,
   9:   supabasePasswordLogin,
  10:   verifySupabaseAdminToken,
  11:   type LoginResult
  12: } from "./supabase";
  13: 
  14: const localCookieName = "m3_memory_session";
  15: const supabaseCookieName = "m3_memory_admin_token";
  16: 
  17: function secret() {
  18:   if (process.env.SESSION_SECRET) return process.env.SESSION_SECRET;
  19:   if (process.env.NODE_ENV === "production") throw new Error("SESSION_SECRET_REQUIRED");
  20:   return "local-development-secret";
  21: }
  22: 
  23: function digest(value: string) {
  24:   return createHash("sha256").update(`${value}:${secret()}`).digest("hex");
  25: }
  26: 
  27: function expectedPassword() {
  28:   if (process.env.ADMIN_PASSWORD) return process.env.ADMIN_PASSWORD;
  29:   if (process.env.NODE_ENV === "production") return null;
  30:   return "change-this-local-password";
  31: }
  32: 
  33: export { getAdminAuthMode };
  34: 
  35: function isLocalAdminCookie(value?: string) {
  36:   return value === digest("admin");
  37: }
  38: 
  39: export async function getAdminToken() {
  40:   if (getPersistenceMode() === "supabase") requireCompatibleAuthMode();
  41:   if (getAdminAuthMode() === "local") return null;
  42:   const jar = await cookies();
  43:   const token = jar.get(supabaseCookieName)?.value;
  44:   if (!token) return null;
  45:   const session = await verifySupabaseAdminToken(token).catch(() => null);
  46:   return session?.accessToken || null;
  47: }
  48: 
  49: export async function isAdminAuthenticated() {
  50:   if (getPersistenceMode() === "supabase") requireCompatibleAuthMode();
  51:   const jar = await cookies();
  52: 
  53:   if (getAdminAuthMode() === "local") {
  54:     return isLocalAdminCookie(jar.get(localCookieName)?.value);
  55:   }
  56: 
  57:   const token = jar.get(supabaseCookieName)?.value;
  58:   if (!token) return false;
  59:   return Boolean(await verifySupabaseAdminToken(token).catch(() => null));
  60: }
  61: 
  62: export async function requireAdmin() {
  63:   if (getPersistenceMode() === "supabase") requireCompatibleAuthMode();
  64: 
  65:   if (getAdminAuthMode() === "local") {
  66:     if (!(await isAdminAuthenticated())) throw new Error("UNAUTHENTICATED");
  67:     return null;
  68:   }
  69: 
  70:   const token = await getAdminToken();
  71:   if (!token) throw new Error("UNAUTHENTICATED");
  72:   return token;
  73: }
  74: 
  75: export async function login(emailOrPassword: string, maybePassword?: string): Promise<LoginResult> {
  76:   if (getPersistenceMode() === "supabase") requireCompatibleAuthMode();
  77: 
  78:   const jar = await cookies();
  79: 
  80:   if (getAdminAuthMode() === "local") {
  81:     const expected = expectedPassword();
  82:     if (!expected) return "invalid";
  83: 
  84:     const a = Buffer.from(maybePassword ?? emailOrPassword);
  85:     const b = Buffer.from(expected);
  86:     const ok = a.length === b.length && timingSafeEqual(a, b);
  87: 
  88:     if (!ok) return "invalid";
  89: 
  90:     jar.set(localCookieName, digest("admin"), {
  91:       httpOnly: true,
  92:       sameSite: "strict",
  93:       secure: process.env.NODE_ENV === "production",
  94:       path: "/",
  95:       maxAge: 60 * 60 * 2
  96:     });
  97:     return "ok";
  98:   }
  99: 
 100:   const existingToken = jar.get(supabaseCookieName)?.value;
 101:   if (existingToken && !(await verifySupabaseAdminToken(existingToken).catch(() => null))) {
 102:     jar.delete(supabaseCookieName);
 103:     return "expired";
 104:   }
 105: 
 106:   const session = await supabasePasswordLogin(emailOrPassword, maybePassword || "");
 107:   if (!session) return "invalid";
 108:   if (!(await isSupabaseAdmin(session.accessToken))) return "unauthorized";
 109: 
 110:   jar.set(supabaseCookieName, session.accessToken, {
 111:     httpOnly: true,
 112:     sameSite: "strict",
 113:     secure: process.env.NODE_ENV === "production",
 114:     path: "/",
 115:     maxAge: 60 * 60
 116:   });
 117:   return "ok";
 118: }
 119: 
 120: export async function logout() {
 121:   const jar = await cookies();
 122:   jar.delete(localCookieName);
 123:   jar.delete(supabaseCookieName);
 124: }
