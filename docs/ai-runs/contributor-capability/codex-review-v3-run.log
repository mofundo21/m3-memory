  62: export function hasSupabaseEnv() {
  63:   return Boolean(process.env.NEXT_PUBLIC_SUPABASE_URL || process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || process.env.SUPABASE_SERVICE_ROLE_KEY);
  64: }
  65: 
  66: export function getPersistenceMode() {
  67:   const explicit = process.env.M3_PERSISTENCE;
  68:   if (explicit === "sqlite" || explicit === "supabase") return explicit;
  69:   return hasSupabaseEnv() ? "supabase" : "sqlite";
  70: }
  71: 
  72: export function getAdminAuthMode() {
  73:   const explicit = process.env.M3_ADMIN_AUTH;
  74:   if (explicit === "local" || explicit === "supabase") return explicit;
  75:   return hasSupabaseEnv() ? "supabase" : "local";
  76: }
  77: 
  78: export function requireCompatibleAuthMode() {
  79:   if (getPersistenceMode() === "supabase" && getAdminAuthMode() !== "supabase") {
  80:     throw new Error("SUPABASE_MISCONFIGURED");
  81:   }
  82: }
  83: 
  84: export function getSupabaseConfig(requireServiceRole = true): SupabaseConfig {
  85:   const url = process.env.NEXT_PUBLIC_SUPABASE_URL?.replace(/\/+$/, "") || "";
  86:   const anonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || "";
  87:   const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY || "";
  88: 
  89:   if (!url || !anonKey || (requireServiceRole && !serviceRoleKey)) {
  90:     throw new Error("SUPABASE_MISCONFIGURED");
  91:   }
  92: 
  93:   return { url, anonKey, serviceRoleKey };
  94: }
  95: 
  96: function headers(apiKey: string, bearer = apiKey) {
  97:   return {
  98:     apikey: apiKey,
  99:     authorization: `Bearer ${bearer}`,
 100:     "content-type": "application/json"
 101:   };
 102: }
 103: 
 104: async function readJson(res: Response) {
 105:   const text = await res.text();
 106:   return text ? JSON.parse(text) : null;
 107: }
 108: 
 109: async function request(path: string, init: RequestInit, fetchImpl: FetchLike = fetch) {
 110:   const res = await fetchImpl(path, init);
 111:   if (!res.ok) {
 112:     const error = new Error(res.status === 401 ? "UNAUTHENTICATED" : `SUPABASE_REQUEST_FAILED:${res.status}`);
 113:     (error as Error & { status?: number }).status = res.status;
 114:     throw error;
 115:   }
 116:   return readJson(res);
 117: }
