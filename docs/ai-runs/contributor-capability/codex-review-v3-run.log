 327:   }));
 328: 
 329:   await request(`${config.url}/rest/v1/media`, {
 330:     method: "POST",
 331:     headers: { ...headers(config.anonKey, adminToken), prefer: "return=minimal" },
 332:     body: JSON.stringify(mediaRows)
