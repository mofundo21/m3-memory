 539: export async function insertMediaRows(submissionId: string, files: Array<{ fileName: string; mimeType: string; sizeBytes: number; storagePath: string }>, adminToken?: string | null) {
 540:   if (getPersistenceMode() === "supabase") {
 541:     const token = requireSupabaseAdminToken(adminToken);
 542:     return insertSupabaseMediaRows(submissionId, files, token);
 543:   }
 544: 
 545:   const db = getDb();
 546:   const createdAt = now();
 547: 
 548:   for (const file of files) {
 549:     db.prepare(`
 550:       INSERT INTO media (id, submission_id, file_name, mime_type, storage_path, size_bytes, created_at)
 551:       VALUES (?, ?, ?, ?, ?, ?, ?)
 552:     `).run(
 553:       randomUUID(),
 554:       submissionId,
 555:       file.fileName,
 556:       file.mimeType,
 557:       file.storagePath,
 558:       file.sizeBytes,
 559:       createdAt
 560:     );
 561:   }
 562: }
