 212: export async function getSupabaseSubmission(id: string, adminToken: string, fetchImpl: FetchLike = fetch) {
 213:   const config = getSupabaseConfig(false);
 214:   const rows = await request(`${config.url}/rest/v1/submissions?select=*,persons(display_name,contact),reviews(*)&id=eq.${encodeURIComponent(id)}&limit=1`, {
 215:     method: "GET",
 216:     headers: headers(config.anonKey, adminToken)
