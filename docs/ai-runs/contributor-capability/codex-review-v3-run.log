 119: export async function supabasePasswordLogin(email: string, password: string, fetchImpl: FetchLike = fetch) {
 120:   const config = getSupabaseConfig(false);
 121:   const data = await request(`${config.url}/auth/v1/token?grant_type=password`, {
 122:     method: "POST",
 123:     headers: headers(config.anonKey),
 124:     body: JSON.stringify({ email, password })
 125:   }, fetchImpl).catch((error) => {
 126:     if ((error as Error & { status?: number }).status === 400 || (error as Error & { status?: number }).status === 401) return null;
 127:     throw error;
 128:   }) as any;
 129: 
 130:   if (!data?.access_token || !data?.user?.id) return null;
 131:   return {
 132:     accessToken: String(data.access_token),
 133:     userId: String(data.user.id),
 134:     email: String(data.user.email || email)
 135:   };
 136: }
 137: 
 138: export async function getSupabaseUser(accessToken: string, fetchImpl: FetchLike = fetch) {
 139:   const config = getSupabaseConfig(false);
 140:   const data = await request(`${config.url}/auth/v1/user`, {
 141:     method: "GET",
 142:     headers: headers(config.anonKey, accessToken)
 143:   }, fetchImpl).catch(() => null) as any;
 144: 
 145:   if (!data?.id) return null;
 146:   return { userId: String(data.id), email: String(data.email || "") };
 147: }
