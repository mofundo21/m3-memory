 149: export async function isSupabaseAdmin(accessToken: string, fetchImpl: FetchLike = fetch) {
 150:   const config = getSupabaseConfig(false);
 151:   const rows = await request(`${config.url}/rest/v1/m3_admins?select=id&limit=1`, {
 152:     method: "GET",
 153:     headers: headers(config.anonKey, accessToken)
 154:   }, fetchImpl).catch(() => []) as any[];
 155:   return Array.isArray(rows) && rows.length > 0;
 156: }
 157: 
 158: export async function verifySupabaseAdminToken(accessToken: string, fetchImpl: FetchLike = fetch) {
 159:   const user = await getSupabaseUser(accessToken, fetchImpl);
 160:   if (!user) return null;
 161:   if (!(await isSupabaseAdmin(accessToken, fetchImpl))) return null;
 162:   return { accessToken, ...user } satisfies SupabaseAdminSession;
 163: }
