   35: function isLocalAdminCookie(value?: string) {
   36:   return value === digest("admin");
   37: }
   38: 
   39: export async function getAdminToken() {
   40:   if (getPersistenceMode() === "supabase") requireCompatibleAuthMode();
   41:   if (getAdminAuthMode() === "local") return null;
   42:   const jar = await cookies();
   43:   const token = jar.get(supabaseCookieName)?.value;
   44:   if (!token) return null;
   45:   const session = await verifySupabaseAdminToken(token).catch(() => null);
