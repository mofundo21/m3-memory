  150: function now() {
  151:   return new Date().toISOString();
  152: }
  153: 
  154: function text(value: string | undefined, max = 4000) {
  155:   return (value || "").trim().slice(0, max);
  156: }
  157: 
  158: function optionalText(value: string | undefined, max = 4000): string | undefined {
  159:   const cleaned = text(value, max);
  160:   return cleaned || undefined;
  161: }
  162: 
  163: function rating(value: number | undefined): number | null {
  164:   const n = value ?? 0;
  165:   return Number.isInteger(n) && n >= 1 && n <= 5 ? n : null;
  166: }
  167: 
  168: function requireStatus(status: SubmissionStatus) {
  169:   if (!submissionStatuses.includes(status)) {
  170:     throw new Error("INVALID_STATUS");
  171:   }
  172: }
  173: 
  174: function normalizeSubmission(input: SubmissionInput): NormalizedSubmission {
  175:   const createdAt = now();
  176:   const submitterName = text(input.submitterName, 160);
  177:   const memoryText = text(input.memoryText, 12000);
  178: 
  179:   if (!submitterName || !memoryText) {
  180:     throw new Error("INVALID_SUBMISSION");
  181:   }
  182: 
  183:   const original: SubmissionInput = {
  184:     submitterName,
  185:     contact: text(input.contact, 240),
  186:     encounterDate: text(input.encounterDate, 40),
  187:     isApproximateDate: Boolean(input.isApproximateDate),
  188:     locationName: text(input.locationName, 240),
  189:     city: text(input.city, 120),
  190:     region: text(input.region, 120),
  191:     country: text(input.country, 120),
  192:     eventName: text(input.eventName, 240),
  193:     howMet: text(input.howMet, 4000),
  194:     memoryText,
  195:     beforeText: text(input.beforeText, 4000),
  196:     afterText: text(input.afterText, 4000),
  197:     metAgain: text(input.metAgain, 4000),
  198:     peoplePresent: text(input.peoplePresent, 4000),
  199:     yerielWearing: text(input.yerielWearing, 2000),
  200:     submitterWearing: text(input.submitterWearing, 2000),
  201:     talkedAbout: text(input.talkedAbout, 4000),
  202:     exchanged: text(input.exchanged, 2000),
  203:     artifactInfo: text(input.artifactInfo, 4000),
  204:     forgottenPrompt: text(input.forgottenPrompt, 4000),
  205:     bookPagePrompt: text(input.bookPagePrompt, 4000),
  206:     additionalComments: text(input.additionalComments, 4000),
  207:     mediaLink: text(input.mediaLink, 500),
  208:     mediaConsent: Boolean(input.mediaConsent),
  209:     attributionPreference: input.attributionPreference || "anonymous",
  210:     preferredAttribution: text(input.preferredAttribution, 240) || undefined,
  211:     bookNote: text(input.bookNote, 4000) || undefined,
  212:     finalNotes: text(input.finalNotes, 4000) || undefined
  213:   };
  214: 
  215:   return {
  216:     id: randomUUID(),
  217:     personId: randomUUID(),
  218:     original,
  219:     memoryPreview: memoryText.slice(0, 220),
  220:     encounterDate: optionalText(original.encounterDate, 40) ?? null,
  221:     isApproximateDate: original.isApproximateDate || false,
  222:     locationName: optionalText(original.locationName, 240) ?? null,
  223:     city: optionalText(original.city, 120) ?? null,
  224:     region: optionalText(original.region, 120) ?? null,
  225:     country: optionalText(original.country, 120) ?? null,
  226:     eventName: optionalText(original.eventName, 240) ?? null,
  227:     createdAt
  228:   };
  229: }
  230: 
  231: function normalizeReview(input: ReviewInput): NormalizedReview {
  232:   requireStatus(input.status);
  233:   return {
  234:     status: input.status,
  235:     notes: optionalText(input.notes) ?? null,
  236:     remembered: optionalText(input.remembered) ?? null,
  237:     corrections: optionalText(input.corrections) ?? null,
  238:     context: optionalText(input.context) ?? null,
  239:     people: optionalText(input.people, 1000) ?? null,
  240:     tags: optionalText(input.tags, 1000) ?? null,
  241:     importance: rating(input.importance),
  242:     emotional_significance: rating(input.emotionalSignificance),
  243:     historical_significance: rating(input.historicalSignificance),
  244:     accuracy_confidence: rating(input.accuracyConfidence),
  245:     book_potential: rating(input.bookPotential),
  246:     chapter_category: optionalText(input.chapterCategory, 240) ?? null,
  247:     private_notes: optionalText(input.privateNotes) ?? null,
  248:     updated_at: now()
  249:   };
  250: }
