    1: -- M3 Memory V0.1 production Supabase schema.
    2: -- Apply only to a new empty Supabase project. Do not import old memories or lore.
    3: 
    4: create extension if not exists pgcrypto;
    5: 
    6: create table if not exists public.m3_admins (
    7:   id uuid primary key default gen_random_uuid(),
    8:   user_id uuid unique,
    9:   email text unique,
   10:   created_at timestamptz not null default now(),
   11:   check (user_id is not null or email is not null)
   12: );
   13: 
   14: create table if not exists public.persons (
   15:   id uuid primary key default gen_random_uuid(),
   16:   display_name text not null,
   17:   contact text,
   18:   created_at timestamptz not null default now()
   19: );
   20: 
   21: create table if not exists public.submissions (
   22:   id uuid primary key default gen_random_uuid(),
   23:   submitter_person_id uuid references public.persons(id),
   24:   original_json jsonb not null,
   25:   memory_preview text not null,
   26:   encounter_date text,
   27:   is_approximate_date boolean not null default false,
   28:   location_name text,
   29:   city text,
   30:   region text,
   31:   country text,
   32:   event_name text,
   33:   media_link text,
   34:   media_consent boolean not null default false,
   35:   attribution_preference text default 'anonymous',
   36:   preferred_attribution text,
   37:   book_note text,
   38:   final_notes text,
   39:   status text not null default 'UNREVIEWED' check (status in ('UNREVIEWED', 'IN_REVIEW', 'REVIEWED', 'APPROVED_FOR_STORY', 'REJECTED', 'ARCHIVED')),
   40:   created_at timestamptz not null default now(),
   41:   updated_at timestamptz not null default now()
   42: );
   43: 
   44: create table if not exists public.reviews (
   45:   id uuid primary key default gen_random_uuid(),
   46:   submission_id uuid not null unique references public.submissions(id) on delete cascade,
   47:   notes text,
   48:   remembered text,
   49:   corrections text,
   50:   context text,
   51:   people text,
   52:   tags text,
   53:   importance integer check (importance between 1 and 5),
   54:   emotional_significance integer check (emotional_significance between 1 and 5),
   55:   historical_significance integer check (historical_significance between 1 and 5),
   56:   accuracy_confidence integer check (accuracy_confidence between 1 and 5),
   57:   book_potential integer check (book_potential between 1 and 5),
   58:   chapter_category text,
   59:   private_notes text,
   60:   created_at timestamptz not null default now(),
   61:   updated_at timestamptz not null default now()
   62: );
   63: 
   64: create table if not exists public.media (
   65:   id uuid primary key default gen_random_uuid(),
   66:   submission_id uuid not null references public.submissions(id) on delete cascade,
   67:   file_name text not null,
   68:   mime_type text not null,
   69:   storage_path text not null,
   70:   size_bytes bigint not null,
   71:   created_at timestamptz not null default now()
   72: );
   73: 
   74: create table if not exists public.artifacts (
   75:   id uuid primary key default gen_random_uuid(),
   76:   submission_id uuid not null references public.submissions(id) on delete cascade,
   77:   label text not null,
   78:   notes text,
   79:   created_at timestamptz not null default now()
   80: );
   81: 
   82: create table if not exists public.story_drafts (
   83:   id uuid primary key default gen_random_uuid(),
   84:   submission_id uuid not null references public.submissions(id) on delete cascade,
   85:   label text not null default 'AI-GENERATED DRAFT',
   86:   draft_text text not null,
   87:   approved_at timestamptz,
   88:   created_at timestamptz not null default now()
   89: );
   90: 
   91: create index if not exists idx_m3_admins_user_id on public.m3_admins(user_id);
   92: create index if not exists idx_m3_admins_email on public.m3_admins(email);
   93: create index if not exists idx_submissions_status on public.submissions(status);
   94: create index if not exists idx_submissions_created_at on public.submissions(created_at desc);
   95: create index if not exists idx_reviews_submission_id on public.reviews(submission_id);
   96: 
   97: create or replace function public.is_m3_admin()
   98: returns boolean
   99: language sql
  100: security definer
  101: set search_path = public
  102: as $$
  103:   select exists (
  104:     select 1
  105:     from public.m3_admins
  106:     where user_id = auth.uid()
  107:        or lower(email) = lower(auth.jwt()->>'email')
  108:   );
  109: $$;
  110: 
  111: create or replace function public.trigger_update_updated_at()
  112: returns trigger
  113: language plpgsql
  114: set search_path = public
  115: as $$
  116: begin
  117:   new.updated_at = now();
  118:   return new;
  119: end;
  120: $$;
  121: 
  122: drop trigger if exists update_submissions_updated_at on public.submissions;
  123: create trigger update_submissions_updated_at
  124: before update on public.submissions
  125: for each row execute function public.trigger_update_updated_at();
  126: 
  127: drop trigger if exists update_reviews_updated_at on public.reviews;
  128: create trigger update_reviews_updated_at
  129: before update on public.reviews
  130: for each row execute function public.trigger_update_updated_at();
  131: 
  132: alter table public.m3_admins enable row level security;
  133: alter table public.persons enable row level security;
  134: alter table public.submissions enable row level security;
  135: alter table public.reviews enable row level security;
  136: alter table public.media enable row level security;
  137: alter table public.artifacts enable row level security;
  138: alter table public.story_drafts enable row level security;
  139: 
  140: revoke all on public.m3_admins from anon, authenticated;
  141: revoke all on public.persons from anon, authenticated;
  142: revoke all on public.submissions from anon, authenticated;
  143: revoke all on public.reviews from anon, authenticated;
  144: revoke all on public.media from anon, authenticated;
  145: revoke all on public.artifacts from anon, authenticated;
  146: revoke all on public.story_drafts from anon, authenticated;
  147: 
  148: grant select on public.m3_admins to authenticated;
  149: grant select on public.persons to authenticated;
  150: grant select on public.submissions to authenticated;
  151: grant update(status, updated_at) on public.submissions to authenticated;
  152: grant insert, select on public.reviews to authenticated;
  153: grant update(
  154:   notes,
  155:   remembered,
  156:   corrections,
  157:   context,
  158:   people,
  159:   tags,
  160:   importance,
  161:   emotional_significance,
  162:   historical_significance,
  163:   accuracy_confidence,
  164:   book_potential,
  165:   chapter_category,
  166:   private_notes,
  167:   updated_at
  168: ) on public.reviews to authenticated;
  169: grant insert, select, update on public.story_drafts to authenticated;
  170: 
  171: create policy admin_read_allowlist on public.m3_admins
  172: for select to authenticated
  173: using (public.is_m3_admin());
  174: 
  175: create policy admin_read_persons on public.persons
  176: for select to authenticated
  177: using (public.is_m3_admin());
  178: 
  179: create policy admin_read_submissions on public.submissions
  180: for select to authenticated
  181: using (public.is_m3_admin());
  182: 
  183: create policy admin_update_submission_status on public.submissions
  184: for update to authenticated
  185: using (public.is_m3_admin())
  186: with check (public.is_m3_admin());
  187: 
  188: create policy admin_read_reviews on public.reviews
  189: for select to authenticated
  190: using (public.is_m3_admin());
  191: 
  192: create policy admin_insert_reviews on public.reviews
  193: for insert to authenticated
  194: with check (public.is_m3_admin());
  195: 
  196: create policy admin_update_reviews on public.reviews
  197: for update to authenticated
  198: using (public.is_m3_admin())
  199: with check (public.is_m3_admin());
  200: 
  201: create policy admin_read_story_drafts on public.story_drafts
  202: for select to authenticated
  203: using (public.is_m3_admin());
  204: 
  205: create policy admin_insert_story_drafts on public.story_drafts
  206: for insert to authenticated
  207: with check (public.is_m3_admin());
  208: 
  209: create policy admin_update_story_drafts on public.story_drafts
  210: for update to authenticated
  211: using (public.is_m3_admin())
  212: with check (public.is_m3_admin());
  213: 
  214: create policy admin_read_media on public.media
  215: for select to authenticated
  216: using (public.is_m3_admin());
  217: 
  218: -- No anon policies are created. Public submissions and media are inserted only through the
  219: -- Next.js server path with SUPABASE_SERVICE_ROLE_KEY (which bypasses RLS). Media and story drafts are admin-only
  220: -- and never accessible to anonymous or non-admin authenticated users. Media table defaults to default-deny
  221: -- (RLS enabled, no insert/update/delete grants to any role, insert through service role only).
