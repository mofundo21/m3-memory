    4: import { randomUUID } from "node:crypto";
    5: import { DatabaseSync } from "node:sqlite";
    6: import { submissionStatuses, type ReviewInput, type SubmissionInput, type SubmissionStatus } from "./types";
    7: import {
    8:   createSupabaseSubmission,
    9:   getPersistenceMode,
   10:   getSupabaseSubmission,
   11:   listSupabaseSubmissions,
   12:   upsertSupabaseReview,
