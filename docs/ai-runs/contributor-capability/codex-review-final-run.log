  513: // Media upload validation and persistence
  514: const MAX_FILE_SIZE_BYTES = 8 * 1024 * 1024; // 8 MB
  515: const MAX_FILES_PER_SUBMISSION = 5;
  516: const ALLOWED_MIME_TYPES = new Set(["image/jpeg", "image/png", "image/webp"]);
  517: 
  518: export interface MediaUploadInput {
  519:   fileName: string;
  520:   mimeType: string;
  521:   sizeBytes: number;
  522: }
  523: 
  524: export function validateMediaUpload(files: MediaUploadInput[]) {
  525:   if (files.length > MAX_FILES_PER_SUBMISSION) {
  526:     throw new Error("TOO_MANY_FILES");
  527:   }
  528: 
  529:   for (const file of files) {
  530:     if (!file.mimeType || !ALLOWED_MIME_TYPES.has(file.mimeType)) {
  531:       throw new Error("INVALID_MIME_TYPE");
  532:     }
  533:     if (file.sizeBytes > MAX_FILE_SIZE_BYTES) {
  534:       throw new Error("FILE_TOO_LARGE");
  535:     }
  536:   }
  537: }
  538: 
  539: export async function insertMediaRows(submissionId: string, files: Array<{ fileName: string; mimeType: string; sizeBytes: number; storagePath: string }>, adminToken?: string | null) {
  540:   if (getPersistenceMode() === "supabase") {
  541:     const token = requireSupabaseAdminToken(adminToken);
  542:     return insertSupabaseMediaRows(submissionId, files, token);
  543:   }
  544: 
  545:   const db = getDb();
  546:   const createdAt = now();
  547: 
  548:   for (const file of files) {
  549:     db.prepare(`
  550:       INSERT INTO media (id, submission_id, file_name, mime_type, storage_path, size_bytes, created_at)
  551:       VALUES (?, ?, ?, ?, ?, ?, ?)
  552:     `).run(
  553:       randomUUID(),
  554:       submissionId,
  555:       file.fileName,
  556:       file.mimeType,
  557:       file.storagePath,
  558:       file.sizeBytes,
  559:       createdAt
  560:     );
  561:   }
  562: }
