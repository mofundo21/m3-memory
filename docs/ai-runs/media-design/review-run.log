  218: -- No anon policies are created. Public submissions and media are inserted only through the
  219: -- Next.js server path with SUPABASE_SERVICE_ROLE_KEY (which bypasses RLS). Media and story drafts are admin-only
  220: -- and never accessible to anonymous or non-admin authenticated users. Media table defaults to default-deny
  221: -- (RLS enabled, no insert/update/delete grants to any role, insert through service role only).
  222: 
  223: -- ---------------------------------------------------------------------------------------------------------------
  224: -- Contributor write capability (docs/MUSEUM_CONTRIBUTOR_CAPABILITY_DESIGN.md). One row per submission with an open
  225: -- contributor window. Stores SHA-256(token) only, never the raw token. Readable and writable only by the service
  226: -- role, which the server uses from two narrow helpers. No policy and no grant exists for anon or authenticated.
  227: -- ---------------------------------------------------------------------------------------------------------------
  228: create table if not exists public.contributor_capabilities (
  229:   submission_id uuid primary key,
  230:   token_hash text not null,
  231:   expires_at timestamptz not null,
  232:   created_at timestamptz not null default now()
  233: );
  234: 
  235: create index if not exists contributor_capabilities_expires_idx on public.contributor_capabilities (expires_at);
  236: 
  237: alter table public.contributor_capabilities enable row level security;
  238: revoke all on public.contributor_capabilities from anon, authenticated;
  239: -- Deliberately no policies: no application role other than the server's service key may read or write this table.
  240: 
  241: -- Scheduled cleanup (open decision: scheduler). Removes expired capabilities and contributor person rows that no
  242: -- submission references. The 2-hour guard protects a person row that another request is creating right now.
  243: -- Executable only by the database owner or the service role, never by anon or authenticated.
  244: create or replace function public.contributor_purge_expired()
  245: returns integer
  246: language plpgsql
  247: security definer
  248: set search_path = public
  249: as $$
  250: declare
  251:   removed_capabilities integer := 0;
  252:   removed_people integer := 0;
  253: begin
  254:   delete from public.contributor_capabilities where expires_at < now();
  255:   get diagnostics removed_capabilities = row_count;
  256: 
  257:   delete from public.persons p
  258:    where p.created_at < now() - interval '2 hours'
  259:      and not exists (select 1 from public.submissions s where s.submitter_person_id = p.id);
  260:   get diagnostics removed_people = row_count;
  261: 
  262:   return removed_capabilities + removed_people;
  263: end;
  264: $$;
  265: 
  266: revoke all on function public.contributor_purge_expired() from public, anon, authenticated;
