  271: export async function createSubmission(input: SubmissionInput) {
  272:   const record = normalizeSubmission(input);
  273: 
  274:   if (getPersistenceMode() === "supabase") {
  275:     const id = await createSupabaseSubmission(record);
  276:     return { id, personId: record.personId };
  277:   }
  278: 
  279:   const db = getDb();
  280:   db.prepare("INSERT INTO persons (id, display_name, contact, created_at) VALUES (?, ?, ?, ?)").run(
  281:     record.personId,
  282:     record.original.submitterName,
  283:     optionalText(record.original.contact, 240) ?? null,
  284:     record.createdAt
  285:   );
  286: 
  287:   db.prepare(`
  288:     INSERT INTO submissions (
  289:       id, submitter_person_id, original_json, memory_preview, encounter_date,
  290:       is_approximate_date, location_name, city, region, country, event_name,
  291:       media_link, media_consent,
  292:       status, created_at, updated_at
  293:     ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'UNREVIEWED', ?, ?)
  294:   `).run(
  295:     record.id,
  296:     record.personId,
  297:     JSON.stringify(record.original),
  298:     record.memoryPreview,
  299:     record.encounterDate,
  300:     record.isApproximateDate ? 1 : 0,
  301:     record.locationName,
  302:     record.city,
  303:     record.region,
  304:     record.country,
  305:     record.eventName,
  306:     record.original.mediaLink || null,
  307:     record.original.mediaConsent ? 1 : 0,
  308:     record.createdAt,
  309:     record.createdAt
  310:   );
  311: 
  312:   return { id: record.id, personId: record.personId };
  313: }
