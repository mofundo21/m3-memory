  374: export async function getSubmission(id: string, adminToken?: string | null) {
  375:   if (getPersistenceMode() === "supabase") {
  376:     const row = await getSupabaseSubmission(id, requireSupabaseAdminToken(adminToken));
  377:     return row ? mapSupabaseDetail(row) : null;
  378:   }
  379: 
  380:   const db = getDb();
  381:   const submission = db.prepare(`
  382:     SELECT
  383:       submissions.*,
  384:       persons.display_name AS submitterName,
  385:       persons.contact AS contact
  386:     FROM submissions
  387:     LEFT JOIN persons ON persons.id = submissions.submitter_person_id
  388:     WHERE submissions.id = ?
  389:   `).get(id) as any;
  390: 
  391:   if (!submission) return null;
  392: 
  393:   const review = db.prepare("SELECT * FROM reviews WHERE submission_id = ?").get(id) || null;
  394:   return {
  395:     ...submission,
  396:     original: JSON.parse(submission.original_json),
  397:     review
  398:   };
  399: }
