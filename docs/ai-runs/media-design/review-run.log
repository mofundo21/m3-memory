  332: export async function listSubmissions(adminToken?: string | null) {
  333:   if (getPersistenceMode() === "supabase") {
  334:     const rows = await listSupabaseSubmissions(requireSupabaseAdminToken(adminToken));
  335:     return rows.map(mapSupabaseListItem);
  336:   }
  337: 
  338:   const db = getDb();
  339:   return db.prepare(`
  340:     SELECT
  341:       submissions.id,
  342:       submissions.status,
  343:       submissions.memory_preview AS memoryPreview,
  344:       submissions.encounter_date AS encounterDate,
  345:       submissions.location_name AS locationName,
  346:       submissions.city,
  347:       submissions.region,
  348:       submissions.country,
  349:       submissions.event_name AS eventName,
  350:       submissions.created_at AS createdAt,
  351:       persons.display_name AS submitterName
  352:     FROM submissions
  353:     LEFT JOIN persons ON persons.id = submissions.submitter_person_id
  354:     ORDER BY submissions.created_at DESC
  355:   `).all();
  356: }
  357: 
  358: function mapSupabaseDetail(row: any) {
  359:   const person = Array.isArray(row.persons) ? row.persons[0] : row.persons;
  360:   const reviews = Array.isArray(row.reviews) ? row.reviews : row.reviews ? [row.reviews] : [];
  361:   const { persons, reviews: _reviews, original_json, ...submission } = row;
  362:   void persons;
  363:   void _reviews;
  364:   return {
  365:     ...submission,
  366:     original_json: typeof original_json === "string" ? original_json : JSON.stringify(original_json),
  367:     submitterName: person?.display_name || null,
  368:     contact: person?.contact || null,
  369:     original: typeof original_json === "string" ? JSON.parse(original_json) : original_json,
  370:     review: reviews[0] || null
  371:   };
  372: }
