  315: function mapSupabaseListItem(item: any) {
  316:   const person = Array.isArray(item.persons) ? item.persons[0] : item.persons;
  317:   return {
  318:     id: item.id,
  319:     status: item.status,
  320:     memoryPreview: item.memory_preview,
  321:     encounterDate: item.encounter_date,
  322:     locationName: item.location_name,
  323:     city: item.city,
  324:     region: item.region,
  325:     country: item.country,
  326:     eventName: item.event_name,
  327:     createdAt: item.created_at,
  328:     submitterName: person?.display_name || null
  329:   };
  330: }
