   28: let db: DatabaseSync | null = null;
   29: 
   30: function getDb() {
   31:   if (db) return db;
   32: 
   33:   const databasePath = resolve(/* turbopackIgnore: true */ process.env.DATABASE_PATH || ".m3-memory/m3-memory.sqlite");
   34:   mkdirSync(dirname(databasePath), { recursive: true });
   35: 
   36:   db = new DatabaseSync(databasePath);
   37:   db.exec("PRAGMA foreign_keys = ON");
   38:   db.exec(`
   39:     CREATE TABLE IF NOT EXISTS persons (
   40:       id TEXT PRIMARY KEY,
   41:       display_name TEXT NOT NULL,
   42:       contact TEXT,
   43:       created_at TEXT NOT NULL
   44:     );
   45: 
   46:     CREATE TABLE IF NOT EXISTS submissions (
   47:       id TEXT PRIMARY KEY,
   48:       submitter_person_id TEXT,
   49:       original_json TEXT NOT NULL,
   50:       memory_preview TEXT NOT NULL,
   51:       encounter_date TEXT,
   52:       is_approximate_date INTEGER NOT NULL DEFAULT 0,
   53:       location_name TEXT,
   54:       city TEXT,
   55:       region TEXT,
   56:       country TEXT,
   57:       event_name TEXT,
   58:       media_link TEXT,
   59:       media_consent INTEGER NOT NULL DEFAULT 0,
   60:       status TEXT NOT NULL DEFAULT 'UNREVIEWED',
   61:       created_at TEXT NOT NULL,
   62:       updated_at TEXT NOT NULL,
   63:       FOREIGN KEY (submitter_person_id) REFERENCES persons(id)
   64:     );
   65: 
   66:     CREATE TABLE IF NOT EXISTS reviews (
   67:       id TEXT PRIMARY KEY,
   68:       submission_id TEXT NOT NULL UNIQUE,
   69:       notes TEXT,
   70:       remembered TEXT,
   71:       corrections TEXT,
   72:       context TEXT,
   73:       people TEXT,
   74:       tags TEXT,
   75:       importance INTEGER,
   76:       emotional_significance INTEGER,
   77:       historical_significance INTEGER,
   78:       accuracy_confidence INTEGER,
   79:       book_potential INTEGER,
   80:       chapter_category TEXT,
   81:       private_notes TEXT,
   82:       created_at TEXT NOT NULL,
   83:       updated_at TEXT NOT NULL,
   84:       FOREIGN KEY (submission_id) REFERENCES submissions(id) ON DELETE CASCADE
   85:     );
   86: 
   87:     CREATE TABLE IF NOT EXISTS media (
   88:       id TEXT PRIMARY KEY,
   89:       submission_id TEXT NOT NULL,
   90:       file_name TEXT NOT NULL,
   91:       mime_type TEXT NOT NULL,
   92:       storage_path TEXT NOT NULL,
   93:       size_bytes INTEGER NOT NULL,
   94:       created_at TEXT NOT NULL,
   95:       FOREIGN KEY (submission_id) REFERENCES submissions(id) ON DELETE CASCADE
   96:     );
   97: 
   98:     CREATE TABLE IF NOT EXISTS artifacts (
   99:       id TEXT PRIMARY KEY,
  100:       submission_id TEXT NOT NULL,
  101:       label TEXT NOT NULL,
  102:       notes TEXT,
  103:       created_at TEXT NOT NULL,
  104:       FOREIGN KEY (submission_id) REFERENCES submissions(id) ON DELETE CASCADE
  105:     );
  106: 
  107:     CREATE TABLE IF NOT EXISTS story_drafts (
  108:       id TEXT PRIMARY KEY,
  109:       submission_id TEXT NOT NULL,
  110:       label TEXT NOT NULL DEFAULT 'AI-GENERATED DRAFT',
  111:       draft_text TEXT NOT NULL,
  112:       approved_at TEXT,
  113:       created_at TEXT NOT NULL,
  114:       FOREIGN KEY (submission_id) REFERENCES submissions(id) ON DELETE CASCADE
  115:     );
  116:   `);
  117: 
  118:   // Contributor capabilities: one row per submission with an open contributor window. No raw token is stored.
  119:   db.exec(`
  120:     CREATE TABLE IF NOT EXISTS contributor_capabilities (
  121:       submission_id TEXT PRIMARY KEY,
  122:       token_hash TEXT NOT NULL,
  123:       expires_at TEXT NOT NULL,
  124:       created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
  125:     );
  126:   `);
  127: 
  128:   // Ensure media columns exist (additive, safe to run multiple times)
  129:   try {
  130:     db.exec("ALTER TABLE submissions ADD COLUMN media_link TEXT");
  131:   } catch {
  132:     // Column already exists, safe to ignore
  133:   }
  134:   try {
  135:     db.exec("ALTER TABLE submissions ADD COLUMN media_consent INTEGER NOT NULL DEFAULT 0");
  136:   } catch {
  137:     // Column already exists, safe to ignore
  138:   }
  139:   // Ensure Act III preference columns exist (additive, safe to run multiple times)
  140:   try {
  141:     db.exec("ALTER TABLE submissions ADD COLUMN attribution_preference TEXT DEFAULT 'anonymous'");
  142:   } catch {
  143:     // Column already exists, safe to ignore
  144:   }
  145:   try {
  146:     db.exec("ALTER TABLE submissions ADD COLUMN preferred_attribution TEXT");
  147:   } catch {
  148:     // Column already exists, safe to ignore
  149:   }
  150:   try {
  151:     db.exec("ALTER TABLE submissions ADD COLUMN book_note TEXT");
  152:   } catch {
  153:     // Column already exists, safe to ignore
  154:   }
  155:   try {
  156:     db.exec("ALTER TABLE submissions ADD COLUMN final_notes TEXT");
  157:   } catch {
  158:     // Column already exists, safe to ignore
  159:   }
  160: 
  161:   return db;
  162: }
