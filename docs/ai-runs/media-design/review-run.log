  164: function now() {
  165:   return new Date().toISOString();
  166: }
  167: 
  168: function text(value: string | undefined, max = 4000) {
  169:   return (value || "").trim().slice(0, max);
  170: }
  171: 
  172: function optionalText(value: string | undefined, max = 4000): string | undefined {
  173:   const cleaned = text(value, max);
  174:   return cleaned || undefined;
  175: }
  176: 
  177: function rating(value: number | undefined): number | null {
  178:   const n = value ?? 0;
  179:   return Number.isInteger(n) && n >= 1 && n <= 5 ? n : null;
  180: }
  181: 
  182: function requireStatus(status: SubmissionStatus) {
  183:   if (!submissionStatuses.includes(status)) {
  184:     throw new Error("INVALID_STATUS");
  185:   }
  186: }
  187: 
  188: function normalizeSubmission(input: SubmissionInput): NormalizedSubmission {
  189:   const createdAt = now();
  190:   const submitterName = text(input.submitterName, 160);
  191:   const memoryText = text(input.memoryText, 12000);
  192: 
  193:   if (!submitterName || !memoryText) {
  194:     throw new Error("INVALID_SUBMISSION");
  195:   }
  196: 
  197:   const original: SubmissionInput = {
  198:     submitterName,
  199:     contact: text(input.contact, 240),
  200:     encounterDate: text(input.encounterDate, 40),
  201:     isApproximateDate: Boolean(input.isApproximateDate),
  202:     locationName: text(input.locationName, 240),
  203:     city: text(input.city, 120),
  204:     region: text(input.region, 120),
  205:     country: text(input.country, 120),
  206:     eventName: text(input.eventName, 240),
  207:     howMet: text(input.howMet, 4000),
  208:     memoryText,
  209:     beforeText: text(input.beforeText, 4000),
  210:     afterText: text(input.afterText, 4000),
  211:     metAgain: text(input.metAgain, 4000),
  212:     peoplePresent: text(input.peoplePresent, 4000),
  213:     yerielWearing: text(input.yerielWearing, 2000),
  214:     submitterWearing: text(input.submitterWearing, 2000),
  215:     talkedAbout: text(input.talkedAbout, 4000),
  216:     exchanged: text(input.exchanged, 2000),
  217:     artifactInfo: text(input.artifactInfo, 4000),
  218:     forgottenPrompt: text(input.forgottenPrompt, 4000),
  219:     bookPagePrompt: text(input.bookPagePrompt, 4000),
  220:     additionalComments: text(input.additionalComments, 4000),
  221:     mediaLink: text(input.mediaLink, 500),
  222:     mediaConsent: Boolean(input.mediaConsent),
  223:     attributionPreference: input.attributionPreference || "anonymous",
  224:     preferredAttribution: text(input.preferredAttribution, 240) || undefined,
  225:     bookNote: text(input.bookNote, 4000) || undefined,
  226:     finalNotes: text(input.finalNotes, 4000) || undefined
  227:   };
  228: 
  229:   return {
  230:     id: randomUUID(),
  231:     personId: randomUUID(),
  232:     original,
  233:     memoryPreview: memoryText.slice(0, 220),
  234:     encounterDate: optionalText(original.encounterDate, 40) ?? null,
  235:     isApproximateDate: original.isApproximateDate || false,
  236:     locationName: optionalText(original.locationName, 240) ?? null,
  237:     city: optionalText(original.city, 120) ?? null,
  238:     region: optionalText(original.region, 120) ?? null,
  239:     country: optionalText(original.country, 120) ?? null,
  240:     eventName: optionalText(original.eventName, 240) ?? null,
  241:     createdAt
  242:   };
  243: }
  244: 
  245: function normalizeReview(input: ReviewInput): NormalizedReview {
  246:   requireStatus(input.status);
  247:   return {
  248:     status: input.status,
  249:     notes: optionalText(input.notes) ?? null,
  250:     remembered: optionalText(input.remembered) ?? null,
  251:     corrections: optionalText(input.corrections) ?? null,
  252:     context: optionalText(input.context) ?? null,
  253:     people: optionalText(input.people, 1000) ?? null,
  254:     tags: optionalText(input.tags, 1000) ?? null,
  255:     importance: rating(input.importance),
  256:     emotional_significance: rating(input.emotionalSignificance),
  257:     historical_significance: rating(input.historicalSignificance),
  258:     accuracy_confidence: rating(input.accuracyConfidence),
  259:     book_potential: rating(input.bookPotential),
  260:     chapter_category: optionalText(input.chapterCategory, 240) ?? null,
  261:     private_notes: optionalText(input.privateNotes) ?? null,
  262:     updated_at: now()
  263:   };
  264: }
