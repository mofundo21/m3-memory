  121:   const data = await request(`${config.url}/auth/v1/token?grant_type=password`, {
  122:     method: "POST",
  123:     headers: headers(config.anonKey),
  124:     body: JSON.stringify({ email, password })
  125:   }, fetchImpl).catch((error) => {
  126:     if ((error as Error & { status?: number }).status === 400 || (error as Error & { status?: number }).status === 401) return null;
  127:     throw error;
  128:   }) as any;
  129: 
  130:   if (!data?.access_token || !data?.user?.id) return null;
  131:   return {
  132:     accessToken: String(data.access_token),
  133:     userId: String(data.user.id),
  134:     email: String(data.user.email || email)
  135:   };
  136: }
