  401: export async function upsertReview(submissionId: string, input: ReviewInput, adminToken?: string | null) {
  402:   const review = normalizeReview(input);
  403: 
  404:   if (getPersistenceMode() === "supabase") {
  405:     await upsertSupabaseReview(submissionId, review, requireSupabaseAdminToken(adminToken));
  406:     return;
  407:   }
  408: 
  409:   const db = getDb();
  410:   const existing = db.prepare("SELECT id FROM reviews WHERE submission_id = ?").get(submissionId) as any;
  411:   const reviewId = existing?.id || randomUUID();
  412: 
  413:   if (existing) {
  414:     db.prepare(`
  415:       UPDATE reviews SET
  416:         notes = ?, remembered = ?, corrections = ?, context = ?, people = ?, tags = ?,
  417:         importance = ?, emotional_significance = ?, historical_significance = ?,
  418:         accuracy_confidence = ?, book_potential = ?, chapter_category = ?, private_notes = ?,
  419:         updated_at = ?
  420:       WHERE submission_id = ?
  421:     `).run(
  422:       review.notes,
  423:       review.remembered,
  424:       review.corrections,
  425:       review.context,
  426:       review.people,
  427:       review.tags,
  428:       review.importance,
  429:       review.emotional_significance,
  430:       review.historical_significance,
  431:       review.accuracy_confidence,
  432:       review.book_potential,
  433:       review.chapter_category,
  434:       review.private_notes,
  435:       review.updated_at,
  436:       submissionId
  437:     );
  438:   } else {
  439:     db.prepare(`
  440:       INSERT INTO reviews (
  441:         id, submission_id, notes, remembered, corrections, context, people, tags,
  442:         importance, emotional_significance, historical_significance, accuracy_confidence,
  443:         book_potential, chapter_category, private_notes, created_at, updated_at
  444:       ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  445:     `).run(
  446:       reviewId,
  447:       submissionId,
  448:       review.notes,
  449:       review.remembered,
  450:       review.corrections,
  451:       review.context,
  452:       review.people,
  453:       review.tags,
  454:       review.importance,
  455:       review.emotional_significance,
  456:       review.historical_significance,
  457:       review.accuracy_confidence,
  458:       review.book_potential,
  459:       review.chapter_category,
  460:       review.private_notes,
  461:       review.updated_at,
  462:       review.updated_at
  463:     );
  464:   }
  465: 
  466:   db.prepare("UPDATE submissions SET status = ?, updated_at = ? WHERE id = ?").run(
  467:     review.status,
  468:     review.updated_at,
  469:     submissionId
  470:   );
  471: }
