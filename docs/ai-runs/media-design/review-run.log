   35:   attribution_preference text default 'anonymous',
   36:   preferred_attribution text,
   37:   book_note text,
   38:   final_notes text,
   39:   status text not null default 'UNREVIEWED' check (status in ('UNREVIEWED', 'IN_REVIEW', 'REVIEWED', 'APPROVED_FOR_STORY', 'REJECTED', 'ARCHIVED')),
   40:   created_at timestamptz not null default now(),
   41:   updated_at timestamptz not null default now()
   42: );
   43: 
   44: create table if not exists public.reviews (
   45:   id uuid primary key default gen_random_uuid(),
