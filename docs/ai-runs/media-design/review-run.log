  589: // Act III preference update (PATCH) â€” lightweight, does not touch original_json or media
  590: export interface Act3UpdateInput {
  591:   attributionPreference?: string;
  592:   preferredAttribution?: string;
  593:   bookNote?: string;
  594:   finalNotes?: string;
  595: }
  596: 
  597: export async function updateSubmissionPreferences(submissionId: string, input: Act3UpdateInput, adminToken?: string | null) {
  598:   if (getPersistenceMode() === "supabase") {
  599:     const token = requireSupabaseAdminToken(adminToken);
  600:     await updateSupabaseSubmissionPreferences(submissionId, input, token);
  601:     return;
  602:   }
  603: 
  604:   const db = getDb();
  605:   const updatedAt = now();
  606: 
  607:   db.prepare(`
  608:     UPDATE submissions SET
  609:       attribution_preference = ?,
  610:       preferred_attribution = ?,
  611:       book_note = ?,
  612:       final_notes = ?,
  613:       updated_at = ?
  614:     WHERE id = ?
  615:   `).run(
  616:     input.attributionPreference || "anonymous",
  617:     optionalText(input.preferredAttribution, 240) ?? null,
  618:     optionalText(input.bookNote, 4000) ?? null,
  619:     optionalText(input.finalNotes, 4000) ?? null,
  620:     updatedAt,
  621:     submissionId
  622:   );
  623: }
  624: 
  625: // ---- Contributor capability store (dispatches by persistence mode). Used only by src/lib/contributorCapability.ts. ----
  626: 
  627: export async function storeContributorCapability(submissionId: string, tokenHash: string, expiresAt: string) {
  628:   if (getPersistenceMode() === "supabase") {
  629:     await insertSupabaseCapability(submissionId, tokenHash, expiresAt);
  630:     return;
  631:   }
  632:   getDb().prepare("INSERT INTO contributor_capabilities (submission_id, token_hash, expires_at) VALUES (?, ?, ?)").run(submissionId, tokenHash, expiresAt);
  633: }
  634: 
  635: /** Atomic consume. True only if exactly one unexpired row matched and was deleted. */
  636: export async function consumeContributorCapability(submissionId: string, tokenHash: string, nowIso: string) {
  637:   if (getPersistenceMode() === "supabase") {
  638:     return consumeSupabaseCapability(submissionId, tokenHash, nowIso);
  639:   }
  640:   const rows = getDb()
  641:     .prepare("DELETE FROM contributor_capabilities WHERE submission_id = ? AND token_hash = ? AND expires_at > ? RETURNING submission_id")
  642:     .all(submissionId, tokenHash, nowIso);
  643:   return rows.length === 1 && (rows[0] as { submission_id: string }).submission_id === submissionId;
  644: }
  645: 
  646: /** Guarded save of the four contributor-owned fields. True only if exactly the one UNREVIEWED row changed. */
  647: export async function saveContributorPreferences(
  648:   submissionId: string,
  649:   fields: { attributionPreference: string; preferredAttribution: string | null; bookNote: string | null; finalNotes: string | null }
  650: ) {
  651:   if (getPersistenceMode() === "supabase") {
  652:     return saveSupabaseContributorPreferences(submissionId, fields);
  653:   }
  654:   const result = getDb()
  655:     .prepare(`UPDATE submissions SET attribution_preference = ?, preferred_attribution = ?, book_note = ?, final_notes = ?, updated_at = ?
  656:               WHERE id = ? AND status = 'UNREVIEWED'`)
  657:     .run(fields.attributionPreference, fields.preferredAttribution, fields.bookNote, fields.finalNotes, now(), submissionId);
  658:   return Number(result.changes) === 1;
  659: }
  660: 
  661: /** Compensation for a failed creation. Best effort; the caller logs a category, never the ids. */
  662: export async function deleteSubmissionRecords(submissionId: string, personId: string) {
  663:   if (getPersistenceMode() === "supabase") {
  664:     await deleteSupabaseSubmissionRecords(submissionId, personId);
  665:     return;
  666:   }
  667:   const db = getDb();
  668:   db.prepare("DELETE FROM contributor_capabilities WHERE submission_id = ?").run(submissionId);
  669:   db.prepare("DELETE FROM submissions WHERE id = ?").run(submissionId);
  670:   db.prepare("DELETE FROM persons WHERE id = ?").run(personId);
  671: }
