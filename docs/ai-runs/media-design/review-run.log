  528: // Media upload validation and persistence
  529: const MAX_FILE_SIZE_BYTES = 8 * 1024 * 1024; // 8 MB
  530: const MAX_FILES_PER_SUBMISSION = 5;
  531: const ALLOWED_MIME_TYPES = new Set(["image/jpeg", "image/png", "image/webp"]);
  532: 
  533: export interface MediaUploadInput {
  534:   fileName: string;
  535:   mimeType: string;
  536:   sizeBytes: number;
  537: }
  538: 
  539: export function validateMediaUpload(files: MediaUploadInput[]) {
  540:   if (files.length > MAX_FILES_PER_SUBMISSION) {
  541:     throw new Error("TOO_MANY_FILES");
  542:   }
  543: 
  544:   for (const file of files) {
  545:     if (!file.mimeType || !ALLOWED_MIME_TYPES.has(file.mimeType)) {
  546:       throw new Error("INVALID_MIME_TYPE");
  547:     }
  548:     if (file.sizeBytes > MAX_FILE_SIZE_BYTES) {
  549:       throw new Error("FILE_TOO_LARGE");
  550:     }
  551:   }
  552: }
  553: 
  554: export async function insertMediaRows(submissionId: string, files: Array<{ fileName: string; mimeType: string; sizeBytes: number; storagePath: string }>, adminToken?: string | null) {
  555:   if (getPersistenceMode() === "supabase") {
  556:     const token = requireSupabaseAdminToken(adminToken);
  557:     return insertSupabaseMediaRows(submissionId, files, token);
  558:   }
  559: 
  560:   const db = getDb();
  561:   const createdAt = now();
  562: 
  563:   for (const file of files) {
  564:     db.prepare(`
  565:       INSERT INTO media (id, submission_id, file_name, mime_type, storage_path, size_bytes, created_at)
  566:       VALUES (?, ?, ?, ?, ?, ?, ?)
  567:     `).run(
  568:       randomUUID(),
  569:       submissionId,
  570:       file.fileName,
  571:       file.mimeType,
  572:       file.storagePath,
  573:       file.sizeBytes,
  574:       createdAt
  575:     );
  576:   }
  577: }
