  114: export async function updatePreferencesAction(submissionId: string, formData: any) {
  115:   // The submission id argument is untrusted. It only selects which cookie to read, and the redeem step
  116:   // requires the cookie's own id to match it. Every database predicate uses the cookie's id.
  117:   const jar = await cookies();
  118:   const name = isCanonicalSubmissionId(submissionId) ? cookieNameFor(submissionId) : null;
  119:   const value = name ? jar.get(name)?.value : undefined;
  120: 
  121:   let saved = false;
  122:   try {
  123:     saved = await redeemCapability(submissionId, value, sanitizePreferences(formData ?? {}), new Date());
  124:   } catch {
  125:     logContributorEvent("backend-error");
  126:     saved = false;
  127:   }
  128: 
  129:   // The capability is spent whether or not the save succeeded. Clear the cookie in every case.
  130:   if (name) jar.set(name, "", cookieOptions(0));
  131: 
  132:   if (!saved) {
  133:     throw new Error(CONTRIBUTOR_ERROR_MESSAGE);
  134:   }
  135: 
  136:   // redirect() throws; it must sit outside the try block or the catch turns it into an error.
  137:   redirect("/thanks");
  138: }
