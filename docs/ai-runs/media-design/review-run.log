   15:   updateSupabaseStoryDraft,
   16:   uploadSupabaseMedia,
   17:   insertSupabaseMediaRows,
   18:   getSupabaseSubmissionMedia,
   19:   updateSupabaseSubmissionPreferences,
   20:   consumeSupabaseCapability,
   21:   deleteSupabaseSubmissionRecords,
   22:   insertSupabaseCapability,
   23:   saveSupabaseContributorPreferences,
   24:   type NormalizedReview,
   25:   type NormalizedSubmission
   26: } from "./supabase";
