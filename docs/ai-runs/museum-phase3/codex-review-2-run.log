 103:     await rm.emulateMediaFeatures([{ name: "prefers-reduced-motion", value: "reduce" }]);
 104:     await rm.goto(`${base}/museum`, { waitUntil: "networkidle0" });
 105:     await scrollToProgress(rm, 0.8);
 106:     assert.equal(await opacityOf(rm, ".museum-counters"), 1, "reduced motion: counters visible in their beat");
 107:     await scrollToProgress(rm, 0.92);
 108:     const linesAt092 = await rm.$$eval(".museum-line", (els) => els.map((el) => Number(getComputedStyle(el).opacity)));
 109:     assert.deepEqual(linesAt092, [1, 0, 0], "reduced motion: one message line at a time");
 110:     await scrollToProgress(rm, 1);
 111:     assert.equal(await opacityOf(rm, ".museum-join"), 1, "reduced motion: join beat visible at the end");
 112:     assert.equal(await rm.$eval(".museum-cta-slot", (el) => el.inert), false, "reduced motion: CTA reachable at the end");
 113:     await rm.close();
 114: 
 115:     // ---- Read as text: full content, with the hand-off link ----
 116:     const text = await browser.newPage();
 117:     await text.setViewport({ width: 1440, height: 900 });
 118:     await text.goto(`${base}/museum`, { waitUntil: "networkidle0" });
 119:     await text.click(".museum-text-toggle");
