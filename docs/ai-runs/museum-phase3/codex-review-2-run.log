 194:               {sceneNear('mofundo', p) &&
 195:                 SCENE_TWO_PLATES.map((plate, i) => {
 196:                   const asset = getMuseumAsset(plate.id);
 197:                   const dx = rm ? 0 : (plate.drift ?? 0) * within(p, ...mofundo.drift);
 198:                   return (
 199:                     <img
 200:                       key={plate.id}
 201:                       className="museum-plate"
 202:                       src={asset.src}
 203:                       alt=""
 204:                       style={{
 205:                         left: `${plate.left + dx}%`,
 206:                         top: `${plate.top}%`,
 207:                         width: `${plate.width}%`,
 208:                         opacity: fadeIn(...mofundo.plateIn(i)),
 209:                       }}
 210:                     />
 211:                   );
 212:                 })}
 213:               <svg className="museum-waveform" viewBox="0 0 1000 60" preserveAspectRatio="none" style={{ opacity: fadeIn(...mofundo.waveformIn) }}>
 214:                 <path d={WAVEFORM_D} />
 215:               </svg>
 216:             </div>
 217: 
 218:             {/* 03 HOW DO YOU REMEMBER HIM? */}
 219:             <div className="museum-scene" style={{ opacity: sceneOp('remember-him') }}>
 220:               <h2 className="museum-question" style={{ opacity: fadeIn(...rememberHim.questionIn) }}>
 221:                 {MUSEUM_COPY.rememberHim.question}
 222:               </h2>
 223:               {sceneNear('remember-him', p) &&
 224:                 SCENE_THREE_PLATES.map((plate, i) => {
 225:                   const asset = getMuseumAsset(plate.id);
 226:                   return (
 227:                     <img
 228:                       key={plate.id}
 229:                       className="museum-plate"
 230:                       src={asset.src}
 231:                       alt=""
 232:                       style={{
 233:                         left: `${plate.left}%`,
 234:                         top: `${plate.top}%`,
 235:                         width: `${plate.width}%`,
 236:                         opacity: fadeIn(...rememberHim.plateIn(i)) * 0.85,
 237:                         transform: `scale(${rm ? 1 : plate.depth ?? 1})`,
 238:                       }}
 239:                     />
 240:                   );
 241:                 })}
 242:               {evidence.map((item, i) => (
 243:                 <span
 244:                   key={item.id}
 245:                   className="museum-evidence"
 246:                   style={{
 247:                     left: `${EVIDENCE_SLOTS[i].left}%`,
 248:                     top: `${EVIDENCE_SLOTS[i].top}%`,
 249:                     opacity: fadeIn(...rememberHim.evidenceIn(i)),
 250:                   }}
 251:                 >
 252:                   {item.label}
 253:                   <span className="museum-tag">PLACEHOLDER</span>
 254:                 </span>
 255:               ))}
 256:               {fragments.map((fragment, i) => (
 257:                 <p
 258:                   key={fragment.id}
 259:                   className="museum-caveat"
 260:                   style={{
 261:                     left: `${FRAGMENT_SLOTS[i].left}%`,
 262:                     top: `${FRAGMENT_SLOTS[i].top}%`,
 263:                     opacity: fadeIn(...rememberHim.fragmentIn(i)),
 264:                   }}
 265:                 >
 266:                   {fragment.text}
 267:                   <span className="museum-caveat-attribution">{fragment.attribution} Â· PLACEHOLDER</span>
 268:                 </p>
 269:               ))}
 270:             </div>
 271: 
 272:             {/* 04 JOIN THE STORY: counters, then the simplification, then the message. */}
 273:             <div className="museum-scene museum-scene-join" style={{ opacity: sceneOp('join') }}>
 274:               <div
 275:                 className="museum-counters"
 276:                 style={{ opacity: fadeIn(...join.countersIn) * (1 - fadeOut(...join.countersOut)) }}
 277:               >
 278:                 {counters.map((counter, i) => (
 279:                   <div
 280:                     key={counter.id}
 281:                     className="museum-counter"
 282:                     style={{
 283:                       opacity: fadeIn(join.countersIn[0] + i * join.counterStagger, join.countersIn[1] + i * join.counterStagger),
 284:                     }}
 285:                   >
 286:                     <span className="museum-counter-value">{counter.value ?? 'â€”'}</span>
 287:                     <span className="museum-counter-label">
 288:                       {counter.label}
 289:                       {counter.status === 'pending' || counter.value === null ? ' Â· PENDING' : ''}
 290:                     </span>
 291:                   </div>
 292:                 ))}
 293:                 {hasPlaceholderCounters ? <p className="museum-tag museum-counters-tag">{MUSEUM_COPY.join.placeholderTag}</p> : null}
 294:               </div>
 295: 
 296:               <div className="museum-message">
 297:                 {MUSEUM_COPY.join.lines.map((line, i) => {
 298:                   const start = join.lineStarts[i];
 299:                   const next = join.lineStarts[i + 1] ?? join.joinIn[0];
 300:                   const opacity = fadeIn(start, start + 0.02) * (1 - fadeOut(next, next + 0.02));
 301:                   return (
 302:                     <p key={line} className="museum-line" style={{ opacity }}>
 303:                       {line}
 304:                     </p>
 305:                   );
 306:                 })}
 307:               </div>
 308: 
 309:               <div className="museum-join" style={{ opacity: fadeIn(...join.joinIn) }}>
 310:                 <h2 className="museum-join-heading">{MUSEUM_COPY.join.heading}</h2>
 311:                 <p className="museum-join-explanation">{MUSEUM_COPY.join.explanation}</p>
 312:               </div>
 313:             </div>
 314:           </div>
 315: 
 316:           {/* Controls layer: the only focusable elements on the stage. Inert while not visible. */}
 317:           <div className="museum-controls">
 318:             <div className="museum-enter" style={{ opacity: enterOpacity }} inert={enterOpacity < 0.5}>
 319:               <button type="button" className="museum-enter-button" onClick={onEnter}>
 320:                 {MUSEUM_COPY.enter.cta}
 321:               </button>
 322:             </div>
 323: 
 324:             <div className="museum-cta-slot" id="museum-join" style={{ opacity: fadeIn(...join.joinIn) }} inert={!joinActive}>
 325:               <a ref={ctaRef} className="museum-cta" href={INTERVIEW_HREF} onClick={onJoin}>
 326:                 {MUSEUM_COPY.join.cta}
 327:               </a>
 328:             </div>
 329:           </div>
 330:         </div>
 331:       </div>
 332: 
 333:       {/* Text version: the same content, in order, as a visible panel. Shown by "Read as text". */}
 334:       <section className="museum-text-panel" aria-label="The sequence as text">
 335:         <h2>{MUSEUM_COPY.yeriel.name}</h2>
 336:         <p>
 337:           {MUSEUM_COPY.yeriel.meta} ({MUSEUM_COPY.yeriel.metaTag})
 338:         </p>
 339:         <ul>
 340:           {MUSEUM_COPY.yeriel.fragments.map((text) => (
 341:             <li key={text}>{text}</li>
 342:           ))}
 343:         </ul>
 344: 
 345:         <h2>{MUSEUM_COPY.mofundo.name}</h2>
 346:         <p>{MUSEUM_COPY.mofundo.itemMeta}</p>
 347: 
 348:         <h2>{MUSEUM_COPY.rememberHim.question}</h2>
 349:         <ul>
 350:           {(data?.evidence ?? []).map((item) => (
 351:             <li key={item.id}>{item.label} (PLACEHOLDER)</li>
 352:           ))}
 353:         </ul>
 354:         <ul>
 355:           {(data?.fragments ?? []).map((fragment) => (
 356:             <li key={fragment.id}>
 357:               â€œ{fragment.text}â€ {fragment.attribution} (PLACEHOLDER)
 358:             </li>
 359:           ))}
 360:         </ul>
 361: 
 362:         <h2>{MUSEUM_COPY.join.heading}</h2>
 363:         <ul>
 364:           {counters.map((c) => (
 365:             <li key={c.id}>
 366:               {c.label}: {c.value ?? 'pending'}
 367:               {c.status === 'placeholder' ? ` (${MUSEUM_COPY.join.placeholderTag})` : ''}
 368:             </li>
 369:           ))}
 370:         </ul>
 371:         {MUSEUM_COPY.join.lines.map((line) => (
 372:           <p key={line}>{line}</p>
 373:         ))}
 374:         <p>{MUSEUM_COPY.join.explanation}</p>
 375:         <p>
 376:           <a className="museum-cta" href={INTERVIEW_HREF} onClick={onJoin}>
 377:             {MUSEUM_COPY.join.cta}
 378:           </a>
 379:         </p>
 380:       </section>
 381:     </div>
 382:   );
