  29:   const databasePath = resolve(/* turbopackIgnore: true */ process.env.DATABASE_PATH || ".m3-memory/m3-memory.sqlite");
  30:   mkdirSync(dirname(databasePath), { recursive: true });
  31: 
  32:   db = new DatabaseSync(databasePath);
  33:   db.exec("PRAGMA foreign_keys = ON");
  34:   db.exec(`
  35:     CREATE TABLE IF NOT EXISTS persons (
  36:       id TEXT PRIMARY KEY,
  37:       display_name TEXT NOT NULL,
  38:       contact TEXT,
  39:       created_at TEXT NOT NULL
  40:     );
  41: 
  42:     CREATE TABLE IF NOT EXISTS submissions (
  43:       id TEXT PRIMARY KEY,
  44:       submitter_person_id TEXT,
  45:       original_json TEXT NOT NULL,
  46:       memory_preview TEXT NOT NULL,
  47:       encounter_date TEXT,
  48:       is_approximate_date INTEGER NOT NULL DEFAULT 0,
  49:       location_name TEXT,
  50:       city TEXT,
  51:       region TEXT,
  52:       country TEXT,
  53:       event_name TEXT,
  54:       media_link TEXT,
  55:       media_consent INTEGER NOT NULL DEFAULT 0,
  56:       status TEXT NOT NULL DEFAULT 'UNREVIEWED',
  57:       created_at TEXT NOT NULL,
  58:       updated_at TEXT NOT NULL,
  59:       FOREIGN KEY (submitter_person_id) REFERENCES persons(id)
  60:     );
  61: 
  62:     CREATE TABLE IF NOT EXISTS reviews (
  63:       id TEXT PRIMARY KEY,
  64:       submission_id TEXT NOT NULL UNIQUE,
  65:       notes TEXT,
  66:       remembered TEXT,
  67:       corrections TEXT,
  68:       context TEXT,
  69:       people TEXT,
  70:       tags TEXT,
  71:       importance INTEGER,
  72:       emotional_significance INTEGER,
  73:       historical_significance INTEGER,
  74:       accuracy_confidence INTEGER,
  75:       book_potential INTEGER,
  76:       chapter_category TEXT,
  77:       private_notes TEXT,
  78:       created_at TEXT NOT NULL,
  79:       updated_at TEXT NOT NULL,
  80:       FOREIGN KEY (submission_id) REFERENCES submissions(id) ON DELETE CASCADE
  81:     );
  82: 
  83:     CREATE TABLE IF NOT EXISTS media (
  84:       id TEXT PRIMARY KEY,
  85:       submission_id TEXT NOT NULL,
  86:       file_name TEXT NOT NULL,
  87:       mime_type TEXT NOT NULL,
  88:       storage_path TEXT NOT NULL,
  89:       size_bytes INTEGER NOT NULL,
  90:       created_at TEXT NOT NULL,
  91:       FOREIGN KEY (submission_id) REFERENCES submissions(id) ON DELETE CASCADE
  92:     );
  93: 
  94:     CREATE TABLE IF NOT EXISTS artifacts (
  95:       id TEXT PRIMARY KEY,
  96:       submission_id TEXT NOT NULL,
