### src/lib/museumAssets.ts
   1: /**
   2:  * Museum asset manifest (Phase 3).
   3:  *
   4:  * Single source of truth for museum media. Only placeholders exist today.
   5:  * Real files replace an entry by changing `src` and `status` after Yeriel's approval.
   6:  * See docs/MOFUNDO_MUSEUM_DESIGN_BIBLE.md Â§19.
   7:  */
   8: 
   9: export type MuseumAssetStatus = 'placeholder' | 'pending-approval' | 'approved';
  10: 
  11: export interface MuseumAsset {
  12:   id: string;
  13:   category: 'portrait' | 'photography' | 'artifacts' | 'audio' | 'archiveMedia';
  14:   scene: '01' | '02' | '03' | '04';
  15:   status: MuseumAssetStatus;
  16:   src: string;
  17:   alt: string;
  18:   /** Recommended format and size for the real asset (not used while placeholder). */
  19:   recommended: string;
  20: }
  21: 
  22: export const museumAssets: MuseumAsset[] = [
  23:   {
  24:     id: 'portrait',
  25:     category: 'portrait',
  26:     scene: '01',
  27:     status: 'placeholder',
  28:     src: '/media/museum/placeholders/portrait-placeholder.svg',
  29:     alt: 'Placeholder portrait plate. Replace with an approved photograph.',
  30:     recommended: '2400Ã—3000 AVIF/WebP, â‰¤ 220 KB; optional alpha cutout â‰¤ 260 KB',
  31:   },
  32:   ...[1, 2, 3, 4, 5, 6].map((n): MuseumAsset => ({
  33:     id: `photo-${String(n).padStart(2, '0')}`,
  34:     category: 'photography',
  35:     scene: n <= 3 ? '02' : '03',
  36:     status: 'placeholder',
  37:     src: `/media/museum/placeholders/photo-placeholder-${String(n).padStart(2, '0')}.svg`,
  38:     alt: `Placeholder photograph ${n}. Date and place to confirm.`,
  39:     recommended: '1600 px long edge, AVIF/WebP, â‰¤ 160 KB',
  40:   })),
  41: ];
  42: 
  43: export function getMuseumAsset(id: string): MuseumAsset {
  44:   const asset = museumAssets.find((a) => a.id === id);
  45:   if (!asset) throw new Error(`Unknown museum asset: ${id}`);
  46:   return asset;
  47: }
