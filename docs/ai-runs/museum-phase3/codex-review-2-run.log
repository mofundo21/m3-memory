  40: function actionFields(html) {
  41:   const fields = {};
  42:   for (const match of html.matchAll(/<input type="hidden" name="([^"]+)"(?: value="([^"]*)")?/g)) {
  43:     fields[decode(match[1])] = decode(match[2] || "");
  44:   }
  45:   return fields;
  46: }
  47: 
  48: function decode(value) {
  49:   return value
  50:     .replaceAll("&quot;", '"')
  51:     .replaceAll("&amp;", "&")
  52:     .replaceAll("&#x27;", "'")
  53:     .replaceAll("&lt;", "<")
  54:     .replaceAll("&gt;", ">");
  55: }
  56: 
  57: function form(fields) {
  58:   const body = new FormData();
  59:   for (const [key, value] of Object.entries(fields)) body.set(key, value);
  60:   return body;
  61: }
  62: 
  63: async function postForm(path, fields, cookie) {
  64:   return fetch(`${base}${path}`, {
  65:     method: "POST",
  66:     body: form(fields),
  67:     redirect: "manual",
  68:     headers: cookie ? { cookie } : undefined
  69:   });
  70: }
  71: 
  72: // ---- Browser helpers: drive the current interview UI as a visitor would. ----
  73: 
  74: /** Set a React-controlled textarea/input and fire the input event React listens for. */
  75: async function fillField(page, selector, value) {
  76:   await page.waitForSelector(selector);
  77:   await page.$eval(selector, (el, v) => {
  78:     const proto = el instanceof HTMLTextAreaElement ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
  79:     Object.getOwnPropertyDescriptor(proto, "value").set.call(el, v);
  80:     el.dispatchEvent(new Event("input", { bubbles: true }));
  81:   }, value);
  82: }
  83: 
  84: async function clickButton(page, label) {
  85:   const button = await page.waitForSelector(`button::-p-text(${label})`, { visible: true });
  86:   await button.click();
  87: }
  88: 
  89: async function waitForPath(page, path) {
  90:   await page.waitForFunction((p) => window.location.pathname.startsWith(p), { timeout: 15000 }, path);
  91: }
  92: 
  93: /**
  94:  * Public journey through the current interview:
  95:  * /remember (narrative) -> /remember/write -> /remember/details -> /remember/final -> /thanks.
  96:  * Each submission uses a fresh tab so the session-stored draft starts empty.
  97:  */
  98: async function submitPublicMemory(browser, { memoryText, eventName, mediaLink, attribution, finalNotes }) {
  99:   const page = await browser.newPage();
 100:   try {
 101:     await page.setViewport({ width: 1280, height: 900 });
 102:     await page.goto(`${base}/remember`, { waitUntil: "networkidle0", timeout: 30000 });
 103: 
 104:     // Narrative CTA leads into the interview.
 105:     const cta = await page.waitForSelector('a[href="/remember/write"]', { timeout: 15000 });
 106:     assert.match(await cta.evaluate((a) => a.textContent.trim()), /LET'S REMEMBER/i, "intro CTA should be the interview entry");
 107:     await page.evaluate(() => document.querySelector('a[href="/remember/write"]').click());
 108:     await waitForPath(page, "/remember/write");
 109: 
 110:     // Step 2: an empty memory is refused with a visible message and no navigation.
 111:     await clickButton(page, "Keep Going");
 112:     await page.waitForFunction(() => document.querySelector(".error-note")?.textContent.includes("Please share your memory"), { timeout: 5000 });
 113:     assert.ok(page.url().endsWith("/remember/write"), "empty memory must stay on the write step");
 114: 
 115:     await fillField(page, 'textarea[name="memoryText"]', memoryText);
 116:     await clickButton(page, "Keep Going");
 117:     await waitForPath(page, "/remember/details");
 118: 
 119:     // Step 3: optional details. A media link reveals the consent checkbox.
 120:     if (eventName) await fillField(page, 'input[name="eventName"]', eventName);
 121:     if (mediaLink) {
 122:       await fillField(page, 'input[name="mediaLink"]', mediaLink);
 123:       // Select the consent box by its label, not by position (the first checkline is "approximate date").
 124:       await page.waitForFunction(() => [...document.querySelectorAll("label.checkline")].some((l) => l.textContent.includes("use this in the book")));
 125:       await page.evaluate(() => [...document.querySelectorAll("label.checkline")].find((l) => l.textContent.includes("use this in the book")).querySelector("input").click());
 126:     }
 127:     await clickButton(page, "One Last Thing");
 128:     await waitForPath(page, "/remember/final");
 129: 
 130:     // Step 4: attribution preference and final notes, then send.
 131:     const submissionId = new URL(page.url()).searchParams.get("submissionId");
 132:     assert.ok(submissionId, "final step should carry the submission ID");
 133:     if (attribution) {
 134:       const option = await page.waitForSelector(`input[name="attributionPreference"][value="${attribution}"]`, { visible: true });
 135:       await option.click();
 136:     }
 137:     if (finalNotes) await fillField(page, "#finalNotes", finalNotes);
 138:     await clickButton(page, "Send My Memory");
 139:     await waitForPath(page, "/thanks");
 140: 
 141:     // The confirmation page must not echo the memory or the submission ID.
 142:     const thanksHtml = await page.content();
 143:     assert.doesNotMatch(thanksHtml, new RegExp(submissionId));
 144:     assert.doesNotMatch(thanksHtml, /Fictional/);
 145:     return submissionId;
 146:   } finally {
 147:     await page.close();
 148:   }
 149: }
