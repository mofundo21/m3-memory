 386: export async function upsertReview(submissionId: string, input: ReviewInput, adminToken?: string | null) {
 387:   const review = normalizeReview(input);
 388: 
 389:   if (getPersistenceMode() === "supabase") {
 390:     await upsertSupabaseReview(submissionId, review, requireSupabaseAdminToken(adminToken));
 391:     return;
 392:   }
 393: 
 394:   const db = getDb();
 395:   const existing = db.prepare("SELECT id FROM reviews WHERE submission_id = ?").get(submissionId) as any;
 396:   const reviewId = existing?.id || randomUUID();
 397: 
 398:   if (existing) {
