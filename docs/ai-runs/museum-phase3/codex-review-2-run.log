 122:     assert.equal(await text.$eval(".museum-text-panel", (el) => getComputedStyle(el).display), "block", "text panel is visible");
 123:     const panelText = await text.$eval(".museum-text-panel", (el) => el.textContent);
 124:     assert.match(panelText, /YERIEL/);
 125:     assert.match(panelText, /HOW DO YOU REMEMBER HIM/);
 126:     assert.match(panelText, /ONE PERSON CAN'T REMEMBER AN ENTIRE LIFE/);
 127:     assert.match(panelText, /PLACEHOLDER/);
 128:     await text.close();
 129: 
 130:     // ---- Mobile: no horizontal overflow, and the stage is usable ----
 131:     const mobile = await browser.newPage();
 132:     await mobile.setViewport({ width: 390, height: 844, isMobile: true, hasTouch: true });
 133:     await mobile.goto(`${base}/museum`, { waitUntil: "networkidle0" });
 134:     const overflow = await mobile.evaluate(() => document.documentElement.scrollWidth - window.innerWidth);
