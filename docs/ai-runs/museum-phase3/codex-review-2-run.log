 359: export async function getSubmission(id: string, adminToken?: string | null) {
 360:   if (getPersistenceMode() === "supabase") {
 361:     const row = await getSupabaseSubmission(id, requireSupabaseAdminToken(adminToken));
 362:     return row ? mapSupabaseDetail(row) : null;
 363:   }
 364: 
 365:   const db = getDb();
 366:   const submission = db.prepare(`
 367:     SELECT
 368:       submissions.*,
 369:       persons.display_name AS submitterName,
 370:       persons.contact AS contact
 371:     FROM submissions
 372:     LEFT JOIN persons ON persons.id = submissions.submitter_person_id
 373:     WHERE submissions.id = ?
 374:   `).get(id) as any;
 375: 
 376:   if (!submission) return null;
 377: 
 378:   const review = db.prepare("SELECT * FROM reviews WHERE submission_id = ?").get(id) || null;
 379:   return {
 380:     ...submission,
 381:     original: JSON.parse(submission.original_json),
 382:     review
 383:   };
 384: }
