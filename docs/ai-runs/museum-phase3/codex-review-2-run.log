### src/lib/museumCamera.ts
   1: import { CAMERA_KEYFRAMES, MUSEUM_SCENES, SCENE_FADE, type MuseumSceneId } from '@/lib/museumConfig';
   2: 
   3: export interface CameraState {
   4:   zoom: number;
   5:   x: number;
   6: }
   7: 
   8: /** Clamp a value to [0, 1]. */
   9: export function clamp01(v: number): number {
  10:   return Math.max(0, Math.min(1, v));
  11: }
  12: 
  13: /**
  14:  * Progress of `p` through the window [from, to], clamped to 0..1.
  15:  * Used for per-element reveals inside a scene.
  16:  */
  17: export function within(p: number, from: number, to: number): number {
  18:   if (to <= from) return p >= to ? 1 : 0;
  19:   return clamp01((p - from) / (to - from));
  20: }
  21: 
  22: function smoothstep(t: number): number {
  23:   return t * t * (3 - 2 * t);
  24: }
  25: 
  26: /** Camera state at scroll progress `p`. Piecewise linear between keyframes, eased per segment. */
  27: export function cameraAt(p: number): CameraState {
  28:   const keys = CAMERA_KEYFRAMES;
  29:   if (p <= keys[0].at) return { zoom: keys[0].zoom, x: keys[0].x };
  30:   for (let i = 1; i < keys.length; i += 1) {
  31:     const a = keys[i - 1];
  32:     const b = keys[i];
  33:     if (p <= b.at) {
  34:       const t = smoothstep(within(p, a.at, b.at));
  35:       return { zoom: a.zoom + (b.zoom - a.zoom) * t, x: a.x + (b.x - a.x) * t };
  36:     }
  37:   }
  38:   const last = keys[keys.length - 1];
  39:   return { zoom: last.zoom, x: last.x };
  40: }
  41: 
  42: /**
  43:  * Opacity of a scene at progress `p`. Each scene fades in over SCENE_FADE
  44:  * centered on its start and fades out centered on its end, so neighbors overlap.
  45:  */
  46: export function sceneOpacity(sceneId: MuseumSceneId, p: number): number {
  47:   const scene = MUSEUM_SCENES.find((s) => s.id === sceneId);
  48:   if (!scene) return 0;
  49:   const fadeIn = within(p, scene.start - SCENE_FADE, scene.start + SCENE_FADE);
  50:   // The last scene holds to the end of the track; it never fades out.
  51:   const fadeOut = scene.end >= 1 ? 1 : 1 - within(p, scene.end - SCENE_FADE, scene.end + SCENE_FADE);
  52:   return Math.min(fadeIn, fadeOut);
  53: }
  54: 
  55: /**
  56:  * Reduced-motion variant: a scene is either fully shown or hidden, no overlap.
  57:  * The last scene includes its end point, so the final frame (progress 1) still shows it.
  58:  */
  59: export function sceneActive(sceneId: MuseumSceneId, p: number): number {
  60:   const scene = MUSEUM_SCENES.find((s) => s.id === sceneId);
  61:   if (!scene) return 0;
  62:   const inside = p >= scene.start && (scene.end >= 1 ? p <= 1 : p < scene.end);
  63:   return inside ? 1 : 0;
  64: }
  65: 
  66: /**
  67:  * True when a scene is current or adjacent, so its assets may be mounted.
  68:  * Keeps the first paint light and loads photographs only as the visitor approaches them.
  69:  */
  70: export function sceneNear(sceneId: MuseumSceneId, p: number, margin = 0.12): boolean {
  71:   const scene = MUSEUM_SCENES.find((s) => s.id === sceneId);
  72:   if (!scene) return false;
  73:   return p >= scene.start - margin && p <= scene.end + margin;
  74: }
