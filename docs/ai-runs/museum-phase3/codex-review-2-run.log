 109:       created_at TEXT NOT NULL,
 110:       FOREIGN KEY (submission_id) REFERENCES submissions(id) ON DELETE CASCADE
 111:     );
 112:   `);
 113: 
 114:   // Ensure media columns exist (additive, safe to run multiple times)
 115:   try {
 116:     db.exec("ALTER TABLE submissions ADD COLUMN media_link TEXT");
