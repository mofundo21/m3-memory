 317: export async function listSubmissions(adminToken?: string | null) {
 318:   if (getPersistenceMode() === "supabase") {
 319:     const rows = await listSupabaseSubmissions(requireSupabaseAdminToken(adminToken));
 320:     return rows.map(mapSupabaseListItem);
 321:   }
 322: 
 323:   const db = getDb();
 324:   return db.prepare(`
 325:     SELECT
 326:       submissions.id,
 327:       submissions.status,
 328:       submissions.memory_preview AS memoryPreview,
 329:       submissions.encounter_date AS encounterDate,
 330:       submissions.location_name AS locationName,
 331:       submissions.city,
 332:       submissions.region,
 333:       submissions.country,
 334:       submissions.event_name AS eventName,
 335:       submissions.created_at AS createdAt,
 336:       persons.display_name AS submitterName
 337:     FROM submissions
 338:     LEFT JOIN persons ON persons.id = submissions.submitter_person_id
 339:     ORDER BY submissions.created_at DESC
 340:   `).all();
 341: }
