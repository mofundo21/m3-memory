   5: 
   6: // Browser checks for the /museum prototype: gesture-gated audio, focus and inert controls,
   7: // reduced-motion beats, text mode, hand-off routing, and mobile overflow.
   8: const port = Number(process.env.MUSEUM_TEST_PORT || 3198);
   9: const base = `http://127.0.0.1:${port}`;
  10: 
  11: const child = spawn(
  12:   process.platform === "win32" ? "cmd.exe" : "npm",
  13:   process.platform === "win32" ? ["/d", "/s", "/c", `npm run start -- -p ${port}`] : ["run", "start", "--", "-p", String(port)],
  14:   {
  15:     env: { ...process.env, M3_PERSISTENCE: "sqlite", M3_ADMIN_AUTH: "local", DATABASE_PATH: `.m3-memory/museum-smoke-${port}.sqlite`, ADMIN_PASSWORD: "fictional-museum-password", SESSION_SECRET: "fictional-museum-session-secret-length" },
  16:     stdio: "ignore",
  17:     windowsHide: true,
  18:   }
  19: );
  20: 
  21: async function waitForServer() {
  22:   for (let i = 0; i < 60; i++) {
  23:     try {
  24:       if ((await fetch(`${base}/api/health`)).ok) return;
  25:     } catch {}
  26:     await delay(500);
  27:   }
  28:   throw new Error("museum test server did not start");
  29: }
  30: 
  31: /** Scroll so the sequence sits at normalized progress p (0..1). */
  32: async function scrollToProgress(page, p) {
  33:   await page.evaluate((target) => {
  34:     const track = document.querySelector(".museum-track");
  35:     const top = track.getBoundingClientRect().top + window.scrollY;
  36:     const scrollable = track.offsetHeight - window.innerHeight;
  37:     window.scrollTo({ top: top + target * scrollable, behavior: "instant" });
  38:   }, p);
  39:   await delay(250);
  40: }
  41: 
  42: const opacityOf = (page, selector) => page.$eval(selector, (el) => Number(getComputedStyle(el).opacity));
  43: 
  44: try {
  45:   await waitForServer();
  46:   const browser = await puppeteer.launch({ headless: true });
  47:   try {
  48:     // ---- Desktop: gesture-gated audio, ENTER, inert CTA, skip link focus ----
  49:     const page = await browser.newPage();
  50:     await page.setViewport({ width: 1440, height: 900 });
  51:     const audioRequests = [];
  52:     page.on("request", (r) => { if (r.url().includes("museum-ambient")) audioRequests.push(r.url()); });
  53:     await page.goto(`${base}/museum`, { waitUntil: "networkidle0" });
  54: 
  55:     assert.equal(await page.$eval(".museum-cta-slot", (el) => el.inert), true, "CTA is inert before its beat");
  56:     assert.equal(await page.$eval(".museum-enter", (el) => el.inert), false, "ENTER is active at the start");
  57:     assert.equal(audioRequests.length, 0, "no audio request before any visitor gesture");
  58: 
  59:     await page.click(".museum-enter-button");
  60:     await delay(600);
  61:     assert.ok((await page.evaluate(() => window.scrollY)) > 0, "ENTER moves the sequence forward");
  62:     assert.equal(await page.$eval(".museum-enter", (el) => el.inert), true, "ENTER is inert once the sequence starts");
  63: 
  64:     // Sound: the first audio request happens only after the toggle, and a missing file goes silent.
  65:     assert.equal(audioRequests.length, 0, "ENTER alone does not request audio");
  66:     await page.click(".museum-sound");
  67:     await delay(1500);
  68:     assert.equal(await page.$eval(".museum-sound", (b) => b.textContent.trim()), "No track yet", "a missing audio file is reported quietly");
  69:     assert.equal(await page.$eval(".museum-sound", (b) => b.disabled), true);
  70:     assert.equal(audioRequests.length, 1, "audio is requested only after the visitor turns sound on");
  71: 
  72:     // Join beat: CTA becomes active; skip link moves focus to it.
  73:     await page.evaluate(() => document.querySelector(".museum-skip").click());
  74:     await delay(1800);
  75:     assert.equal(await page.$eval(".museum-cta-slot", (el) => el.inert), false, "CTA is active at the end");
  76:     assert.equal(
  77:       await page.evaluate(() => document.activeElement && document.activeElement.classList.contains("museum-cta")),
  78:       true,
  79:       "skip link moves focus to the CTA"
  80:     );
  81: 
  82:     // Hand-off: CTA routes to the interview, and Back returns to the museum.
  83:     await page.click(".museum-cta-slot .museum-cta");
  84:     await page.waitForFunction(() => window.location.pathname === "/remember/write", { timeout: 15000 });
  85:     await page.goBack();
  86:     await page.waitForFunction(() => window.location.pathname === "/museum", { timeout: 15000 });
  87:     assert.equal(await page.evaluate(() => window.location.pathname), "/museum", "Back returns to the museum");
  88:     await page.close();
  89: 
  90:     // ---- Desktop scene beats: counters hold long enough to read ----
  91:     const beats = await browser.newPage();
  92:     await beats.setViewport({ width: 1440, height: 900 });
  93:     await beats.goto(`${base}/museum`, { waitUntil: "networkidle0" });
  94:     await scrollToProgress(beats, 0.8);
  95:     assert.equal(await opacityOf(beats, ".museum-counters"), 1, "counters are fully visible mid-hold (0.8)");
  96:     await scrollToProgress(beats, 0.6);
  97:     assert.equal(await opacityOf(beats, ".museum-counters"), 0, "counters are absent before their beat (0.6)");
  98:     await beats.close();
  99: 
 100:     // ---- Reduced motion: discrete beats, no overlap, CTA reachable at the end ----
 101:     const rm = await browser.newPage();
