   1: 'use client';
   2: 
   3: import { useCallback, useEffect, useRef, useState } from 'react';
   4: import { MUSEUM_AMBIENT_TRACK, MUSEUM_AUDIO_DEFAULT_ENABLED } from '@/lib/museumAudioConfig';
   5: 
   6: const STORAGE_KEY = 'm3-museum-sound';
   7: const FADE_STEPS = 24;
   8: 
   9: export type MuseumAudioStatus = 'off' | 'on' | 'missing';
  10: 
  11: export interface MuseumAudioState {
  12:   status: MuseumAudioStatus;
  13:   /** Toggle from a user gesture only. Never called automatically. */
  14:   toggle: () => void;
  15:   /** Called from the ENTER gesture. Starts playback only if the visitor chose sound on before. */
  16:   resumeIfChosen: () => void;
  17:   /** Fades to silence and resolves when done. Used at the hand-off to the interview. */
  18:   fadeOut: () => Promise<void>;
  19: }
  20: 
  21: /**
  22:  * Background music for the museum.
  23:  *
  24:  * Rules (docs/MOFUNDO_MUSEUM_DESIGN_BIBLE.md Â§9, src/lib/museumAudioConfig.ts):
  25:  * - Off by default. Never autoplays. The file is not requested until the visitor turns sound on.
  26:  * - Fades in and out over the configured duration.
  27:  * - A missing or undecodable file sets status to 'missing' and stays silent. No error UI.
  28:  * - The on/off choice is stored in localStorage only.
  29:  */
  30: export function useMuseumAudio(): MuseumAudioState {
  31:   const [status, setStatus] = useState<MuseumAudioStatus>('off');
  32:   const audioRef = useRef<HTMLAudioElement | null>(null);
  33:   const rampRef = useRef<ReturnType<typeof setInterval> | null>(null);
  34:   const rampSettleRef = useRef<(() => void) | null>(null);
  35:   const chosenRef = useRef<boolean>(MUSEUM_AUDIO_DEFAULT_ENABLED);
  36: 
  37:   /**
  38:    * Stops the current ramp. A cancelled ramp still settles its promise, so a caller
  39:    * awaiting a fade (for example the hand-off to the interview) is never left hanging.
  40:    */
  41:   const stopRamp = () => {
  42:     if (rampRef.current) {
  43:       clearInterval(rampRef.current);
  44:       rampRef.current = null;
  45:     }
  46:     const settle = rampSettleRef.current;
  47:     rampSettleRef.current = null;
  48:     settle?.();
  49:   };
  50: 
  51:   const ramp = useCallback((from: number, to: number, ms: number) => {
  52:     stopRamp();
  53:     return new Promise<void>((resolve) => {
  54:       const audio = audioRef.current;
  55:       if (!audio) return resolve();
  56:       const stepMs = ms / FADE_STEPS;
  57:       let step = 0;
  58:       audio.volume = from;
  59:       rampSettleRef.current = resolve;
  60:       rampRef.current = setInterval(() => {
  61:         step += 1;
  62:         const t = Math.min(1, step / FADE_STEPS);
  63:         if (audioRef.current) audioRef.current.volume = from + (to - from) * t;
  64:         if (t >= 1) stopRamp();
  65:       }, stepMs);
  66:     });
  67:   }, []);
  68: 
  69:   const ensureAudio = useCallback(() => {
  70:     if (audioRef.current) return audioRef.current;
  71:     const audio = new Audio(MUSEUM_AMBIENT_TRACK.src);
  72:     audio.loop = MUSEUM_AMBIENT_TRACK.loop;
  73:     audio.preload = 'none';
  74:     audio.addEventListener('error', () => {
  75:       stopRamp();
  76:       setStatus('missing');
  77:     });
  78:     audioRef.current = audio;
  79:     return audio;
  80:   }, []);
  81: 
  82:   const play = useCallback(async () => {
  83:     const audio = ensureAudio();
  84:     try {
  85:       audio.volume = 0;
  86:       await audio.play();
  87:       setStatus('on');
  88:       await ramp(0, MUSEUM_AMBIENT_TRACK.volume, MUSEUM_AMBIENT_TRACK.fadeMs);
  89:     } catch {
  90:       // Missing file, decode error, or playback refused: stay silent.
  91:       setStatus('missing');
  92:     }
  93:   }, [ensureAudio, ramp]);
  94: 
  95:   const fadeOut = useCallback(async () => {
  96:     const audio = audioRef.current;
  97:     if (!audio || audio.paused) return;
  98:     await ramp(audio.volume, 0, MUSEUM_AMBIENT_TRACK.fadeMs);
  99:     audio.pause();
 100:     setStatus('off');
 101:   }, [ramp]);
 102: 
 103:   const toggle = useCallback(() => {
 104:     if (status === 'on') {
 105:       chosenRef.current = false;
 106:       localStorage.setItem(STORAGE_KEY, 'off');
 107:       void fadeOut();
 108:       return;
 109:     }
 110:     chosenRef.current = true;
 111:     localStorage.setItem(STORAGE_KEY, 'on');
 112:     void play();
 113:   }, [status, fadeOut, play]);
 114: 
 115:   const resumeIfChosen = useCallback(() => {
 116:     if (chosenRef.current && status === 'off') void play();
 117:   }, [status, play]);
 118: 
 119:   // Read the stored choice once. Playback still waits for a gesture (resumeIfChosen).
 120:   useEffect(() => {
 121:     chosenRef.current = localStorage.getItem(STORAGE_KEY) === 'on';
 122:     return () => {
 123:       stopRamp();
 124:       const audio = audioRef.current;
 125:       if (audio) {
 126:         audio.pause();
 127:         audio.removeAttribute('src');
 128:         audio.load();
 129:       }
 130:       audioRef.current = null;
 131:     };
 132:   }, []);
 133: 
 134:   return { status, toggle, resumeIfChosen, fadeOut };
 135: }
### src/hooks/useMuseumScroll.ts
   1: 'use client';
   2: 
   3: import { useCallback, useEffect, useRef, useState } from 'react';
   4: import { TRACK_VH_DESKTOP, TRACK_VH_MOBILE } from '@/lib/museumConfig';
   5: 
   6: const MOBILE_QUERY = '(max-width: 600px)';
   7: const REDUCED_QUERY = '(prefers-reduced-motion: reduce)';
   8: 
   9: export interface MuseumScrollState {
  10:   trackRef: React.RefObject<HTMLDivElement | null>;
  11:   /** Normalized progress across the whole track, 0..1. */
  12:   progress: number;
  13:   reducedMotion: boolean;
  14:   trackVh: number;
  15:   scrollToProgress: (target: number) => void;
  16: }
  17: 
  18: /**
  19:  * Maps the page's scroll position inside one tall track to a 0..1 progress value.
  20:  * The track is a tall empty element; the stage inside it is sticky.
  21:  * Progress updates are coalesced to one per animation frame.
  22:  */
  23: export function useMuseumScroll(): MuseumScrollState {
  24:   const trackRef = useRef<HTMLDivElement>(null);
  25:   const [progress, setProgress] = useState(0);
  26:   const [reducedMotion, setReducedMotion] = useState(false);
  27:   const [trackVh, setTrackVh] = useState(TRACK_VH_DESKTOP);
  28: 
  29:   // Device and preference detection, once and on change.
  30:   useEffect(() => {
  31:     const mobile = window.matchMedia(MOBILE_QUERY);
  32:     const reduced = window.matchMedia(REDUCED_QUERY);
  33:     const sync = () => {
  34:       setTrackVh(mobile.matches ? TRACK_VH_MOBILE : TRACK_VH_DESKTOP);
  35:       setReducedMotion(reduced.matches);
  36:     };
  37:     sync();
  38:     mobile.addEventListener('change', sync);
  39:     reduced.addEventListener('change', sync);
  40:     return () => {
  41:       mobile.removeEventListener('change', sync);
  42:       reduced.removeEventListener('change', sync);
  43:     };
  44:   }, []);
  45: 
  46:   // Scroll â†’ progress, one update per frame.
  47:   useEffect(() => {
  48:     let frame = 0;
  49:     const read = () => {
  50:       frame = 0;
  51:       const track = trackRef.current;
  52:       if (!track) return;
  53:       const top = track.getBoundingClientRect().top + window.scrollY;
  54:       const scrollable = track.offsetHeight - window.innerHeight;
  55:       if (scrollable <= 0) return;
  56:       const raw = (window.scrollY - top) / scrollable;
  57:       setProgress(Math.max(0, Math.min(1, raw)));
  58:     };
  59:     const onScroll = () => {
  60:       if (!frame) frame = requestAnimationFrame(read);
  61:     };
  62:     read();
  63:     window.addEventListener('scroll', onScroll, { passive: true });
  64:     window.addEventListener('resize', onScroll);
  65:     return () => {
  66:       window.removeEventListener('scroll', onScroll);
  67:       window.removeEventListener('resize', onScroll);
  68:       if (frame) cancelAnimationFrame(frame);
  69:     };
  70:   }, [trackVh]);
  71: 
  72:   const scrollToProgress = useCallback((target: number) => {
  73:     const track = trackRef.current;
  74:     if (!track) return;
  75:     const top = track.getBoundingClientRect().top + window.scrollY;
  76:     const scrollable = track.offsetHeight - window.innerHeight;
  77:     const y = top + Math.max(0, Math.min(1, target)) * scrollable;
  78:     const reduced = window.matchMedia(REDUCED_QUERY).matches;
  79:     window.scrollTo({ top: y, behavior: reduced ? 'auto' : 'smooth' });
  80:   }, []);
  81: 
  82:   return { trackRef, progress, reducedMotion, trackVh, scrollToProgress };
  83: }
