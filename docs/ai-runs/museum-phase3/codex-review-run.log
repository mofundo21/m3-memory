  34:   const chosenRef = useRef<boolean>(MUSEUM_AUDIO_DEFAULT_ENABLED);
  35: 
  36:   const stopRamp = () => {
  37:     if (rampRef.current) {
  38:       clearInterval(rampRef.current);
  39:       rampRef.current = null;
  40:     }
  41:   };
  42: 
  43:   const ramp = useCallback((from: number, to: number, ms: number) => {
  44:     stopRamp();
  45:     return new Promise<void>((resolve) => {
  46:       const audio = audioRef.current;
  47:       if (!audio) return resolve();
  48:       const stepMs = ms / FADE_STEPS;
  49:       let step = 0;
  50:       audio.volume = from;
  51:       rampRef.current = setInterval(() => {
  52:         step += 1;
  53:         const t = Math.min(1, step / FADE_STEPS);
  54:         if (audioRef.current) audioRef.current.volume = from + (to - from) * t;
  55:         if (t >= 1) {
  56:           stopRamp();
  57:           resolve();
  58:         }
  59:       }, stepMs);
  60:     });
  61:   }, []);
  62: 
  63:   const ensureAudio = useCallback(() => {
  64:     if (audioRef.current) return audioRef.current;
  65:     const audio = new Audio(MUSEUM_AMBIENT_TRACK.src);
  66:     audio.loop = MUSEUM_AMBIENT_TRACK.loop;
  67:     audio.preload = 'none';
  68:     audio.addEventListener('error', () => {
  69:       stopRamp();
  70:       setStatus('missing');
  71:     });
  72:     audioRef.current = audio;
  73:     return audio;
  74:   }, []);
  75: 
  76:   const play = useCallback(async () => {
  77:     const audio = ensureAudio();
  78:     try {
  79:       audio.volume = 0;
  80:       await audio.play();
  81:       setStatus('on');
  82:       await ramp(0, MUSEUM_AMBIENT_TRACK.volume, MUSEUM_AMBIENT_TRACK.fadeMs);
  83:     } catch {
  84:       // Missing file, decode error, or playback refused: stay silent.
  85:       setStatus('missing');
  86:     }
  87:   }, [ensureAudio, ramp]);
  88: 
  89:   const fadeOut = useCallback(async () => {
  90:     const audio = audioRef.current;
  91:     if (!audio || audio.paused) return;
  92:     await ramp(audio.volume, 0, MUSEUM_AMBIENT_TRACK.fadeMs);
  93:     audio.pause();
  94:     setStatus('off');
  95:   }, [ramp]);
  96: 
  97:   const toggle = useCallback(() => {
  98:     if (status === 'on') {
  99:       chosenRef.current = false;
 100:       localStorage.setItem(STORAGE_KEY, 'off');
 101:       void fadeOut();
 102:       return;
 103:     }
 104:     chosenRef.current = true;
 105:     localStorage.setItem(STORAGE_KEY, 'on');
 106:     void play();
 107:   }, [status, fadeOut, play]);
 108: 
 109:   const resumeIfChosen = useCallback(() => {
 110:     if (chosenRef.current && status === 'off') void play();
 111:   }, [status, play]);
 112: 
 113:   // Read the stored choice once. Playback still waits for a gesture (resumeIfChosen).
 114:   useEffect(() => {
 115:     chosenRef.current = localStorage.getItem(STORAGE_KEY) === 'on';
 116:     return () => {
 117:       stopRamp();
 118:       const audio = audioRef.current;
 119:       if (audio) {
 120:         audio.pause();
 121:         audio.removeAttribute('src');
 122:         audio.load();
 123:       }
 124:       audioRef.current = null;
 125:     };
 126:   }, []);
 127: 
 128:   return { status, toggle, resumeIfChosen, fadeOut };
 129: }

